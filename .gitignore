# Secrets / local env — never commit these. NOT `*.env`: scripts/hosts.env is
# generated but committed.
.env
.env.*
.tmp/

# CI scratch — the render-validate job installs kustomize/kubeconform here.
.bin/

# Rendered template instances (the render-smoke gate and local `copier copy`
# runs). Anchored so nothing under template/ can match by accident.
/.render/
/render/
# render_cluster.py's scratch copy of the template source.
/template-src/
# The version checker's upstream-response cache, written inside a render.
.version-cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# coverage.py: local `coverage run` / pytest --cov output.
.coverage
.coverage.*
coverage.xml
htmlcov/
/build/
/dist/

# Terraform — init/state artifacts from rendering and validating an instance
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ansible caches from linting a rendered instance
.ansible/
.ansible-home/
