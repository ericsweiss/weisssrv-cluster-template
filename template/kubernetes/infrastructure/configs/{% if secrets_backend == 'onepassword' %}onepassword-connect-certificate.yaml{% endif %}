---
# Per-namespace copy of the internal wildcard for the Connect IngressRoute —
# Traefik reads TLS Secrets only from the route's own namespace. Staggered
# renewBefore; the anchor and the reason are in wildcard-certificates.yaml.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: internal-wildcard
  namespace: external-secrets
spec:
  secretName: internal-wildcard-tls
  issuerRef:
    name: ${cluster_issuer}
    kind: ClusterIssuer
  # `dnsNames` alone: Let's Encrypt issues no Common Name, and a CN built from a
  # long domain would breach the 64-byte X.509 limit.
  dnsNames:
    - "*.${cluster_internal_domain}"
    - ${cluster_internal_domain}
  renewBefore: 600h
