---
# Platform middlewares for IngressRoutes in several stages. They live in configs
# so they exist before the routes that use them. A missing middleware fails
# CLOSED — Traefik disables the router and 404s until it reconciles.

# Internal-only allowlist: LAN, in-cluster pods, and the tailnet when Tailscale
# is enabled. The pod CIDR is in because traefik-internal runs
# externalTrafficPolicy: Local, so in-cluster callers arrive with their pod IP.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: lan-tailscale-only
  namespace: traefik
spec:
  ipAllowList:
    sourceRange:
      - ${cluster_lan_cidr}
{%- if vpn_tailscale %}
      - ${cluster_tailnet_cidr}
{%- endif %}
      - ${cluster_pod_cidr}

---
# Same, minus the pod CIDR, for front doors no in-cluster workload should reach.
{%- if vpn_tailscale %}
# Over the tailnet MESH path a request arrives with a pod IP, so a route chained
# here needs its name in the tailnet-dns override zone to be reachable at all.
{%- endif %}
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: lan-tailscale-strict
  namespace: traefik
spec:
  ipAllowList:
    sourceRange:
      - ${cluster_lan_cidr}
{%- if vpn_tailscale %}
      - ${cluster_tailnet_cidr}
{%- endif %}

---
# HSTS for public services. Chain security-headers alongside it on WAN routes.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: hsts-header
  namespace: traefik
spec:
  headers:
    stsSeconds: 31536000
    stsIncludeSubdomains: true

---
# Baseline response headers for WAN-facing routes, chained after hsts-header.
# Separate so a route that must be framed can still take HSTS. An app that embeds
# itself needs its own middleware with customFrameOptionsValue: SAMEORIGIN.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: security-headers
  namespace: traefik
spec:
  headers:
    contentTypeNosniff: true
    frameDeny: true
    referrerPolicy: strict-origin-when-cross-origin
