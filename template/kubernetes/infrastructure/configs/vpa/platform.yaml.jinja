{%- if vpn_tailscale %}
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: tailscale-operator
  namespace: tailscale
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: operator
  # Single replica serving an admission webhook — never evict to resize.
  updatePolicy:
    updateMode: Initial
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 200m, memory: 256Mi}
        controlledResources: [cpu, memory]
{%- endif %}
{%- if gpu == 'nvidia' %}
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: nvidia-device-plugin
  namespace: nvidia-device-plugin
spec:
  targetRef:
    apiVersion: apps/v1
    kind: DaemonSet
    name: nvidia-device-plugin
  # Off: an eviction briefly withdraws nvidia.com/gpu from the node. It exists so
  # the workload carries a right-sizing signal rather than none.
  updatePolicy:
    updateMode: "Off"
  resourcePolicy:
    containerPolicies:
      # Cap == the config-manager sidecar's own 32Mi limit (release.yaml).
      - containerName: nvidia-device-plugin-sidecar
        minAllowed: {cpu: 10m, memory: 16Mi}
        maxAllowed: {cpu: 50m, memory: 32Mi}
        controlledResources: [cpu, memory]
      # nvidia-device-plugin-ctr, cap == its 64Mi limit.
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 200m, memory: 64Mi}
        controlledResources: [cpu, memory]
{%- endif %}
---
# k3s AddOns below: recommend-only. The updater must never evict cluster DNS,
# the PVC-bind path, or the metrics source every other autoscaler reads from.
# Inspect with `kubectl describe vpa <name> -n kube-system`.
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: coredns
  namespace: kube-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: coredns
  updatePolicy:
    updateMode: "Off"
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 25m, memory: 32Mi}
        maxAllowed: {cpu: 500m, memory: 256Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: kured
  namespace: kube-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: DaemonSet
    name: kured
  # Off: recommend-only. kured's requests are hand-set and it holds the
  # cluster-wide reboot lock, so nothing here resizes it automatically.
  updatePolicy:
    updateMode: "Off"
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 16Mi}
        maxAllowed: {cpu: 100m, memory: 96Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: metrics-server
  namespace: kube-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: metrics-server
  updatePolicy:
    updateMode: "Off"
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 25m, memory: 32Mi}
        maxAllowed: {cpu: 500m, memory: 256Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: DaemonSet
    name: kube-vip
  # Off: the Ansible k3s layer renders this DaemonSet, not Flux, and it owns the
  # API VIP, so an eviction moves the control-plane endpoint.
  updatePolicy:
    updateMode: "Off"
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 200m, memory: 192Mi}
        controlledResources: [cpu, memory]
