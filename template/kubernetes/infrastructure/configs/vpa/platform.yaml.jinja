---
# Right-sizing policies for the platform controllers, updateMode by restart cost.
# The HPA/VPA split and the per-controller reasons are kubernetes/README.md
# § Scheduling priority; every maxAllowed.memory tracks the container's limit.
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: metallb-controller
  namespace: metallb-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: metallb-controller
  updatePolicy:
    updateMode: Auto
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 200m, memory: 256Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: metallb-speaker
  namespace: metallb-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: DaemonSet
    name: metallb-speaker
  # Initial: evicting the pod announcing a VIP forces a stale-ARP failover.
  updatePolicy:
    updateMode: Initial
  resourcePolicy:
    containerPolicies:
      # The reloader and frr-metrics sidecars are bounded by the release's
      # postRenderer; cap == each one's limit under RequestsOnly, so the "*"
      # entry below never raises them past that bound.
      - containerName: reloader
        minAllowed: {cpu: 10m, memory: 16Mi}
        maxAllowed: {cpu: 100m, memory: 64Mi}
        controlledResources: [cpu, memory]
        controlledValues: RequestsOnly
      - containerName: frr-metrics
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 100m, memory: 128Mi}
        controlledResources: [cpu, memory]
        controlledValues: RequestsOnly
      # speaker and frr, each under a 256Mi limit.
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 300m, memory: 204Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: traefik
  namespace: traefik
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: traefik
  updatePolicy:
    updateMode: Initial
  # Memory only: the chart-native HPA owns CPU.
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {memory: 64Mi}
        maxAllowed: {memory: 512Mi}
        controlledResources: [memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: cert-manager
  namespace: cert-manager
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: cert-manager
  updatePolicy:
    updateMode: Auto
  resourcePolicy:
    containerPolicies:
      # RequestsOnly; cap == the 128Mi limit in controllers/cert-manager/
      # release.yaml. Re-measure and move both together.
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 200m, memory: 128Mi}
        controlledResources: [cpu, memory]
        controlledValues: RequestsOnly
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: cert-manager-cainjector
  namespace: cert-manager
spec:
