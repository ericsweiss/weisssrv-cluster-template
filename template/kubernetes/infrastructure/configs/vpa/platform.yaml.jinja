---
# Right-sizing policies for the platform controllers.
#
# updateMode Auto where a restart is cheap. Initial (apply on the next natural
# restart, never by eviction) for anything on a synchronous request or admission
# path: the ingress, single-replica webhooks, and the MetalLB speaker (evicting
# the pod announcing a VIP forces a stale-ARP failover). Off = recommend-only,
# used where an HPA already owns the workload or where eviction is unacceptable.
#
# An HPA and a VPA must never control the same resource — where a chart-native
# HPA scales on CPU, the VPA here is memory-only.
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: metallb-controller
  namespace: metallb-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: metallb-controller
  updatePolicy:
    updateMode: Auto
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 200m, memory: 256Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: metallb-speaker
  namespace: metallb-system
spec:
  targetRef:
    apiVersion: apps/v1
    kind: DaemonSet
    name: metallb-speaker
  updatePolicy:
    updateMode: Initial
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {cpu: 10m, memory: 32Mi}
        maxAllowed: {cpu: 300m, memory: 256Mi}
        controlledResources: [cpu, memory]
---
apiVersion: autoscaling.k8s.io/v1
kind: VerticalPodAutoscaler
metadata:
  name: traefik
  namespace: traefik
spec:
  targetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: traefik
  updatePolicy:
    updateMode: Initial
  # Memory only: the chart-native HPA owns CPU.
  resourcePolicy:
    containerPolicies:
      - containerName: "*"
        minAllowed: {memory: 64Mi}
        maxAllowed: {memory: 512Mi}
        controlledResources: [memory]
