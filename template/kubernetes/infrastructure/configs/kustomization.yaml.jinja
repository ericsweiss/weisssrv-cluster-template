---
# Reconciles AFTER controllers/: every resource here is a CR whose CRD (and,
# for cert-manager, whose webhook) the controllers stage installs.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - default-namespace.yaml
  - cluster-issuer.yaml
  - metallb-ip-pools.yaml
  - traefik-tls-options.yaml
  - traefik-middlewares.yaml
  - wildcard-certificates.yaml
  - coredns
  - vpa
{%- if secrets_backend == 'onepassword' %}
  - cluster-secret-store.yaml
  - onepassword-connect-certificate.yaml
  - onepassword-connect-ingress.yaml
{%- endif %}
{%- if dns_backend == 'cloudflare' %}
  - shared-dns-secrets
  - cloudflare-ddns
{%- endif %}
