---
# Reconciles AFTER controllers/: the CRs here need the CRDs and webhooks that
# stage installs. The built-in kinds (NetworkPolicies, admission policies) sit
# here because they fence objects the earlier stages create.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - default-namespace.yaml
  - builtin-namespace-policies.yaml
  - kube-system-policies
  - cluster-issuer.yaml
  - metallb-ip-pools.yaml
  - traefik-tls-options.yaml
  - traefik-middlewares.yaml
  - tenant-traefik-policy.yaml
  - tenant-flux-policy.yaml
  - wildcard-certificates.yaml
  - coredns
  - vpa
{%- if secrets_backend == 'onepassword' %}
  - cluster-secret-store.yaml
  - onepassword-connect-certificate.yaml
  - onepassword-connect-ingress.yaml
{%- endif %}
{%- if dns_backend == 'cloudflare' %}
  - shared-dns-secrets
  - cloudflare-ddns
{%- endif %}
{%- if vpn_tailscale %}
  - tailscale-operator
{%- endif %}
