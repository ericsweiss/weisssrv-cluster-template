---
# The cluster-wide secret store every ExternalSecret references. Swapping
# backends replaces this file, controllers/onepassword-connect/ and the egress
# patch in controllers/external-secrets/ (kubernetes/README.md, Backend seams).
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: ${cluster_secret_store}
spec:
  # CRITICAL: without this block ANY namespace may name this store and read the
  # whole vault. Opt-in is the ${cluster_node_label_domain}/cluster-secrets label,
  # set only by manifests here (kubernetes/README.md, Node label contract).
  conditions:
    - namespaceSelector:
        matchLabels:
          ${cluster_node_label_domain}/cluster-secrets: "true"
  provider:
    onepassword:
      connectHost: http://onepassword-connect.external-secrets.svc.cluster.local:8080
      vaults:
        # Quoted: YAML 1.1 reads a bare No/Off/Yes/True vault name as a boolean
        # key, and the store then points at a vault that does not exist.
        "${cluster_secrets_vault}": 1
      auth:
        secretRef:
          connectTokenSecretRef:
            name: onepassword-connect-token
            namespace: external-secrets
            key: token
