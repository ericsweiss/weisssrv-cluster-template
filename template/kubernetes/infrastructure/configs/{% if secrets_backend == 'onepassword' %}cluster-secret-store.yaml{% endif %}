---
# The cluster-wide secret store every ExternalSecret references.
#
# 1Password Connect variant: Connect runs in-cluster and serves reads from a
# local encrypted cache, so no workload ever calls the 1Password cloud API.
#
# Plaintext HTTP on the in-cluster ClusterIP is deliberate: the secret-fetch
# path has to work BEFORE cert-manager and Traefik are up, and pod-to-pod
# traffic is already encrypted by the CNI between nodes. Connect's own
# NetworkPolicy is what scopes who may reach this address.
#
# Swapping backends means replacing this file, controllers/onepassword-connect/,
# and the egress patch in controllers/external-secrets/ — the ExternalSecrets
# themselves only reference ${cluster_secret_store}.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: ${cluster_secret_store}
spec:
  provider:
    onepassword:
      connectHost: http://onepassword-connect.external-secrets.svc.cluster.local:8080
      vaults:
        ${cluster_secrets_vault}: 1
      auth:
        secretRef:
          connectTokenSecretRef:
            name: onepassword-connect-token
            namespace: external-secrets
            key: token
