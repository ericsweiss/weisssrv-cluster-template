---
# The cluster-wide secret store every ExternalSecret references.
#
# 1Password Connect variant: Connect runs in-cluster and serves reads from a
# local encrypted cache, so no workload ever calls the 1Password cloud API.
#
# Plaintext HTTP on the in-cluster ClusterIP is deliberate: the secret-fetch
# path has to work BEFORE cert-manager and Traefik are up, and pod-to-pod
# traffic is already encrypted by the CNI between nodes. Connect's own
# NetworkPolicy is what scopes who may reach this address.
#
# Swapping backends means replacing this file, controllers/onepassword-connect/,
# and the egress patch in controllers/external-secrets/ — the ExternalSecrets
# themselves only reference ${cluster_secret_store}.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: ${cluster_secret_store}
spec:
  # A ClusterSecretStore is cluster-scoped, so WITHOUT this block ANY namespace
  # may name it in an ExternalSecret and read EVERY item in the vault — a tenant
  # whose reconciliation ServiceAccount holds the `admin` ClusterRole can create
  # ExternalSecrets, and RBAC in that namespace cannot re-impose the boundary.
  #
  # Access is therefore opt-in per namespace, by the label
  #   ${cluster_node_label_domain}/cluster-secrets: "true"
  # on its Namespace object (kubernetes/README.md, "Node label contract").
  # Namespace labels are set by manifests in THIS repository, so a tenant cannot
  # label its way in. A new platform module adds the label to its namespace.yaml;
  # a TENANT gets its own ClusterSecretStore, Connect token and vault instead
  # (kubernetes/clusters/*/tenants/README.md).
  #
  # ESO's other form, `conditions: [{namespaces: [...]}]`, suits a settled
  # cluster; a GENERATED one uses the label form because its namespace set is
  # answer-dependent. scripts/check-secretstore-scope.py gates both.
  conditions:
    - namespaceSelector:
        matchLabels:
          ${cluster_node_label_domain}/cluster-secrets: "true"
  provider:
    onepassword:
      connectHost: http://onepassword-connect.external-secrets.svc.cluster.local:8080
      vaults:
        ${cluster_secrets_vault}: 1
      auth:
        secretRef:
          connectTokenSecretRef:
            name: onepassword-connect-token
            namespace: external-secrets
            key: token
