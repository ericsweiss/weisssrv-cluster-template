---
# Internal-only front door for the secrets backend, for host-side clients that
# cannot reach a ClusterIP. Delete this file and its certificate if no host-side
# client needs Connect.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: onepassword-connect
  namespace: external-secrets
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`connect.${cluster_internal_domain}`)
      kind: Rule
      middlewares:
        - name: lan-tailscale-strict
          namespace: traefik
        - name: hsts-header
          namespace: traefik
        - name: security-headers
          namespace: traefik
      services:
        - name: onepassword-connect
          port: 8080
  tls:
    secretName: internal-wildcard-tls
