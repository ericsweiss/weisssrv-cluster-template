---
# Internal-only front door for the secrets backend, for HOST-side clients that
# cannot reach a ClusterIP — e.g. the boot-time storage-encryption unit that
# fetches a pool passphrase before the node has joined anything.
#
# lan-tailscale-strict (no pod CIDR) keeps in-cluster workloads on the
# NetworkPolicy-scoped ClusterIP path instead. Delete this file and its
# certificate if no host-side client needs Connect.
#
# It lives in configs/ so it is applied in the same batch as the middleware and
# certificate it depends on.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: onepassword-connect
  namespace: external-secrets
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`connect.${cluster_internal_domain}`)
      kind: Rule
      middlewares:
        - name: lan-tailscale-strict
          namespace: traefik
        - name: hsts-header
          namespace: traefik
      services:
        - name: onepassword-connect
          port: 8080
  tls:
    secretName: internal-wildcard-tls
