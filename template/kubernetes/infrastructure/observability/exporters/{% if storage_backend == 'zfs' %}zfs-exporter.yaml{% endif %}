---
# ZFS pool metrics — remote scrape of zfs_exporter (:9134) on the NAS, installed
# by the storage playbook. Same shape as node-exporter-host.yaml: selectorless
# headless Service plus a hand-written EndpointSlice. Scrape only — see ../README.md.
apiVersion: v1
kind: Service
metadata:
  name: zfs-exporter
  namespace: observability
  labels:
    app.kubernetes.io/name: zfs-exporter
    app.kubernetes.io/part-of: observability
spec:
  clusterIP: None
  ports:
    - name: metrics
      port: 9134
      targetPort: 9134

---
# Nothing controls this slice but this file, so conditions.ready is set
# explicitly per address.
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: zfs-exporter
  namespace: observability
  labels:
    kubernetes.io/service-name: zfs-exporter
addressType: IPv4
ports:
  - name: metrics
    port: 9134
    protocol: TCP
endpoints: ${cluster_zfs_exporter_addresses}

---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: zfs-exporter
  namespace: observability
  labels:
    app.kubernetes.io/name: zfs-exporter
spec:
  jobLabel: app.kubernetes.io/name
  selector:
    matchLabels:
      app.kubernetes.io/name: zfs-exporter
  endpoints:
    # 60s: a remote LAN scrape of metrics (pool capacity, scrub age, ARC) that
    # move on the order of minutes.
    - port: metrics
      interval: 60s
