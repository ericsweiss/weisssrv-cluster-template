---
# The blackbox prober (in-cluster HelmRelease) plus the host scrape targets:
# each a selectorless headless Service + hand-written EndpointSlice addressed
# from cluster-config. Per-app exporters ship with their app module.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - blackbox-exporter.yaml
  - node-exporter-host.yaml
  - unbound-exporter.yaml
{%- if storage_backend == 'zfs' %}
  - zfs-exporter.yaml
{%- endif %}
