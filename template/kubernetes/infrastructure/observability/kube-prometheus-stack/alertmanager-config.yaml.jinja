{% raw %}---
# Alertmanager configuration, rendered by ESO from the secrets backend: a Secret
# because it embeds credentials, and `quote` keeps a rotated password valid YAML.
# Receiver URLs are inline, never *_file: the operator's parser rejects the suffix.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: alertmanager-config
  namespace: observability
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: ${cluster_secret_store}
  target:
    name: alertmanager-config
    creationPolicy: Owner
    template:
      engineVersion: v2
      data:
        alertmanager.yaml: |
          global:
            smtp_smarthost: "${cluster_smtp_host}:587"
            smtp_from: "Alertmanager <alertmanager@${cluster_internal_domain}>"
            smtp_require_tls: true
            smtp_auth_username: {{ .smtpUsername | quote }}
            smtp_auth_password: {{ .smtpPassword | quote }}

          inhibit_rules:
            - source_matchers:
                - severity="critical"
              target_matchers:
                - severity="warning"
              equal:
                - alertname
                - namespace
            # These pairs use different alertnames, so the generic rule above
            # never matches them. Each pairs on its own identity labels; a
            # coarser key would silence a different object's warning.
            - source_matchers:
                - alertname="DiskUsageCritical"
              target_matchers:
                - alertname="DiskUsageWarning"
              equal:
                - instance
                - mountpoint
            # Above 80% the two alerts are the same condition on the same
            # filesystem; equal on mountpoint so another filling mount still pages.
            # k3s_image_gc_high_threshold must stay under 80 or this mutes it for good.
            - source_matchers:
                - alertname="DiskUsageWarning"
              target_matchers:
                - alertname="KubeletImageGCIneffective"
              equal:
                - instance
                - mountpoint
            - source_matchers:
                - alertname="InodeUsageCritical"
              target_matchers:
                - alertname="InodeUsageWarning"
              equal:
                - instance
                - mountpoint
            - source_matchers:
                - alertname="PVCUsageCritical"
              target_matchers:
                - alertname="PVCUsageWarning"
              equal:
                - namespace
                - persistentvolumeclaim
            - source_matchers:
                - alertname="CertExpiringCritical"
              target_matchers:
                - alertname="CertExpiringWarning"
              equal:
                - namespace
                - name
            # Same expr at a longer `for:`, or a tighter threshold on the same
            # textfile series, so the generic alertname-equal rule cannot pair
            # them. Each keys on instance: the metrics carry no namespace.
            - source_matchers:
                - alertname="CertExpiringSoonCritical"
              target_matchers:
                - alertname="CertExpiringSoon"
              equal:
                - instance
            - source_matchers:
                - alertname="CertRenewalFailedProlonged"
              target_matchers:
                - alertname="CertRenewalFailed"
              equal:
                - instance
            - source_matchers:
                - alertname="OffsiteBackupIncompleteProlonged"
              target_matchers:
                - alertname="OffsiteBackupIncomplete"
              equal:
                - instance
            - source_matchers:
                - alertname="ZfsEncryptedMountStuckCritical"
              target_matchers:
                - alertname="ZfsEncryptedMountStuck"
              equal:
                - instance
            # The dump series is per app on one host, so the pair keys on app too.
            - source_matchers:
                - alertname="BackupArtifactStaleCritical"
              target_matchers:
                - alertname="BackupArtifactStale"
              equal:
                - instance
                - app
            - source_matchers:
                - alertname="HostMemAvailableCritical"
              target_matchers:
                - alertname="HostMemAvailableLow"
              equal:
                - instance
            # A dark hypervisor fails its scrape too; the critical names the
            # cause, so the exporter warning for the same host stays quiet.
            - source_matchers:
                - alertname="ProxmoxHostDown"
              target_matchers:
                - alertname="HostExporterDown"
              equal:
                - instance
            # Thermal pairs. GPU and NIC alerts carry chip_name, since a host can
            # have two; CPU alerts carry none. Drives pair on chip.
            - source_matchers:
                - severity="critical"
                - component=~"cpu|gpu|network"
              target_matchers:
                - severity="warning"
                - component=~"cpu|gpu|network"
              equal:
                - instance
                - component
                - chip_name
            - source_matchers:
                - alertname="SATADriveTempCritical"
              target_matchers:
                - alertname="SATADriveTempWarning"
              equal:
                - instance
                - chip
            # The 75C step is null-routed, so this pair only tidies the UI.
            - source_matchers:
                - alertname="NVMeDriveTempCritical"
              target_matchers:
                - alertname="NVMeDriveTempHigh"
              equal:
                - instance
                - chip
{% endraw %}{% if storage_backend == 'zfs' %}{% raw %}            # Pool names repeat across hosts, so the pair keys on both.
            - source_matchers:
                - alertname="ZFSPoolSpaceCritical"
              target_matchers:
                - alertname="ZFSPoolSpaceWarning"
              equal:
                - instance
                - pool
            # One remedy, four alerts: a slab leak eats RAM and keeps swap-clean
            # from completing. HostMemAvailableCritical is never on this list.
            - source_matchers:
                - alertname="HostSlabLeakSuspected"
              target_matchers:
                - alertname=~"HostMemAvailableLow|NASSwapNotClearing|SwapCleanFailed|SwapCleanStoppedGuests"
              equal:
                - instance
{% endraw %}{% endif %}{% if tenant_storage %}{% raw %}            - source_matchers:
                - alertname="TenantVolumesNearlyFull"
              target_matchers:
                - alertname="TenantVolumesFilling"
              equal:
                - instance
{% endraw %}{% endif %}{% if postgres_operator %}{% raw %}            # One pair per CNPG instance, keyed on the scraped namespace and pod.
            - source_matchers:
                - alertname="CNPGBaseBackupStaleCritical"
              target_matchers:
                - alertname="CNPGBaseBackupStale"
              equal:
                - namespace
                - pod
{% endraw %}{% endif %}{% raw %}            # Different alertnames for the same failing integration, so the
            # generic pair cannot match them.
            - source_matchers:
                - alertname="AlertmanagerClusterFailedToSendAlerts"
              target_matchers:
                - alertname="AlertmanagerFailedToSendAlerts"
              equal:
                - namespace
                - service
                - integration
            # CRITICAL: `equal: [namespace]` is load-bearing - without it one
            # namespace's info condition suppresses every info alert in the
            # cluster. Absent counts as equal, so an info alert with no
            # namespace label needs listing below or it is never delivered.
            - source_matchers:
                - alertname="InfoInhibitor"
              target_matchers:
                - severity="info"
                - alertname!~"AlertmanagerNotificationsDropping{% endraw %}{% if storage_backend == 'zfs' %}|SwapCleanStoppedGuests{% endif %}{% raw %}"
              equal:
                - namespace
            # While a node is down, NodeOutageStormControl suppresses per-pod
            # and per-workload warnings cluster-wide; the targets carry no node
            # label. It stops firing 7d after the node was last Ready.
            - source_matchers:
                - alertname="NodeOutageStormControl"
              target_matchers:
                - alertname=~"KubePodNotReady|KubeContainerWaiting|KubeDaemonSetRolloutStuck|KubeDaemonSetMisScheduled|KubeDeploymentReplicasMismatch|KubeStatefulSetReplicasMismatch|KubeAggregatedAPIDown|NodeSystemSaturation"

          route:
            receiver: chat-default
            # instance is included so host-level (non-namespaced) alerts group
            # per-host instead of collapsing into one empty-namespace bucket.
            group_by:
              - alertname
              - namespace
              - instance
            group_wait: 30s
            group_interval: 10m
            repeat_interval: 4h
            routes:
              # Dead-man's switch: Watchdog always fires and the external
              # heartbeat alarms on silence. MUST precede the severity=none null
              # route — Watchdog and InfoInhibitor both carry severity=none.
              - receiver: watchdog-heartbeat
                matchers:
                  - alertname="Watchdog"
                group_wait: 0s
                group_interval: 1m
                repeat_interval: 1m
              - receiver: "null"
                matchers:
                  - severity="none"
              # Latches whose remedy is a scheduled window, not an action now:
              # they hold until the work happens, so they repeat every 3 days.
              - receiver: chat-default
                matchers:
                  - alertname=~"{% endraw %}{% if storage_backend == 'zfs' %}HostSlabLeakSuspected|{% endif %}{% raw %}MaintenanceRebootDeferred|KubeletImageGCIneffective"
                repeat_interval: 72h
              # Durability faults whose remedy is a resilver or a hand-run job:
              # one notice a day while they last, warning and critical alike.
              - receiver: email-and-chat
                matchers:
                  - severity="critical"
                  - alertname=~"ZFSPoolNotOnline|ZFSPoolDataErrors|CertRenewalFailedProlonged"
                repeat_interval: 24h
              - receiver: chat-default
                matchers:
                  - severity="warning"
                  - alertname=~"SMART.*|ZFSPool.*|ArchiveBackup.*|CertRenewal.*|CertDistribution.*"
                repeat_interval: 24h
              - receiver: email-and-chat
                matchers:
                  - severity="critical"
              - receiver: chat-default
                matchers:
                  - severity="warning"
                repeat_interval: 12h
              # severity=info is a notice, not a fault. Without this branch it
              # inherits the route's 4h repeat — more often than a warning.
              - receiver: chat-default
                matchers:
                  - severity="info"
                repeat_interval: 24h

          receivers:
            - name: "null"
            # Any POST counts as a ping; send_resolved false because Watchdog
            # never resolves (the switch pages on silence, not on content).
            - name: watchdog-heartbeat
              webhook_configs:
                - url: {{ .healthchecksPingUrl | quote }}
                  send_resolved: false
                  # Bounds one attempt. Unset, a stalled request consumes the
                  # whole 1m notify window and the ping is dropped, not retried.
                  timeout: 10s
            # Generic JSON webhook, for a chat bridge, ntfy, or anything that
            # accepts an Alertmanager POST. Swap in slack_configs,
            # discord_configs or msteams_configs without changing the routes.
            - name: chat-default
              webhook_configs:
                - url: {{ .alertWebhookUrl | quote }}
                  send_resolved: true
            - name: email-and-chat
              email_configs:
                - to: "${cluster_alert_email}"
                  send_resolved: true
              webhook_configs:
                - url: {{ .alertWebhookUrl | quote }}
                  send_resolved: true
  data:
    - secretKey: alertWebhookUrl
      remoteRef:
        key: Alertmanager Webhook
        property: url
    - secretKey: smtpUsername
      remoteRef:
        key: SMTP Relay Auth
        property: username
    - secretKey: smtpPassword
      remoteRef:
        key: SMTP Relay Auth
        property: password
    # Heartbeat ping URL for the Watchdog dead-man's switch. Until the item
    # exists ESO keeps serving the last rendered Secret and
    # ExternalSecretSyncFailure fires — create it before first reconcile.
    - secretKey: healthchecksPingUrl
      remoteRef:
        key: Healthchecks Watchdog
        property: ping url
{%- endraw %}
