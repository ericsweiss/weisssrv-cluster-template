{#- Interpolated: the kubelet image-gc watermark, which must equal the one
    group_vars/k3s.yml gives the kubelet, and the module gates on rule groups and
    rule text. The alert annotations are Go templates Jinja must not touch. -#}
{% raw %}---
# kube-prometheus-stack — Prometheus, Alertmanager, Grafana, node-exporter and
# kube-state-metrics. Flux substitutes the chart version and site values from
# cluster-versions and cluster-config; copier renders the rest.
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: kube-prometheus-stack
  namespace: observability
spec:
  interval: 30m
  releaseName: kube-prometheus-stack
  # CRD install and Prometheus startup can take several minutes.
  timeout: 15m
  chart:
    spec:
      chart: kube-prometheus-stack
      version: "${helm_chart_versions_kube_prometheus_stack}"
      sourceRef:
        kind: HelmRepository
        name: prometheus-community
        namespace: flux-system
      interval: 12h
  install:
    # The monitoring.coreos.com CRDs are owned by the infrastructure-crds stage.
    # crds.enabled:false stops this chart shipping copies, crds:Skip stops Helm
    # managing them.
    crds: Skip
    remediation:
      retries: 3
  upgrade:
    crds: Skip
    remediation:
      retries: 3
      remediateLastFailure: true
  values:
    crds:
      enabled: false

    prometheusOperator:
      # `platform` from sources/priorityclasses.yaml, set per component: the
      # chart has no global key. The subcharts stay unclassed, where losing a
      # pod costs a dashboard rather than the platform.
      priorityClassName: platform
      # The chart ships `resources: {}`, so without this the operator has no OOM
      # ceiling at all — its paired VPA is RequestsOnly and cannot introduce a
      # limit where the pod has none.
      resources:
        requests:
          cpu: 25m
          memory: 96Mi
        limits:
          memory: 384Mi
      # Feeds both the Prometheus and the Alertmanager config-reloader sidecars,
      # which the chart ships with no requests and no OOM ceiling.
      prometheusConfigReloader:
        resources:
          requests:
            cpu: 10m
            memory: 48Mi
          limits:
            memory: 96Mi

    # -------------------------------------------------------------------------
    # Prometheus
    # -------------------------------------------------------------------------
    prometheus:
      prometheusSpec:
        priorityClassName: platform
        # Pins the operator default so a chart bump cannot move `for:` semantics.
        evaluationInterval: 30s
        # Runs as nobody (65534); fsGroup makes the PV writable.
        securityContext:
          runAsNonRoot: true
          runAsUser: 65534
          runAsGroup: 65534
          fsGroup: 65534

        # Pinned to the storage node, where the statically-provisioned TSDB
        # volume lives (storage.yaml).
        nodeSelector:
          ${cluster_node_label_domain}/nas: "true"
        tolerations:
          - key: ${cluster_node_label_domain}/nas
            operator: Equal
            value: "true"
            effect: PreferNoSchedule

        storageSpec:
          volumeClaimTemplate:
            spec:
              storageClassName: ""
              accessModes:
                - ReadWriteOnce
              resources:
                requests:
                  storage: 150Gi
              volumeName: prometheus-data

        # retentionSize bounds persisted blocks only — the WAL, the head being
        # flushed and compaction scratch consume more on top. Hold it well under
        # the PV size so those non-block costs have room.
        retention: 365d
        retentionSize: 120GB

        # The static-target exporters ship hand-written discovery.k8s.io/v1
        # EndpointSlices, not core/v1 Endpoints. The operator's default
        # Endpoints role finds no targets for them.
        serviceDiscoveryRole: EndpointSlice

        # Discover ServiceMonitors, PodMonitors and PrometheusRules in ALL
        # namespaces, so an app module ships its own without editing this file.
        serviceMonitorSelectorNilUsesHelmValues: false
        serviceMonitorNamespaceSelector: {}
        podMonitorSelectorNilUsesHelmValues: false
        podMonitorNamespaceSelector: {}
        ruleSelectorNilUsesHelmValues: false
        ruleNamespaceSelector: {}

        # VPA is Off for Prometheus (recording-only) — these are hand-tuned.
        resources:
          requests:
            cpu: 200m
            memory: 2Gi
          limits:
            memory: 4Gi

    # -------------------------------------------------------------------------
    # Alertmanager
    # -------------------------------------------------------------------------
    alertmanager:
      # Two replicas gossip silences and the notification log over emptyDir, so
      # a restart does not re-notify every firing alert. The chart's soft
      # podAntiAffinity spreads them; the PDB stops a kured reboot evicting both.
      podDisruptionBudget:
        enabled: true
        minAvailable: 1
      alertmanagerSpec:
        replicas: 2
        priorityClassName: platform
        configSecret: alertmanager-config
        # The alertmanager VPA maxAllowed.memory in observability/vpa.yaml
        # equals this limit; move both together.
        resources:
          requests:
            cpu: 50m
            memory: 96Mi
          limits:
            memory: 192Mi

    # -------------------------------------------------------------------------
    # Grafana
    # -------------------------------------------------------------------------
    grafana:
      # Ingress is a Traefik IngressRoute (ingress/).
      ingress:
        enabled: false

      # Replaced by the configmaps-only pair in grafana-rbac.yaml. Not
      # `useExistingClusterRole`: it keeps the chart's binding and rewrites only
      # its roleRef, which the RBAC API forbids.
      rbac:
        create: false

      # Only the sidecars talk to the apiserver; they get the token back through
      # the projected volume below. extraContainerVolumes, NOT extraVolumes —
      # the latter renders a projected volume silently as an emptyDir.
      automountServiceAccountToken: false
      extraContainerVolumes:
        - name: sidecar-kube-api-access
          projected:
            defaultMode: 420
            sources:
              - serviceAccountToken:
                  path: token
                  expirationSeconds: 3607
              - configMap:
                  name: kube-root-ca.crt
                  items:
                    - key: ca.crt
                      path: ca.crt
              - downwardAPI:
                  items:
                    - path: namespace
                      fieldRef:
                        fieldPath: metadata.namespace

      # Break-glass account: it authenticates nothing while the switches below
      # are set. ONE-SHOT — the password is read only at first start against an
      # empty grafana.db, so the vault value must be final by then (../README.md).
      admin:
        existingSecret: observability-secrets
        userKey: grafana-admin-user
        passwordKey: grafana-admin-password

      grafana.ini:
        server:
          root_url: https://grafana.${cluster_internal_domain}

        # SSO-only needs BOTH: disable_login_form removes the browser form and
        # auth.basic.enabled=false closes `curl -u`. Do NOT set
        # disable_initial_admin_creation — it blocks break-glass permanently.
        auth:
          disable_login_form: true
        auth.basic:
          enabled: false

        analytics:
          check_for_updates: false
          check_for_plugin_updates: false
          reporting_enabled: false
          feedback_links_enabled: false

      # OIDC via the cluster's identity provider. grafana-users maps to Viewer
      # and grafana-admins to Admin; create both groups in the IdP. Every OIDC
      # consumer uses the same issuer host, or tokens fail cross-app.
      env:
        GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
        GF_AUTH_GENERIC_OAUTH_NAME: "SSO"
        GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP: "true"
        GF_AUTH_GENERIC_OAUTH_SCOPES: "openid profile email"
        GF_AUTH_GENERIC_OAUTH_AUTH_URL: "https://auth.${cluster_external_domain}/application/o/authorize/"
        GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "https://auth.${cluster_external_domain}/application/o/token/"
        GF_AUTH_GENERIC_OAUTH_API_URL: "https://auth.${cluster_external_domain}/application/o/userinfo/"
        GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "contains(groups, 'grafana-admins') && 'Admin' || contains(groups, 'grafana-users') && 'Viewer' || ''"
        GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT: "true"

      envValueFrom:
        GF_AUTH_GENERIC_OAUTH_CLIENT_ID:
          secretKeyRef:
            name: observability-secrets
            key: grafana-oidc-client-id
        GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
          secretKeyRef:
            name: observability-secrets
            key: grafana-oidc-client-secret

      # Dashboard and datasource sidecars over all namespaces. skipReload: the
      # provisioning-reload endpoint is closed under SSO-only auth.
      # `resource: configmap`: the SA's ClusterRole has no `secrets`.
      sidecar:
        # Covers grafana-sc-dashboard and grafana-sc-datasources; the chart
        # ships both with no requests and no OOM ceiling.
        resources:
          requests:
            cpu: 10m
            memory: 128Mi
          limits:
            memory: 256Mi
        dashboards:
          enabled: true
          label: grafana_dashboard
          labelValue: "1"
          searchNamespace: ALL
          folderAnnotation: grafana_folder
          # Without it the grafana_folder annotations are inert and every
          # dashboard lands in the root folder. Requires the chart's empty
          # `folder`, which stays at its default.
          provider:
            foldersFromFilesStructure: true
          skipReload: true
          resource: configmap
          extraMounts:
            - name: sidecar-kube-api-access
              mountPath: /var/run/secrets/kubernetes.io/serviceaccount
              readOnly: true
        datasources:
          # Fixed UID so dashboard JSON can reference "prometheus".
          uid: prometheus
          skipReload: true
          initDatasources: true
          # The init container inherits this. The chart default WATCH never
          # exits, so the pod hangs in PodInitializing and the Helm upgrade
          # times out; init mode must list once and exit.
          watchMethod: LIST
          resource: configmap
          extraMounts:
            - name: sidecar-kube-api-access
              mountPath: /var/run/secrets/kubernetes.io/serviceaccount
              readOnly: true

      additionalDataSources:
        - name: Loki
          type: loki
          uid: loki
          url: http://loki.observability.svc.cluster.local:3100
          access: proxy
          isDefault: false

      persistence:
        enabled: true
        type: pvc
        existingClaim: grafana-data

      # The NFS export squashes all operations to a fixed uid:gid and does not
      # permit chown, so the init-chown-data container can only fail.
      initChownData:
        enabled: false

      # HTTP, not exec: the chart's grafana image is distroless, so an exec
      # probe has no shell to run. A stale NFS handle or a dead DB answers
      # /api/health 503, so the restart still covers both.
      livenessProbe:
        httpGet:
          path: /api/health
          port: 3000
        initialDelaySeconds: 30
        periodSeconds: 30
        timeoutSeconds: 10
        failureThreshold: 3

      # CRITICAL: SQLite on a network filesystem cannot tolerate two writers,
      # and RollingUpdate runs old and new pods against the same DB on upgrade.
      # rollingUpdate is nulled explicitly: a live Deployment keeps those
      # defaults and the API rejects them alongside Recreate.
      deploymentStrategy:
        type: Recreate
        rollingUpdate: null

      resources:
        requests:
          cpu: 100m
          memory: 512Mi
        limits:
          memory: 1Gi

    # -------------------------------------------------------------------------
    # node-exporter
    # -------------------------------------------------------------------------
    nodeExporter:
      enabled: true

    prometheus-node-exporter:
      # Run on every node, including tainted ones.
      tolerations:
        - operator: Exists
      # processes collector is off by default; node_processes_* gives process,
      # thread and PID-limit visibility and populates the node-exporter-full
      # dashboard's System Processes panels.
      extraArgs:
        - --collector.processes
      resources:
        requests:
          cpu: 50m
          memory: 32Mi
        limits:
          # No CPU limit: node-exporter bursts during scrape collection and CFS
          # throttling here is the dominant CPUThrottlingHigh source. The memory
          # limit stays (OOM is a real failure mode) and matches the VPA ceiling.
          memory: 128Mi

    # -------------------------------------------------------------------------
    # kube-state-metrics
    # -------------------------------------------------------------------------
    kube-state-metrics:
      # Its working set scales with object count. The paired VPA is RequestsOnly,
      # so this limit is the binding OOM ceiling; move it with maxAllowed in
      # observability/vpa.yaml.
      resources:
        requests:
          cpu: 50m
          memory: 192Mi
        limits:
          memory: 384Mi
      # Per-resource Flux readiness comes from kube-state-metrics
      # customResourceState, not from the controllers themselves.
      rbac:
        extraRules:
          - apiGroups:
              - kustomize.toolkit.fluxcd.io
              - helm.toolkit.fluxcd.io
            resources:
              - kustomizations
              - helmreleases
            verbs: [list, watch]
          - apiGroups:
              - source.toolkit.fluxcd.io
            resources:
              - gitrepositories
              - helmrepositories
              - helmcharts
            verbs: [list, watch]
      customResourceState:
        enabled: true
        config:
          spec:
            resources:
              - groupVersionKind:
                  group: kustomize.toolkit.fluxcd.io
                  version: v1
                  kind: Kustomization
                metricNamePrefix: gotk
                metrics:
                  - name: resource_info
                    help: Flux Kustomization readiness
                    each:
                      type: Info
                      info:
                        labelsFromPath:
                          name: [metadata, name]
                          exported_namespace: [metadata, namespace]
                          ready: [status, conditions, "[type=Ready]", status]
                          suspended: [spec, suspend]
              - groupVersionKind:
                  group: helm.toolkit.fluxcd.io
                  version: v2
                  kind: HelmRelease
                metricNamePrefix: gotk
                metrics:
                  - name: resource_info
                    help: Flux HelmRelease readiness
                    each:
                      type: Info
                      info:
                        labelsFromPath:
                          name: [metadata, name]
                          exported_namespace: [metadata, namespace]
                          ready: [status, conditions, "[type=Ready]", status]
                          suspended: [spec, suspend]
              - groupVersionKind:
                  group: source.toolkit.fluxcd.io
                  version: v1
                  kind: GitRepository
                metricNamePrefix: gotk
                metrics:
                  - name: resource_info
                    help: Flux GitRepository readiness
                    each:
                      type: Info
                      info:
                        labelsFromPath:
                          name: [metadata, name]
                          exported_namespace: [metadata, namespace]
                          ready: [status, conditions, "[type=Ready]", status]
                          suspended: [spec, suspend]
              - groupVersionKind:
                  group: source.toolkit.fluxcd.io
                  version: v1
                  kind: HelmRepository
                metricNamePrefix: gotk
                metrics:
                  - name: resource_info
                    help: Flux HelmRepository readiness
                    each:
                      type: Info
                      info:
                        labelsFromPath:
                          name: [metadata, name]
                          exported_namespace: [metadata, namespace]
                          ready: [status, conditions, "[type=Ready]", status]
                          suspended: [spec, suspend]
              - groupVersionKind:
                  group: source.toolkit.fluxcd.io
                  version: v1
                  kind: HelmChart
                metricNamePrefix: gotk
                metrics:
                  - name: resource_info
                    help: Flux HelmChart readiness
                    each:
                      type: Info
                      info:
                        labelsFromPath:
                          name: [metadata, name]
                          exported_namespace: [metadata, namespace]
                          ready: [status, conditions, "[type=Ready]", status]
                          suspended: [spec, suspend]

    # Components k3s does not expose: it bundles kube-scheduler,
    # kube-controller-manager and kube-proxy into the server process with no
    # metrics endpoints, so enabling them yields permanent *Down criticals.
    kubeProxy:
      enabled: false
    kubeScheduler:
      enabled: false
    kubeControllerManager:
      enabled: false

    # On a k3s server, :10250/metrics serves the whole embedded registry, so
    # those series are stored twice; dropping the server copies trims the head.
    # Helm replaces this list rather than merging, so the chart default repeats.
    kubelet:
      serviceMonitor:
        metricRelabelings:
          # The chart default; keep it in step with the chart on a bump.
          - action: drop
            sourceLabels: [__name__, le]
            regex: (csi_operations|storage_operation_duration)_seconds_bucket;(0.25|2.5|15|25|120|600)(\.0)?
          # rest_client_* stays: the chart's Kubelet dashboard plots it under
          # job="kubelet". The node pattern names the k3s_servers group; the
          # cluster-invariants suite fails when a renamed server leaves it.
          - action: drop
            sourceLabels: [__name__, node]
            separator: ;
            regex: (apiserver|etcd|scheduler|workqueue|lasso)_.*;k3s-srv-.*
    # etcd is the one component whose failure loses the cluster. k3s serves its
    # metrics on :2381; enabling this component also enables the upstream etcd
    # alert rules. endpoints is a JSON flow sequence (Helm needs a real list).
    kubeEtcd:
      enabled: true
      endpoints: ${cluster_etcd_endpoints}
      service:
        enabled: true
        port: 2381
        targetPort: 2381
      serviceMonitor:
        enabled: true
        scheme: http

    defaultRules:
      disabled:
        # A 5m hold pages critical on one transient webhook timeout.
        # Replaced by the 15m copy in platform-monitoring below.
        AlertmanagerClusterFailedToSendAlerts: true
        # Replaced by the *NonCI copies in platform-resources below, which leave
        # out the gitlab-runner* namespaces a CI runner quota over-requests in.
        KubeCPUQuotaOvercommit: true
        KubeMemoryQuotaOvercommit: true
        # Both select job="node-exporter", which runs without the systemd
        # collector. Every node_systemd_* series carries job="node-exporter-host"
        # instead, which is what platform-host-exporter below selects.
        NodeSystemdServiceFailed: true
        NodeSystemdServiceCrashlooping: true

    # Platform-wide alert rules only; app-specific rules belong in a
    # PrometheusRule next to the app. Every rule carries a runbook_url, and
    # ${cluster_node_exporter_job_regex} scopes the host-metric ones.
    additionalPrometheusRulesMap:
      platform-storage:
        groups:
          - name: platform.storage
            rules:
              # efivarfs is the kernel's NVRAM-backed virtual fs and routinely
              # sits above 70%; devtmpfs/iso9660 are virtual or read-only.
              - alert: DiskUsageWarning
                expr: >-
                  (1 - node_filesystem_avail_bytes{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"}
                  / node_filesystem_size_bytes{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"})
                  * 100 > 80
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Disk usage above 80% on {{ $labels.instance }}:{{ $labels.mountpoint }}'
                  description: >-
                    Disk usage is {{ $value | printf "%.1f" }}%
                    on {{ $labels.instance }} mount {{ $labels.mountpoint }}.

              - alert: DiskUsageCritical
                expr: >-
                  (1 - node_filesystem_avail_bytes{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"}
                  / node_filesystem_size_bytes{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"})
                  * 100 > 90
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Disk usage above 90% on {{ $labels.instance }}:{{ $labels.mountpoint }}'
                  description: >-
                    Disk usage is {{ $value | printf "%.1f" }}%
                    on {{ $labels.instance }} mount {{ $labels.mountpoint }}.

              # Inode exhaustion, which the byte-usage rules above miss. The
              # chart's own rule covers only the in-cluster job; this one
              # follows the job regex.
              - alert: InodeUsageWarning
                expr: >-
                  (node_filesystem_files_free{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"}
                  / node_filesystem_files{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"})
                  * 100 < 10
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Inodes below 10% free on {{ $labels.instance }}:{{ $labels.mountpoint }}'
                  description: >-
                    Only {{ $value | printf "%.1f" }}% of inodes are free
                    on {{ $labels.instance }} mount {{ $labels.mountpoint }}.

              - alert: InodeUsageCritical
                expr: >-
                  (node_filesystem_files_free{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"}
                  / node_filesystem_files{job=~"${cluster_node_exporter_job_regex}", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"})
                  * 100 < 5
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Inodes below 5% free on {{ $labels.instance }}:{{ $labels.mountpoint }}'
                  description: >-
                    Only {{ $value | printf "%.1f" }}% of inodes are free
                    on {{ $labels.instance }} mount {{ $labels.mountpoint }}.

              # Stays under DiskUsageWarning's 80%, whose inhibit would mute it,
              # and up to 5 points above k3s_image_gc_high_threshold (capped at
              # 79) so a node where GC is doing its job does not page.
              - alert: KubeletImageGCIneffective
                expr: >-
                  100 * (1 - node_filesystem_avail_bytes{job="node-exporter", mountpoint="/"}
                  / node_filesystem_size_bytes{job="node-exporter", mountpoint="/"}) > {% endraw %}{{ [k3s_image_gc_high_threshold | int + 5, 79] | min }}{% raw %}
                for: 2h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#kubelet-image-store-on-a-node-root-filesystem'
                  summary: 'Kubelet image GC cannot reach its low watermark on {{ $labels.instance }}'
                  description: >-
                    Root filesystem has stayed {{ $value | printf "%.1f" }}% used
                    for 2 hours, at or above the kubelet image-gc-high-threshold
                    of {% endraw %}{{ k3s_image_gc_high_threshold }}{% raw %}%: image GC is running and
                    cannot reach its low watermark, so something other than the
                    image store is holding the space.

              - alert: PVCUsageWarning
                expr: (kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes) * 100 > 80
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'PVC {{ $labels.persistentvolumeclaim }} in {{ $labels.namespace }} above 80%'
                  description: 'PVC usage is {{ $value | printf "%.1f" }}%.'

              - alert: PVCUsageCritical
                expr: (kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes) * 100 > 90
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'PVC {{ $labels.persistentvolumeclaim }} in {{ $labels.namespace }} above 90%'
                  description: 'PVC usage is {{ $value | printf "%.1f" }}%.'

{% endraw %}{% if tenant_storage %}{% raw %}              # k3s local-storage is disabled and tenant claims name tenant-local,
              # so a local-path PV means k3s's default class came back and a claim
              # fell through to it, onto a node bootdisk no backup covers.
{% endraw %}{% else %}{% raw %}              # Every stateful PV here is statically provisioned and k3s
              # local-storage is off: a local-path PV means its default class came
              # back, onto an unbacked bootdisk. Delete if you adopt a provisioner.
{% endraw %}{% endif %}{% raw %}              - alert: LocalPathPVExists
                expr: kube_persistentvolume_info{storageclass="local-path"} > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'PersistentVolume {{ $labels.persistentvolume }} is on the local-path StorageClass'
                  description: >-
                    PV {{ $labels.persistentvolume }} uses the local-path
                    StorageClass, which lands on a stateless node bootdisk and is
{% endraw %}{% if tenant_storage %}{% raw %}                    excluded from backups. A platform claim: pin its
                    storageClassName to "" and rebind it to the intended static
                    PV. A tenant claim: recreate it with storageClassName:
                    tenant-local.
{% endraw %}{% else %}{% raw %}                    excluded from backups. Pin its storageClassName to "" and
                    rebind it to the intended static PV.
{% endraw %}{% endif %}{% if tenant_storage %}{% raw %}

              # tenant-local claim sizes are not enforced, so the shared zvol is
              # the only cap on what tenants write. Runbook: "Tenant volumes filling".
              - alert: TenantVolumesFilling
                expr: >-
                  node_filesystem_avail_bytes{job="node-exporter", mountpoint="/mnt/tenant-volumes"}
                  / node_filesystem_size_bytes{job="node-exporter", mountpoint="/mnt/tenant-volumes"}
                  < 0.20
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#tenant-volumes-filling'
                  summary: 'The tenant-volumes filesystem on {{ $labels.instance }} is under 20% free'
                  description: >-
                    {{ $value | humanizePercentage }} of /mnt/tenant-volumes is
                    free. Every tenant-local claim shares it, and a claim can
                    write past its declared size.

              - alert: TenantVolumesNearlyFull
                expr: >-
                  node_filesystem_avail_bytes{job="node-exporter", mountpoint="/mnt/tenant-volumes"}
                  / node_filesystem_size_bytes{job="node-exporter", mountpoint="/mnt/tenant-volumes"}
                  < 0.10
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#tenant-volumes-filling'
                  summary: 'The tenant-volumes filesystem on {{ $labels.instance }} is under 10% free'
                  description: >-
                    {{ $value | humanizePercentage }} of /mnt/tenant-volumes is
                    free. When it fills, every tenant volume on it, database
                    instances included, stops accepting writes.

              # The two alerts above go silent when the mount is gone, the state
              # in which the provisioner refuses every tenant claim.
              - alert: TenantVolumesMountMissing
                expr: >-
                  absent(node_filesystem_size_bytes{job="node-exporter", mountpoint="/mnt/tenant-volumes"})
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#tenant-claim-refused-not-the-mounted-tenant-volumes-zvol'
                  summary: 'No node-exporter reports a /mnt/tenant-volumes filesystem'
                  description: >-
                    The tenant-volumes zvol is not mounted on the NAS agent, or
                    its node-exporter is down. New tenant-local claims are
                    refused, and the TenantVolumes fill alerts cannot fire.
{% endraw %}{% endif %}{% if storage_backend == 'zfs' %}{% raw %}

              # Pool integrity, from the node_exporter_host zpool textfile
              # collector — it covers every host with a pool, not only the NAS.
              - alert: ZFSPoolNotOnline
                expr: zfs_pool_status_health_code > 0
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} is not ONLINE'
                  description: >-
                    Pool {{ $labels.pool }} on {{ $labels.instance }} reports
                    DEGRADED or worse (health code {{ $value | printf "%.0f" }}).

              - alert: ZFSPoolDataErrors
                expr: zfs_pool_status_data_errors > 0
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} has permanent data errors'
                  description: >-
                    zpool status -v lists {{ $value | printf "%.0f" }} entries with
                    unrecoverable data on pool {{ $labels.pool }}. On a single-vdev
                    pool ZFS cannot self-heal these.

              # Health alone misses silent corruption: checksum errors accumulate
              # while the pool stays ONLINE. Each series is one counter column's max
              # across the pool's vdev rows; `zpool clear` resets them.
              - alert: ZFSPoolDeviceErrors
                expr: sum by (instance, pool) (zfs_pool_status_errors_total) > 0
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} has device errors'
                  description: >-
                    zpool status reports {{ $value | printf "%.0f" }}
                    read/write/cksum errors on pool {{ $labels.pool }}. The pool may
                    still show ONLINE.

              # The == 0 arm covers a never-scrubbed pool and makes a collector
              # regression loud: it emits 0 when it cannot parse a completion time.
              - alert: ZFSPoolScrubStale
                expr: >-
                  (zfs_pool_status_last_scrub_seconds == 0)
                  or (
                    zfs_pool_status_last_scrub_seconds > 0
                    and time() - zfs_pool_status_last_scrub_seconds > 35 * 86400
                  )
                for: 6h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} has no recent completed scrub'
                  description: >-
                    Pool {{ $labels.pool }} has never completed a scrub, or its last
                    one finished over 35 days ago. Without scrubs, latent corruption
                    surfaces only when something reads the bad blocks.

              # zfs-mount-encrypted.service retries forever so its After=
              # dependents stay queued, leaving it permanently `activating`: a
              # generic systemd-failed alert can never match it. This pair covers it.
              - alert: ZfsEncryptedMountStuck
                expr: >-
                  node_systemd_unit_state{name="zfs-mount-encrypted.service",
                  state="activating"} == 1
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Encrypted ZFS datasets have not mounted on {{ $labels.instance }}'
                  description: >-
                    zfs-mount-encrypted has been retrying for 30 minutes on
                    {{ $labels.instance }}, so the encrypted datasets, their NFS
                    exports and every gated guest stay down. Check
                    `systemctl status zfs-mount-encrypted` and
                    `journalctl -u zfs-load-key@<pool>`.

              - alert: ZfsEncryptedMountStuckCritical
                expr: >-
                  node_systemd_unit_state{name="zfs-mount-encrypted.service",
                  state="activating"} == 1
                for: 2h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Encrypted ZFS datasets have not mounted for 2 hours on {{ $labels.instance }}'
                  description: >-
                    zfs-mount-encrypted has not completed in 2 hours on
                    {{ $labels.instance }}. The key source is unreachable or a
                    passphrase rotated: check `journalctl -u zfs-load-key@<pool>`
                    and the secrets backend.

              # swap-clean arms, live only where nas_storage_swap_clean_enabled is
              # on. A skip is permanent while a conflicting unit stays active, and
              # every other swap metric reads green through it.
              - alert: SwapCleanFailed
                expr: swap_clean_last_run_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'swap-clean failed or aborted-unsafe on {{ $labels.instance }}'
                  description: >-
                    The swap-clean run on {{ $labels.instance }} recorded a
                    non-clean outcome: a script error, an unsafe headroom abort,
                    or a guest that did not restart. Swap may not be resetting.
                    Check `journalctl -t swap-clean`.

              - alert: SwapCleanSkipped
                expr: min_over_time(swap_clean_last_run_skipped[3d]) == 1
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'swap-clean has skipped every run for 3 days on {{ $labels.instance }}'
                  description: >-
                    Every swap-clean run in the last 3 days skipped the swap
                    cycle, so swap is never reset while every other swap metric
                    reads green. A conflicting unit that never deactivates
                    disables the job indefinitely. Query
                    swap_clean_skip_reason_info for the reason, then check
                    nas_storage_swap_clean_conflicting_units and
                    `journalctl -t swap-clean`.
{% endraw %}{% endif %}{% raw %}

              # Per-device SMART health from the node_exporter_host smartmon
              # textfile collector: the drive-level precursors a pool alert sees
              # only after corruption. over_time rides through a standby gap.
              - alert: SMARTDeviceUnhealthy
                # min_over_time stays 0 once a drive has reported FAILED, so a
                # standby gap afterwards cannot clear it; a healthy (1) or
                # never-probed (absent) drive never trips it.
                expr: min_over_time(smartmon_device_smart_healthy[6h]) == 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'SMART overall-health FAILED on {{ $labels.device }} ({{ $labels.instance }})'
                  description: >-
                    smartmon_device_smart_healthy for {{ $labels.device }} on
                    {{ $labels.instance }} has reported FAILED within the last
                    6 hours. The drive's own self-assessment predicts imminent
                    failure — plan replacement and check the pool it backs.

              # A stable non-zero count from an old event is not actionable;
              # growth is. The delta is directional — the latest reading minus
              # the 24h floor — so a replacement zeroing the counter reads as 0.
              - alert: SMARTReallocatedSectorsGrowing
                expr: >-
                  last_over_time(smartmon_reallocated_sector_count[1h])
                  - min_over_time(smartmon_reallocated_sector_count[24h]) > 0
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'Reallocated sectors growing on {{ $labels.device }} ({{ $labels.instance }})'
                  description: >-
                    Reallocated_Sector_Ct on {{ $labels.device }} on
                    {{ $labels.instance }} grew by
                    {{ $value | printf "%.0f" }} in the last 24 hours. A drive
                    actively remapping sectors is degrading — plan replacement.

              # A sector found once is a worklist item; a second one is the
              # news. The alert closes 24h after the count stops moving, and a
              # further sector fires it again.
              - alert: SMARTPendingSectorsGrowing
                expr: >-
                  last_over_time(smartmon_current_pending_sector_count[1h])
                  - min_over_time(smartmon_current_pending_sector_count[24h]) > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'Pending sectors growing on {{ $labels.device }} ({{ $labels.instance }})'
                  description: >-
                    Current_Pending_Sector on {{ $labels.device }} on
                    {{ $labels.instance }} grew by {{ $value | printf "%.0f" }}
                    in the last 24 hours — sectors are unreadable and awaiting
                    reallocation. A scrub of the backing pool will surface any
                    affected data.

              - alert: SMARTOfflineUncorrectableGrowing
                expr: >-
                  last_over_time(smartmon_offline_uncorrectable_count[1h])
                  - min_over_time(smartmon_offline_uncorrectable_count[24h]) > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'Offline-uncorrectable sectors growing on {{ $labels.device }} ({{ $labels.instance }})'
                  description: >-
                    Offline_Uncorrectable on {{ $labels.device }} on
                    {{ $labels.instance }} grew by {{ $value | printf "%.0f" }}
                    in the last 24 hours — sectors that could not be corrected
                    on read. A strong replace-soon signal.

              # NVMe media and data-integrity errors: the SSD-side equivalent of
              # reallocated and uncorrectable sectors.
              - alert: SMARTMediaErrors
                expr: max_over_time(smartmon_media_errors_count[6h]) > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'NVMe media errors on {{ $labels.device }} ({{ $labels.instance }})'
                  description: >-
                    Media and Data Integrity Errors on {{ $labels.device }} on
                    {{ $labels.instance }} is {{ $value | printf "%.0f" }}. The
                    controller has logged uncorrectable data errors —
                    investigate and plan replacement.

              # Collector meta-failure. absent() makes an undeployed collector
              # loud but needs every host silent, so the up arm catches one host
              # losing its series, scoped to the job that serves them.
              - alert: SMARTCollectorStale
                # The success arm catches a refreshed sentinel with a failed scan
                # or no device parsed. The devices_scanned witness lapses a month
                # after the last good scan, keeping an unenrolled host quiet.
                expr: >-
                  (time() - smartmon_collector_last_success_seconds > 900)
                  or absent(smartmon_collector_last_success_seconds)
                  or (
                    (
                      up{job="node-exporter-host"} == 1
                      unless on (instance) smartmon_collector_last_success_seconds
                    )
                    and on (instance) (
                      max_over_time(smartmon_collector_devices_scanned[30d]) > 0
                    )
                  )
                  or (
                    smartmon_collector_success == 0
                    and on(instance) (
                      smartmon_collector_devices_scanned > 0
                    )
                  )
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#storage'
                  summary: 'smartmon collector is degraded or missing on {{ $labels.instance }}'
                  description: >-
                    smartmon_collector_last_success_seconds is stale (>15m),
                    gone on a scraped host whose peers still report, entirely
                    absent, or the collector reports success 0
                    (smartctl unrunnable, scan failed, or no device parsed), so
                    the SMART device alerts on this host serve stale or no
                    inputs. Check
                    `journalctl -u smartmon-collector.service` and
                    `systemctl status smartmon-collector.timer`.

      platform-nodes:
        groups:
          - name: platform.nodes
            rules:
              - alert: NodeMemoryPressure
                expr: kube_node_status_condition{condition="MemoryPressure", status="true"} == 1
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Node {{ $labels.node }} is under memory pressure'
                  description: 'Kubelet on {{ $labels.node }} has reported memory pressure for 5 minutes. Pods may be evicted.'

              # Null-routed source for the node-outage inhibit. The 7d arm keeps a
              # never-Ready node from muting alerts; both sides aggregate by node so a
              # kube-state-metrics reschedule keeps the history.
              - alert: NodeOutageStormControl
                expr: >-
                  max by (node, condition, status) (kube_node_status_condition{condition="Ready", status="true"}) == 0
                  and max by (node, condition, status) (max_over_time(kube_node_status_condition{condition="Ready", status="true"}[7d])) == 1
                for: 5m
                labels:
                  severity: none
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Node {{ $labels.node }} NotReady — workload alerts inhibited'
                  description: >-
                    {{ $labels.node }} has been NotReady for under 7 days, so
                    per-pod and per-workload warnings are inhibited while it
                    recovers. The critical tier is never inhibited.

              # A blip shorter than KubeNodeNotReady's 15m hold is two changes, so one
              # a day stays quiet. Summed by node, so the count survives a
              # kube-state-metrics reschedule.
              - alert: KubeNodeReadyFlapping
                expr: >-
                  sum by (node) (changes(kube_node_status_condition{condition="Ready", status="true"}[1d])) > 2
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'Node {{ $labels.node }} Ready condition flapped {{ $value }} times in 24h'
                  description: >-
                    The Ready condition of {{ $labels.node }} changed {{ $value
                    }} times in 24 hours, each NotReady spell too short for
                    KubeNodeNotReady to page.

              - alert: NodeStuckCordoned
                expr: kube_node_spec_unschedulable == 1
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Node {{ $labels.node }} cordoned (unschedulable) for 30m'
                  description: >-
                    Node {{ $labels.node }} has been SchedulingDisabled for 30
                    minutes. If maintenance is not in progress, suspect a stuck
                    uncordon or a timed-out drain, then
                    `kubectl uncordon {{ $labels.node }}`.

              # A healthy reboot cycle clears well inside 3h, so a sentinel held
              # longer means no node is being serviced: a dead kured pod holding
              # the cluster lock, a blocking pod, or a PDB refusing the drain.
              - alert: KuredRebootStuck
                expr: kured_reboot_required == 1
                for: 3h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'kured reboot for {{ $labels.node }} pending over 3h (stuck cycle)'
                  description: >-
                    Node {{ $labels.node }} has held the kured reboot sentinel for
                    more than 3 hours. Check the cluster-wide lock
                    (`kubectl -n kube-system get ds kured -o jsonpath='{.metadata.annotations}'`),
                    any CI job pinning the node, and PDBs blocking the drain.
                    Clear a dead lock with `kubectl -n kube-system annotate
                    ds/kured weave.works/kured-node-lock-`.

              # The maintenance playbooks write this node-exporter textfile
              # metric when they defer a host reboot to an operator. It
              # self-clears once the host no longer needs one.
              - alert: MaintenanceRebootDeferred
                expr: maintenance_reboot_deferred == 1
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Host {{ $labels.host }} has a maintenance-deferred reboot pending'
                  description: >-
                    Maintenance deferred a kernel reboot of {{ $labels.host }} to
                    an operator. Reboot it manually when convenient; the alert
                    clears on the next run.

              # node-exporter-healthcheck.sh restarts the exporter when /metrics
              # goes unanswered twice. /metrics answers again between restarts, so
              # a restart loop fires no exporter-down alert; this gauge is the signal.
              - alert: NodeExporterHealthcheckRestartLoop
                expr: >-
                  changes(node_exporter_healthcheck_last_restart_timestamp_seconds[1h]) >= 3
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'node_exporter is being restarted repeatedly on {{ $labels.instance }}'
                  description: >-
                    The liveness gate has restarted node_exporter at least three
                    times in the last hour on {{ $labels.instance }}. Check
                    `journalctl -t node-exporter-healthcheck` and
                    `systemctl status prometheus-node-exporter`.

              # Every encrypted_swap fallback branch exits 0 so the host keeps
              # booting, so this gauge is the only report that swap went back to
              # cleartext. Absent on hosts where the role is off, so inert there.
              - alert: EncryptedSwapPlaintextFallback
                expr: >-
                  encrypted_swap_mapper_active == 0
                  and on (instance) (encrypted_swap_any_swap_active == 1)
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Swap on {{ $labels.instance }} is plaintext, not the dm-crypt mapper'
                  description: >-
                    The dm-crypt swap mapper is not the active swap device on
                    {{ $labels.instance }}, so swapped-out memory is written in
                    cleartext while the finalize unit reads green. Check
                    `swapon --show` and `journalctl -t encrypted-swap`.

              # The swapless half: the mapper failed AND the plaintext fallback
              # could not be restored, which no SwapTotal threshold alert sees.
              - alert: EncryptedSwapRestoreFailed
                expr: >-
                  encrypted_swap_any_swap_active == 0
                  and on (instance) (node_memory_SwapTotal_bytes == 0)
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Encrypted-swap finalize left {{ $labels.instance }} with no swap'
                  description: >-
                    The encrypted-swap switch on {{ $labels.instance }} failed and
                    the plaintext fallback could not be restored, so the host runs
                    with no swap. Check `swapon --show` and
                    `journalctl -t encrypted-swap`.

      platform-resources:
        groups:
          - name: platform.resources
            rules:
              # RSS against the container's own limit, so page cache never
              # counts. authentik/postgresql is judged on its working set
              # instead: its shared buffers are charged but sit outside RSS.
              - alert: ContainerMemoryNearLimit
                expr: >-
                  (
                  max by (namespace, pod, container) (
                  container_memory_rss{container!="", container!="POD"}
                  )
                  / on (namespace, pod, container) group_left ()
                  max by (namespace, pod, container) (
                  kube_pod_container_resource_limits{resource="memory"}
                  )
                  ) > 0.9
                  or
                  (
                  max by (namespace, pod, container) (
                  container_memory_working_set_bytes{namespace="authentik",
                  container="postgresql"}
                  )
                  / on (namespace, pod, container) group_left ()
                  max by (namespace, pod, container) (
                  kube_pod_container_resource_limits{resource="memory", namespace="authentik",
                  container="postgresql"}
                  )
                  ) > 0.9
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: >-
                    Container {{ $labels.namespace }}/{{ $labels.pod }}/{{ $labels.container }}
                    holds unreclaimable memory within 10% of its limit
                  description: >-
                    Memory the kernel cannot reclaim in container
                    {{ $labels.container }} of {{ $labels.namespace }}/{{ $labels.pod }}
                    (RSS; for authentik/postgresql the working set, which carries
                    its shared buffers) has held above 90% of the memory limit
                    for 15 minutes ({{ $value | humanizePercentage }}). This is
                    not page cache: raise the limit in git and, where the
                    workload has a VPA, its maxAllowed alongside.

              # The rule above reads RSS, so a charge that is tmpfs, slab or
              # kernel memory reaches the limit unseen. Edge-triggered on the
              # restart counter, qualified by the last-terminated reason.
              - alert: ContainerOOMKilled
                expr: >-
                  increase(kube_pod_container_status_restarts_total[1h]) > 0
                  and on (namespace, pod, container)
                  kube_pod_container_status_last_terminated_reason{reason="OOMKilled"} == 1
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: >-
                    Container {{ $labels.namespace }}/{{ $labels.pod }}/{{ $labels.container }}
                    was OOMKilled
                  description: >-
                    Container {{ $labels.container }} in pod
                    {{ $labels.namespace }}/{{ $labels.pod }} hit its memory
                    limit and was killed by the kernel. A container that
                    restarts cleanly after the kill is invisible to
                    KubePodCrashLooping, so this is the only signal. Raise the
                    limit in git and, where the workload has a VPA, its
                    maxAllowed alongside.

              # The chart's quota-overcommit pair minus any gitlab-runner*
              # namespace: a CI runner quota over-requests for burst CI.
              - alert: KubeCPUQuotaOvercommitNonCI
                expr: >-
                  sum(min without (resource) (kube_resourcequota{job="kube-state-metrics", type="hard",
                  resource=~"(cpu|requests.cpu)", namespace!~"gitlab-runner.*"}))
                  /
                  sum(kube_node_status_allocatable{job="kube-state-metrics", resource="cpu"})
                  > 1.5
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Non-CI ResourceQuotas promise more than 1.5x the cluster CPU'
                  description: >-
                    The hard CPU of every ResourceQuota outside the CI runner
                    namespaces sums to {{ $value | humanizePercentage }} of
                    allocatable CPU.

              - alert: KubeMemoryQuotaOvercommitNonCI
                expr: >-
                  sum(min without (resource) (kube_resourcequota{job="kube-state-metrics", type="hard",
                  resource=~"(memory|requests.memory)", namespace!~"gitlab-runner.*"}))
                  /
                  sum(kube_node_status_allocatable{job="kube-state-metrics", resource="memory"})
                  > 1.5
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Non-CI ResourceQuotas promise more than 1.5x the cluster memory'
                  description: >-
                    The hard memory of every ResourceQuota outside the CI runner
                    namespaces sums to {{ $value | humanizePercentage }} of
                    allocatable memory.

      platform-gitops:
        groups:
          - name: platform.gitops
            rules:
              - alert: FluxReconciliationFailure
                expr: sum by (controller) (rate(controller_runtime_reconcile_errors_total{job="observability/flux-system"}[5m])) > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Flux controller {{ $labels.controller }} has reconciliation errors'
                  description: >-
                    Flux controller {{ $labels.controller }} has produced
                    reconciliation errors at {{ $value | printf "%.2f" }}/s for 15
                    minutes.

              # Catches a HelmRelease or Kustomization durably not Ready at any
              # error rate, complementing the rate-based rule above.
              # gotk_resource_info comes from kube-state-metrics, not Flux.
              - alert: FluxResourceNotReady
                expr: gotk_resource_info{ready="False", suspended!="true"} == 1
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: >-
                    Flux resource {{ $labels.customresource_kind }}/{{ $labels.exported_namespace }}/{{ $labels.name }} not Ready
                  description: >-
                    Ready=False for 15 minutes. Run `flux get all -A | grep -v True`
                    and `kubectl describe {{ $labels.customresource_kind }}
                    {{ $labels.name }} -n {{ $labels.exported_namespace }}`.

      platform-secrets:
        groups:
          - name: platform.secrets
            rules:
              - alert: ExternalSecretSyncFailure
                expr: externalsecret_status_condition{condition="Ready", status="False"} == 1
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'ExternalSecret {{ $labels.name }} sync failing'
                  description: 'ExternalSecret {{ $labels.name }} in {{ $labels.namespace }} has not synced for 15 minutes.'

              # The secrets provider is the dependency every ExternalSecret
              # shares: while it is down nothing can be created or rotated. The
              # target follows the secrets backend through cluster-config.
              - alert: SecretsProviderDown
                expr: >-
                  kube_deployment_status_replicas_available{namespace="${cluster_secrets_provider_namespace}", deployment="${cluster_secrets_provider_deployment}"} == 0
                  or absent(kube_deployment_status_replicas_available{namespace="${cluster_secrets_provider_namespace}", deployment="${cluster_secrets_provider_deployment}"})
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'The in-cluster secrets provider has no available replicas'
                  description: >-
                    The secrets provider deployment has had 0 available replicas
                    for 5 minutes, or the metric is absent (kube-state-metrics
                    also down). No secret can be created or rotated until it
                    recovers.

      platform-certificates:
        groups:
          - name: platform.certificates
            rules:
              - alert: CertExpiringWarning
                expr: certmanager_certificate_expiration_timestamp_seconds - time() < 86400 * 14
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Certificate {{ $labels.name }} expiring in less than 14 days'
                  description: 'Certificate {{ $labels.name }} in {{ $labels.namespace }} expires in {{ $value | humanizeDuration }}.'

              - alert: CertExpiringCritical
                expr: certmanager_certificate_expiration_timestamp_seconds - time() < 86400 * 3
                for: 1h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Certificate {{ $labels.name }} expiring in less than 3 days'
                  description: 'Certificate {{ $labels.name }} in {{ $labels.namespace }} expires in {{ $value | humanizeDuration }}.'

              # The expiry arms need a first successful issuance; this covers a
              # Certificate that never gets one.
              - alert: CertificateNotReady
                expr: certmanager_certificate_ready_status{condition="False"} == 1
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Certificate {{ $labels.name }} in {{ $labels.namespace }} is not Ready'
                  description: >-
                    cert-manager has not issued this certificate for an hour. The
                    expiry alerts cannot cover it: that series only exists after a
                    first successful issuance.

              # Backstop for TLS cert-manager does not issue. The internal zone is
              # excluded; the sso-external target remains, and its cert-manager
              # cert also trips CertExpiringWarning.
              - alert: BlackboxCertExpiringSoon
                expr: >-
                  probe_ssl_earliest_cert_expiry{
                  instance=~"https://[^/]+\\.${cluster_external_domain}(/.*)?",
                  instance!~"https://[^/]+\\.${cluster_internal_domain}(/.*)?"
                  } - time() < 86400 * 14
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'TLS cert presented by {{ $labels.instance }} expires in under 14 days'
                  description: >-
                    The certificate presented by {{ $labels.instance }} expires in
                    {{ $value | humanizeDuration }}. If it is edge/CDN-managed this
                    normally auto-renews — investigate if it does not clear.

              # The host-side renewal's own gauges, read from the node-exporter
              # textfile. The run bit covers the local certificate only; a dead
              # distribution target is the per-target arm below.
              - alert: CertRenewalFailed
                expr: cert_renewal_last_run_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Host-side certificate renewal failed on {{ $labels.instance }}'
                  description: >-
                    The renewal or the local reload on {{ $labels.instance }}
                    failed. Distribution to the other hosts has its own gauges,
                    so this is the local certificate: read the acme.sh log and
                    the reload script's journal on that host.

              # A renewal pipeline broken for three days is an incident, not a
              # nudge: the expiry arms below are only the backstop, and weeks of
              # failure burn the whole issuance cycle of margin.
              - alert: CertRenewalFailedProlonged
                expr: cert_renewal_last_run_success == 0
                for: 72h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Host-side certificate renewal has been failing for over 3 days'
                  description: >-
                    Local renewal on {{ $labels.instance }} has failed
                    continuously for three days. The wildcard certificate still
                    has margin, but nothing is renewing it. Fix the pipeline
                    before the expiry alerts are the only thing left.

              # The run bit only moves when the renewal runs, so a dead cron
              # neither renews nor fails. 75d is past the ~60d issuance cycle,
              # leaving ~15d. No absent arm: the gauge needs one success first.
              - alert: CertRenewalStale
                expr: time() - cert_renewal_last_success_timestamp_seconds > 86400 * 75
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'No successful certificate renewal on {{ $labels.instance }} in over 75 days'
                  description: >-
                    {{ $labels.instance }} last renewed a certificate
                    {{ $value | humanizeDuration }} ago, past the issuance cycle,
                    so renewal has stopped running rather than failing. Check the
                    renewal cron entry on that host and the reload script's
                    journal.

              # Per-target gauge: the run-level bit stays 1 for a dead target,
              # so this is the only arm that names one. The 25h hold spans the
              # daily distribution check that refreshes the gauges.
              - alert: CertDistributionTargetFailed
                expr: cert_distribution_target_last_run_success == 0
                for: 25h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Certificate distribution to {{ $labels.host }} is failing'
                  description: >-
                    The host-side renewal could not install the wildcard
                    certificate on {{ $labels.host }}. Every other target is
                    unaffected, so that host keeps serving the certificate it
                    already holds until it expires. Check the reload script's
                    journal on {{ $labels.instance }} and SSH reachability to
                    the named host.

              # Real notAfter, not time since renewal: issuance is ~60d apart, so
              # a renewal-timestamp proxy false-fires for most of each cycle. The
              # absent arm catches a host that stopped emitting the gauge.
              - alert: CertExpiringSoon
                expr: (cert_local_expiry_timestamp_seconds - time() < 86400 * 14) or absent(cert_local_expiry_timestamp_seconds)
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Host-distributed wildcard certificate expires in under 14 days'
                  description: >-
                    The host-distributed wildcard for
                    ${cluster_internal_domain} is within 14 days of its
                    notAfter, so renewal and distribution have stopped working,
                    or the gauge is absent because the host left the inventory.
                    cert-manager's expiry alerts cover in-cluster certificates,
                    not this one.

              # This certificate terminates the TLS-required NFS exports and log
              # ingest as well as web UIs, so expiry is wider than a browser
              # warning. No absent arm: absence stays warning-tier above.
              - alert: CertExpiringSoonCritical
                expr: cert_local_expiry_timestamp_seconds - time() < 86400 * 3
                for: 1h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#certificates'
                  summary: 'Host-distributed wildcard certificate expires in under 3 days'
                  description: >-
                    The host-distributed wildcard on {{ $labels.instance }}
                    expires in {{ $value | humanizeDuration }}. The TLS-required
                    NFS exports, the resolver's TLS listener and the log-ingest
                    ingress all break at expiry — renew and redistribute now.

      platform-probes:
        groups:
          - name: platform.probes
            rules:
              # The 10m hold absorbs brief probe dips. A load-bearing endpoint
              # gets its own critical rule, matched on instance and paired with
              # an inhibit. The 1.1.1.1 WAN witness reports the ISP, not this cluster.
              - alert: EndpointDown
                expr: max by (instance) (probe_success{instance!~"1\\.1\\.1\\.1"}) == 0
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'Endpoint {{ $labels.instance }} is down'
                  description: 'Blackbox probe for {{ $labels.instance }} has failed for 10 minutes.'

              - alert: BlackboxExporterDown
                expr: absent(up{job=~".*blackbox.*"} == 1)
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'Blackbox exporter is down'
                  description: 'All endpoint monitoring is blind — the blackbox exporter has been down for 5 minutes.'

              # Prometheus label matchers are fully anchored, so renaming a probe
              # target silently empties every rule that selects it by instance.
              # This names the load-bearing ones, the WAN witness included.
              - alert: KeyEndpointProbeMissing
                expr: >-
                  absent(probe_success{instance="https://auth.${cluster_internal_domain}"})
                  or absent(probe_success{instance="https://auth.${cluster_external_domain}"})
                  or absent(probe_success{instance="1.1.1.1"})
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'A load-bearing blackbox probe target has no series'
                  description: >-
                    One of the probe targets other rules select by instance has
                    produced no probe_success series for 15 minutes, so those
                    rules now match nothing. Restore the target in
                    observability/exporters/blackbox-exporter.yaml, or repoint
                    every rule that names it.

      platform-dns:
        groups:
          - name: platform.dns
            rules:
              # external-dns silently owning zero sources is the failure that
              # looks healthy: the controller is Ready and publishes nothing.
              - alert: ExternalDNSNoSourceEndpoints
                expr: max(external_dns_source_endpoints_total) == 0 or absent(external_dns_source_endpoints_total)
                for: 15m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'external-dns sees no source endpoints'
                  description: >-
                    external-dns has found no Ingress or Service source for 15
                    minutes, or exports no source metric at all. Every record it
                    owns is unmanaged until this clears.

              - alert: ExternalDNSSyncStale
                expr: >-
                  time() - max(external_dns_controller_last_sync_timestamp_seconds) > 1800
                  or absent(external_dns_controller_last_sync_timestamp_seconds)
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'external-dns has not synced in over 30 minutes'
                  description: >-
                    The last successful external-dns sync is more than 30 minutes
                    old, or the metric is absent. Check the provider credential
                    and the controller log.

              # The offset arm proves the 6h lookback holds real samples: a
              # rebuilt series would otherwise read its own first minutes as the
              # baseline and page for a drop that never happened.
              - alert: ExternalDNSRecordsDropped
                expr: >-
                  sum(external_dns_registry_records)
                  < 0.8 * max_over_time(sum(external_dns_registry_records)[6h:15m])
                  and sum(external_dns_registry_records offset 5h)
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'external-dns owns fewer records than it did'
                  description: >-
                    The owned-record count has fallen by more than a fifth against
                    its six-hour peak. A changed annotation prefix or owner id
                    makes external-dns disown and delete records it created.

      platform-logging:
        groups:
          - name: platform.logging
            rules:
              # The Loki ruler is the only alert path that does not run through
              # Prometheus, so nothing else notices when it stops.
              - alert: LokiRulerRulesMissing
                expr: (sum(loki_prometheus_rule_group_rules{job="observability/loki"}) or vector(0)) < 1
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'The Loki ruler has loaded no rules'
                  description: >-
                    The ruler has loaded no rules at all. Check the loki-sc-rules
                    sidecar and the rule ConfigMap's folder annotation.

              - alert: LokiRulerEvaluationFailures
                expr: sum(increase(loki_prometheus_rule_evaluation_failures_total{job="observability/loki"}[15m])) > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'The Loki ruler is failing rule evaluations'
                  description: >-
                    LogQL rule evaluations have failed in the last 15 minutes. The
                    log-based alerts are not firing while this holds.

              - alert: LokiRulerNotificationFailures
                expr: >-
                  sum(increase(loki_prometheus_notifications_errors_total{job="observability/loki"}[15m])) > 0
                  or max(loki_prometheus_notifications_alertmanagers_discovered{job="observability/loki"}) == 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'The Loki ruler cannot reach Alertmanager'
                  description: >-
                    Notification delivery from the Loki ruler is failing, or the
                    ruler has discovered no Alertmanager at all, so a firing log
                    alert never reaches a receiver.

              # Discards are unrecoverable (RF=1, senders do not retry a 4xx) and
              # arrive in bursts, so each rule pairs a burst-rate arm with an hourly
              # volume arm. Split by reason: a limits_config cap vs the accept window.
              - alert: LokiDiscardsRateLimited
                expr: >-
                  sum by (reason) (rate(loki_discarded_samples_total{job="observability/loki",
                  reason=~"rate_limited|per_stream_rate_limit"}[5m])) > 0
                  or
                  sum by (reason) (increase(loki_discarded_samples_total{job="observability/loki",
                  reason=~"rate_limited|per_stream_rate_limit"}[1h])) > 10000
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Loki is rate-limiting ingestion ({{ $labels.reason }})'
                  description: >-
                    Loki is dropping pushed lines with reason {{ $labels.reason
                    }} against its limits_config caps, and those lines are lost.

              - alert: LokiDiscardsOutOfOrder
                expr: >-
                  sum by (reason) (rate(loki_discarded_samples_total{job="observability/loki",
                  reason=~"too_far_behind|greater_than_max_sample_age"}[5m])) > 0
                  or
                  sum by (reason) (increase(loki_discarded_samples_total{job="observability/loki",
                  reason=~"too_far_behind|greater_than_max_sample_age"}[1h])) > 10000
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'Loki is rejecting out-of-order or too-old lines ({{ $labels.reason }})'
                  description: >-
                    Loki is dropping lines with reason {{ $labels.reason }}
                    because they arrived behind its out-of-order window or past
                    its maximum sample age.

      platform-monitoring:
        groups:
          - name: platform.monitoring
            rules:
              # Replaces the chart's copy, which defaultRules.disabled turns off.
              # for: 15m rides out a transient receiver timeout.
              # Taken from kube-prometheus-stack 92.14.1
              - alert: AlertmanagerClusterFailedToSendAlerts
                expr: >-
                  min by (namespace, service, integration) (
                  rate(alertmanager_notifications_failed_total{job="kube-prometheus-stack-alertmanager",
                  container="alertmanager", namespace="observability"}[15m])
                  / ignoring (reason) group_left
                  rate(alertmanager_notifications_total{job="kube-prometheus-stack-alertmanager",
                  container="alertmanager", namespace="observability"}[15m]) > 0
                  ) > 0.01
                for: 15m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'Alertmanager has failed to notify {{ $labels.integration }} for 15 minutes'
                  description: >-
                    Over 1% of notifications to {{ $labels.integration }} have
                    failed for 15 minutes (currently {{ $value | humanizePercentage }}).
                    Alerts are being generated but not delivered on that
                    integration.

      platform-networking:
        groups:
          - name: platform.networking
            rules:
              # A speaker-less cluster still ASSIGNS every LoadBalancer IP, so
              # the Services look healthy while nothing announces the VIPs.
              - alert: MetalLBSpeakerNotScheduled
                expr: >-
                  kube_daemonset_status_desired_number_scheduled{namespace="metallb-system",
                  daemonset="metallb-speaker"} == 0
                  or absent(kube_daemonset_status_desired_number_scheduled{namespace="metallb-system",
                  daemonset="metallb-speaker"})
                for: 10m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md'
                  summary: 'No metallb-speaker pod is scheduled, so no LoadBalancer VIP is announced'
                  description: >-
                    The metallb-speaker DaemonSet wants zero pods, or no longer
                    exists, usually because no node carries the
                    ${cluster_node_label_domain}/ingress label. MetalLB still assigns EXTERNAL-IPs from the pools, but
                    every VIP is unreachable.

              # An unassigned ingress VIP presents as an EndpointDown flood with no
              # stated cause. One rule per Service, so the alert names the VIP.
              - alert: TraefikPublicVipMissing
                expr: >-
                  absent(kube_service_status_load_balancer_ingress{namespace="traefik",
                  service="traefik", ip="${cluster_metallb_public_vip}"})
                for: 10m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#a-traefik-vip-is-not-assigned'
                  summary: 'Traefik public VIP ${cluster_metallb_public_vip} is not assigned'
                  description: >-
                    The traefik LoadBalancer Service no longer carries
                    ${cluster_metallb_public_vip}, so every public route is
                    unreachable.

              - alert: TraefikInternalVipMissing
                expr: >-
                  absent(kube_service_status_load_balancer_ingress{namespace="traefik",
                  service="traefik-internal", ip="${cluster_metallb_internal_vip}"})
                for: 10m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#a-traefik-vip-is-not-assigned'
                  summary: 'Traefik internal VIP ${cluster_metallb_internal_vip} is not assigned'
                  description: >-
                    The traefik-internal LoadBalancer Service no longer carries
                    ${cluster_metallb_internal_vip}, so every internal route is
                    unreachable.

      platform-backups:
        groups:
          - name: platform.backups
            rules:
              # Off-node etcd snapshot copy. Losing every server node without an
              # off-node snapshot loses etcd. 26h = two 12h snapshot cycles; the
              # absent() arm fires if the copy metric never appears at all.
              - alert: EtcdSnapshotStale
                expr: (time() - etcd_snapshot_last_copy_timestamp_seconds > 93600) or absent(etcd_snapshot_last_copy_timestamp_seconds)
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'etcd snapshot off-node copy is stale'
                  description: >-
                    The newest off-node etcd snapshot is more than 26 hours old, or
                    the copy metric is missing. Check the snapshot copy timer on
                    the server nodes.

              - alert: OffsiteBackupFailed
                expr: restic_offsite_last_run_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Offsite backup run failed'
                  description: >-
                    The last offsite backup run exited unsuccessfully. Offsite
                    durability is at risk — check the backup unit's journal on the
                    storage host.

              # restic rc=3 is a success with unreadable paths, so the run gauge
              # above stays 1. The incomplete gauge is sticky until an rc=0 run
              # clears it, which is what makes the 36h arm span two nights.
              - alert: OffsiteBackupIncomplete
                expr: restic_offsite_last_run_incomplete == 1
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'The last offsite backup run skipped unreadable paths'
                  description: >-
                    restic exited 3: the snapshot exists but at least one path
                    could not be read. Check which paths the backup unit logged
                    on the storage host.

              - alert: OffsiteBackupIncompleteProlonged
                expr: restic_offsite_last_run_incomplete == 1
                for: 36h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Two consecutive offsite backup runs were incomplete'
                  description: >-
                    The offsite snapshot has skipped unreadable paths across two
                    consecutive nightly runs. Whatever cannot be read has not
                    reached the offsite repository in over a day.

              # 50h tolerates one skipped night. The absent() arm is gated on
              # ${cluster_offsite_backup_probe_metric} so it stays inert until
              # the offsite tier is on — see infrastructure/sources/cluster-config.yaml.
              - alert: OffsiteBackupStale
                expr: >-
                  (time() - restic_offsite_last_success_timestamp_seconds > 180000)
                  or absent({__name__=~"${cluster_offsite_backup_probe_metric}"})
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Offsite backup has not succeeded in over 50 hours'
                  description: >-
                    No successful offsite backup in more than 50 hours (one skipped
                    night plus grace), or the metric is absent.

              # Repository integrity, distinct from upload freshness: an
              # unverifiable offsite copy defeats the tier. No absent() arm — the
              # metric only appears after the first verify.
              - alert: OffsiteBackupVerifyStale
                expr: >-
                  (time() - restic_offsite_last_verify_timestamp_seconds > 691200)
                  or restic_offsite_last_verify_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Offsite repository verify is stale (>8d) or failing'
                  description: >-
                    The offsite repository has not passed an integrity check in
                    over 8 days, or the last check failed. Run the verify command
                    on the storage host before relying on it for recovery.

              # The three LOCAL tiers, all off in a fresh cluster. Each stale arm
              # is gated on its own probe metric (see cluster-config.yaml), so
              # the arms stay inert until the tier is turned on.
              - alert: ArchiveBackupFailed
                expr: archive_backup_last_run_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Archive replication run failed'
                  description: >-
                    The last archive replication to the detachable pool exited
                    with a zfs send/receive error. The offsite tier chains off
                    this one, so both copies stop ageing forward together.

              - alert: ArchiveBackupStale
                expr: >-
                  (time() - archive_backup_last_success_timestamp_seconds > 172800)
                  or absent({__name__=~"${cluster_archive_backup_probe_metric}"})
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Archive replication has not succeeded in over 2 days'
                  description: >-
                    No successful archive replication in more than 48 hours, or
                    the metric is absent while the tier is enabled.

              # A deferred dataset re-emits its previous success timestamp rather
              # than zeroing it, so a chronically deferred one still goes stale.
              - alert: ArchiveBackupDatasetStale
                expr: time() - archive_backup_dataset_last_success_timestamp_seconds > 172800
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Archive dataset {{ $labels.dataset }} has not replicated in over 2 days'
                  description: >-
                    Dataset {{ $labels.dataset }} has had no successful archive
                    replication for more than 48 hours. A dataset deferred every
                    run means the vzdump window is overrunning the archive one.

              - alert: VzdumpBackupFailed
                expr: vzdump_backup_last_run_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Proxmox vzdump backup failed on {{ $labels.instance }}'
                  description: >-
                    The last vzdump job did not complete successfully. Guest
                    images are the DR path for every VM and LXC on that host.

              # 36h tolerates one night deferred by planned maintenance. The
              # unless arm spares a node whose last run succeeded selecting no
              # guests; a run that failed still pages.
              - alert: VzdumpBackupStale
                expr: >-
                  (
                    (time() - vzdump_backup_last_success_timestamp_seconds > 129600)
                    unless on (instance) (
                      vzdump_backup_guests == 0
                      and on (instance) vzdump_backup_last_run_success == 1
                    )
                  )
                  or absent({__name__=~"${cluster_vzdump_probe_metric}"})
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Proxmox vzdump backup has not succeeded in over 36 hours'
                  description: >-
                    No successful vzdump on {{ $labels.instance }} in more than
                    36 hours, or the metric is absent while the tier is enabled.

              # The witness for the host VzdumpBackupStale's `unless` arm spares:
              # a zero-guest run refreshes the timestamp, so nothing else sees it.
              # The 30d arm spares a host whose guests are all excluded.
              - alert: VzdumpBackupNoGuests
                expr: >-
                  vzdump_backup_guests == 0
                  and on (instance) vzdump_backup_last_run_success == 1
                  and on (instance) (max_over_time(vzdump_backup_guests[30d]) > 0)
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Proxmox vzdump on {{ $labels.instance }} backed up no guests'
                  description: >-
                    The last vzdump run on {{ $labels.instance }} finished
                    successfully without starting a single guest backup, so its
                    success metric and timestamp stay green while nothing new
                    lands. Check the guest selection on that host's backup
                    schedule, and that the host still owns guests.

              # /etc/pve holds the cluster CA, node certs and every guest
              # definition — the first step of rebuilding the cluster itself.
              - alert: PveClusterBackupFailed
                expr: pve_cluster_backup_last_run_success == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Proxmox /etc/pve cluster-config backup failed'
                  description: >-
                    The nightly /etc/pve tar did not complete. vzdump covers the
                    guests; this is the DR path for the cluster itself.

              # The Failed arm cannot fire if the timer simply stops: the last
              # success=1 stays in the textfile forever.
              - alert: PveClusterBackupStale
                expr: time() - pve_cluster_backup_last_success_timestamp_seconds > 129600
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Proxmox /etc/pve cluster-config backup has not succeeded in over 36 hours'
                  description: >-
                    No successful /etc/pve tar in more than 36 hours — the
                    pve-cluster-backup timer has probably stopped.

              # Per-app logical dumps landing on the NAS, one series per entry in
              # nas_storage_backup_artifact_apps.
              - alert: BackupArtifactStale
                # The mtime guard keeps a dump that never landed (mtime 0) out of
                # this arm; BackupArtifactNeverLanded owns that case. One absent()
                # arm per app, held equal by scripts/check-backup-artifact-apps.py.
                expr: >-
                  (backup_artifact_last_mtime_seconds > 0
                  and time() - backup_artifact_last_mtime_seconds > 180000)
                  or absent(backup_artifact_last_mtime_seconds{app="authentik"})
                  or absent({__name__=~"${cluster_backup_artifact_probe_metric}"})
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Backup artifact for {{ $labels.app }} stopped landing'
                  description: >-
                    The newest dump for {{ $labels.app }} is more than 50 hours
                    old, or its series has gone missing while the tier is enabled.

              # Four days is two more failed nightly cycles past the warning, with
              # no dump reaching the offsite chain. Absence and the never-landed
              # mtime 0 stay warning-tier.
              - alert: BackupArtifactStaleCritical
                expr: >-
                  backup_artifact_last_mtime_seconds > 0
                  and time() - backup_artifact_last_mtime_seconds > 86400 * 4
                for: 1h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Backup artifact for {{ $labels.app }} has not landed in over 4 days'
                  description: >-
                    The newest dump for {{ $labels.app }} is more than 4 days
                    old, so nothing for that app has entered the offsite chain
                    in four nights.

              # mtime 0 is the collector saying nothing matched the app's glob, so
              # no dump has EVER landed. The window outlasts a full schedule
              # interval, and unlike a 26h `for:` it survives a restart.
              - alert: BackupArtifactNeverLanded
                expr: >-
                  max_over_time(backup_artifact_last_mtime_seconds[26h]) == 0
                  and backup_artifact_last_mtime_seconds offset 25h == 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'No dump has ever landed for {{ $labels.app }}'
                  description: >-
                    Nothing on the NAS matches {{ $labels.app }}'s artifact
                    pattern. Either the dump job has never run, or it writes
                    somewhere the collector does not glob.

              # A truncated dump lands with a FRESH mtime, so staleness stays
              # green. The mtime guard splits no file at all (mtime 0) from a
              # real, empty one.
              - alert: BackupArtifactZeroBytes
                expr: >-
                  backup_artifact_last_size_bytes == 0
                  and backup_artifact_last_mtime_seconds > 0
                for: 1h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#backups-and-restore'
                  summary: 'Backup artifact for {{ $labels.app }} landed 0 bytes'
                  description: >-
                    The newest dump for {{ $labels.app }} is 0 bytes with a
                    recent mtime — the run wrote nothing. An empty dump restores
                    nothing; treat it as no backup for that app tonight.
{%- endraw %}
{%- if postgres_operator %}{% raw %}

      platform-databases:
        groups:
          - name: platform.databases
            rules:
              - alert: CNPGPostgresDown
                expr: cnpg_collector_up == 0
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#postgres-down'
                  summary: 'PostgreSQL in {{ $labels.namespace }}/{{ $labels.pod }} is not accepting connections'
                  description: >-
                    The CNPG instance manager reports PostgreSQL down for 5
                    minutes. Applications on this cluster cannot read or write.

              # A failure newer than the newest success means the archive is
              # behind now. A database with no success yet has no archived series,
              # so the failure is compared with zero, joined on the full label set.
              - alert: CNPGWALArchivingFailing
                expr: >-
                  cnpg_pg_stat_archiver_last_failed_time
                  > (cnpg_pg_stat_archiver_last_archived_time
                  or cnpg_pg_stat_archiver_last_failed_time * 0)
                for: 30m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#wal-archiving-failing'
                  summary: 'WAL archiving from {{ $labels.namespace }}/{{ $labels.pod }} has been failing for 30 minutes'
                  description: >-
                    Point-in-time recovery stops at the last archived segment,
                    and WAL accumulates on the instance volume until this clears.

              # As for WAL: no success yet exports no available series, so the
              # failure is compared with zero, joined on the full label set.
              - alert: CNPGBaseBackupFailed
                expr: >-
                  barman_cloud_cloudnative_pg_io_last_failed_backup_timestamp
                  > (barman_cloud_cloudnative_pg_io_last_available_backup_timestamp
                  or barman_cloud_cloudnative_pg_io_last_failed_backup_timestamp * 0)
                for: 15m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#base-backup-failed-or-stale'
                  summary: 'The latest base backup of {{ $labels.namespace }}/{{ $labels.pod }} failed'
                  description: >-
                    A failed base backup is newer than the last good one; the
                    recovery window shrinks every night this repeats.

              # A missing or broken Barman plugin exports no barman_cloud_* series,
              # which silences every base-backup alert. Both exporters
              # share the instance pod's target labels, so the join is per pod.
              - alert: CNPGBackupMetricsAbsent
                expr: >-
                  cnpg_collector_up == 1
                  unless on (namespace, pod)
                  barman_cloud_cloudnative_pg_io_last_available_backup_timestamp
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#backup-metrics-absent'
                  summary: '{{ $labels.namespace }}/{{ $labels.pod }} is up but exports no Barman backup metrics'
                  description: >-
                    The instance reports PostgreSQL up, but no barman_cloud_*
                    series has arrived for 30 minutes, so no base-backup alert can fire.

              # 30h is one nightly cycle plus margin. A timestamp of 0 is no backup
              # ever, which CNPGNeverBackedUp covers; the age alerts skip it.
              - alert: CNPGBaseBackupStale
                expr: >-
                  time() - barman_cloud_cloudnative_pg_io_last_available_backup_timestamp > 108000
                  and barman_cloud_cloudnative_pg_io_last_available_backup_timestamp > 0
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#base-backup-failed-or-stale'
                  summary: 'No base backup of {{ $labels.namespace }}/{{ $labels.pod }} in over 30 hours'
                  description: >-
                    The nightly ScheduledBackup has missed at least one run.

              - alert: CNPGBaseBackupStaleCritical
                expr: >-
                  time() - barman_cloud_cloudnative_pg_io_last_available_backup_timestamp > 194400
                  and barman_cloud_cloudnative_pg_io_last_available_backup_timestamp > 0
                for: 1h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#base-backup-failed-or-stale'
                  summary: 'No base backup of {{ $labels.namespace }}/{{ $labels.pod }} in over 54 hours'
                  description: >-
                    Two nightly base backups in a row are missing; restores now
                    replay more than two days of WAL.

              # Still 0 in every sample for 30h, and reported 30h ago: an instance
              # up that long has missed its first nightly backup.
              - alert: CNPGNeverBackedUp
                expr: >-
                  max by (namespace, pod) (max_over_time(barman_cloud_cloudnative_pg_io_last_available_backup_timestamp[30h])) == 0
                  and on (namespace, pod)
                  count by (namespace, pod) (barman_cloud_cloudnative_pg_io_last_available_backup_timestamp offset 30h)
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/postgres.md#base-backup-failed-or-stale'
                  summary: '{{ $labels.namespace }}/{{ $labels.pod }} has reported for 30 hours without a base backup'
                  description: >-
                    The instance has never completed a base backup, so there is
                    nothing to restore from; the first nightly run was missed.
{%- endraw %}{% endif %}{% raw %}

      platform-host-exporter:
        groups:
          - name: platform.host-exporter
            rules:
              # One host's exporter dying is otherwise invisible: TargetDown needs
              # over 10% of the job down, and every collector-stale rule stops
              # evaluating once its series goes stale.
              - alert: HostExporterDown
                expr: >-
                  up{job="node-exporter-host"} == 0
                  or absent(up{job="node-exporter-host"})
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: 'Host node_exporter {{ $labels.instance }} is down'
                  description: >-
                    Prometheus has not scraped node_exporter on {{
                    $labels.instance }} for 15 minutes, so that host's other
                    alerts stop evaluating.

              # NIC error ratio at 1% for an hour. Both arms stay on [5m]: at a
              # 60s scrape a shorter window lets one missed scrape empty rate().
              - alert: HostNetworkTransmitErrs
                expr: >-
                  rate(node_network_transmit_errs_total{job="node-exporter-host", device=~"(nic|eth|bond)[0-9]+|en[a-z0-9]+"}[5m])
                  / rate(node_network_transmit_packets_total{job="node-exporter-host", device=~"(nic|eth|bond)[0-9]+|en[a-z0-9]+"}[5m])
                  > 0.01
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-network-alerts'
                  summary: 'NIC {{ $labels.device }} on {{ $labels.instance }} is dropping transmits'
                  description: >-
                    {{ $labels.device }} on {{ $labels.instance }} has failed {{
                    $value | humanizePercentage }} of its transmits for an hour.

              - alert: HostNetworkReceiveErrs
                expr: >-
                  rate(node_network_receive_errs_total{job="node-exporter-host", device=~"(nic|eth|bond)[0-9]+|en[a-z0-9]+"}[5m])
                  / rate(node_network_receive_packets_total{job="node-exporter-host", device=~"(nic|eth|bond)[0-9]+|en[a-z0-9]+"}[5m])
                  > 0.01
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-network-alerts'
                  summary: 'NIC {{ $labels.device }} on {{ $labels.instance }} is dropping receives'
                  description: >-
                    {{ $labels.device }} on {{ $labels.instance }} has failed {{
                    $value | humanizePercentage }} of its receives for an hour.

              # At a 60s scrape a 2m window holds three samples and can show at
              # most two changes, so the window is 10m. Over 4 changes is at least
              # three bounces; a clean link event contributes two.
              - alert: HostNetworkInterfaceFlapping
                expr: >-
                  changes(node_network_up{job="node-exporter-host", device=~"(nic|eth|bond)[0-9]+|en[a-z0-9]+"}[10m]) > 4
                for: 2m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-network-alerts'
                  summary: 'NIC {{ $labels.device }} on {{ $labels.instance }} is flapping'
                  description: >-
                    Link state on {{ $labels.device }} on {{ $labels.instance }}
                    changed more than four times in 10 minutes.

              - alert: HostBondingDegraded
                expr: >-
                  (node_bonding_slaves{job="node-exporter-host"} - node_bonding_active{job="node-exporter-host"}) != 0
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-network-alerts'
                  summary: 'Bond {{ $labels.master }} on {{ $labels.instance }} has a failed slave'
                  description: >-
                    {{ $labels.master }} on {{ $labels.instance }} has fewer
                    active slaves than configured, so the host runs without NIC
                    redundancy.

              # node_exporter skips a malformed .prom file. The collector-stale
              # rules only catch a collector that stopped, not one whose output no
              # longer parses while its timer reports success.
              - alert: HostTextfileCollectorScrapeError
                expr: node_textfile_scrape_error{job="node-exporter-host"} == 1
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: 'node_exporter textfile collector is failing on {{ $labels.instance }}'
                  description: >-
                    node_exporter on {{ $labels.instance }} cannot parse a file
                    in its textfile directory, so the alerts reading that file
                    evaluate against nothing.

              # etcd and corosync both fail hard on clock skew.
              - alert: HostClockNotSynchronising
                expr: >-
                  min_over_time(node_timex_sync_status{job="node-exporter-host"}[5m]) == 0
                  and node_timex_maxerror_seconds{job="node-exporter-host"} >= 16
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: 'Clock on {{ $labels.instance }} is not synchronising'
                  description: >-
                    {{ $labels.instance }} has had no NTP sync for 10 minutes
                    and its maximum error has grown past 16s.

              # The post-I/O-error state: everything looks up and nothing writes.
              - alert: HostFilesystemReadOnly
                expr: >-
                  node_filesystem_readonly{job="node-exporter-host", fstype!~"tmpfs|overlay|squashfs|efivarfs|devtmpfs|iso9660"} == 1
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: '{{ $labels.mountpoint }} on {{ $labels.instance }} is mounted read-only'
                  description: >-
                    {{ $labels.mountpoint }} on {{ $labels.instance }} has been
                    read-only for 5 minutes, usually the kernel remounting after
                    an I/O error.

              # The warning floor, which a standing slab leak may inhibit. The
              # critical below is never an inhibit target.
              - alert: HostMemAvailableLow
                expr: >-
                  (node_memory_MemAvailable_bytes{job="node-exporter-host"} / node_memory_MemTotal_bytes{job="node-exporter-host"}) < 0.08
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'Available memory below 8% on {{ $labels.instance }} for 30m'
                  description: >-
                    Only {{ $value | humanizePercentage }} of RAM on {{
                    $labels.instance }} has been available for 30 minutes.

              - alert: HostMemAvailableCritical
                expr: >-
                  (node_memory_MemAvailable_bytes{job="node-exporter-host"} / node_memory_MemTotal_bytes{job="node-exporter-host"}) < 0.02
                for: 15m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'Available memory below 2% on {{ $labels.instance }} for 15m'
                  description: >-
                    Only {{ $value | humanizePercentage }} of RAM on {{
                    $labels.instance }} has been available for 15 minutes, so
                    the kernel is about to swap hard or OOM-kill.

              - alert: HostConntrackEntriesHigh
                expr: >-
                  (node_nf_conntrack_entries{job="node-exporter-host"} / node_nf_conntrack_entries_limit{job="node-exporter-host"}) > 0.75
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: 'conntrack table {{ $value | humanizePercentage }} full on {{ $labels.instance }}'
                  description: >-
                    The connection-tracking table on {{ $labels.instance }} is
                    {{ $value | humanizePercentage }} full, and at 100% new
                    connections are dropped silently.

              # The host exporter is the only node_systemd_* emitter. The gettys
              # restart forever on headless guests, and each other excluded unit
              # owns a *_last_run_success alert that reports the same failure.
              - alert: NodeSystemdServiceFailed
                expr: >-
                  node_systemd_unit_state{job="node-exporter-host", state="failed",
                  name!~"getty@tty1\\.service|serial-getty@ttyS0\\.service",
                  name!~"(archive-backup|restic-offsite|pve-cluster-backup|swap-clean|homelab-cert-check)\\.service"} == 1
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: 'systemd unit {{ $labels.name }} failed on {{ $labels.instance }}'
                  description: >-
                    {{ $labels.name }} has been in the failed state on {{
                    $labels.instance }} for 15 minutes.

              - alert: NodeSystemdServiceCrashlooping
                expr: >-
                  increase(node_systemd_service_restart_total{job="node-exporter-host",
                  name!~"getty@tty1\\.service|serial-getty@ttyS0\\.service"}[5m]) > 2
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: 'systemd unit {{ $labels.name }} is restarting on {{ $labels.instance }}'
                  description: >-
                    {{ $labels.name }} on {{ $labels.instance }} has restarted
                    more than twice in every 5 minutes for 15 minutes.

              # A failing collector still answers HTTP 200 with node_systemd_*
              # absent, so the two rules above cannot fire for that host.
              - alert: NodeExporterSystemdCollectorFailed
                expr: >-
                  node_scrape_collector_success{job="node-exporter-host", collector="systemd"} == 0
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-node-exporter-alerts'
                  summary: "node_exporter's systemd collector is failing on {{ $labels.instance }}"
                  description: >-
                    The systemd collector errors on {{ $labels.instance }}, so
                    NodeSystemdServiceFailed and NodeSystemdServiceCrashlooping
                    are blind there.

              # The witness for EncryptedSwapPlaintextFallback and
              # EncryptedSwapRestoreFailed: finalize writes the gauges at boot, so
              # absence is the signal. The 7d arm keeps unencrypted hosts quiet.
              - alert: EncryptedSwapMetricsMissing
                expr: >-
                  (
                    up{job="node-exporter-host"} == 1
                    unless on (instance) encrypted_swap_finalize_last_run_seconds
                  )
                  and on (instance)
                  (max_over_time(encrypted_swap_finalize_last_run_seconds[7d]) > 0)
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'Encrypted-swap gauges have disappeared on {{ $labels.instance }}'
                  description: >-
                    {{ $labels.instance }} published the encrypted-swap gauges
                    and no longer does, so the encrypted-swap alerts are blind
                    there.

              # Fires on any cache the opt-in slabinfo collector publishes. 6 GiB
              # in 24h is a leak, not a working set settling.
              - alert: HostSlabCacheGrowing
                expr: >-
                  delta(node_slab_object_bytes{job="node-exporter-host"}[24h])
                  > 6 * 1024 * 1024 * 1024
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'Slab cache {{ $labels.cache }} grew {{ $value | humanize1024 }}B in 24h on {{ $labels.instance }}'
                  description: >-
                    The {{ $labels.cache }} slab on {{ $labels.instance }} grew
                    by more than 6 GiB in 24 hours, and only a reboot reclaims
                    leaked kernel memory.

              # The witness for HostSlabCacheGrowing: a failed read, a dead timer,
              # a vanished cache name or a vanished textfile. The last arm needs
              # the collector seen within 7d, so a host without it stays quiet.
              - alert: SlabinfoCollectorDegraded
                expr: >-
                  node_slabinfo_collector_success{job="node-exporter-host"} == 0
                  or (time() - node_slabinfo_collector_last_success_seconds{job="node-exporter-host"}) > 1800
                  or count by (job, instance) (node_slab_cache_present{job="node-exporter-host"} == 0) > 0
                  or (
                    (
                      up{job="node-exporter-host"} == 1
                      unless on (instance) node_slabinfo_collector_success
                    )
                    and on (instance) (max_over_time(node_slabinfo_collector_success[7d]) > 0)
                  )
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'slabinfo collector is not producing usable series on {{ $labels.instance }}'
                  description: >-
                    The slabinfo collector on {{ $labels.instance }} has stopped
                    producing usable series, so HostSlabCacheGrowing is blind
                    there.

      platform-hypervisors:
        groups:
          - name: platform.hypervisors
            rules:
              # The corosync collector runs on every Proxmox host, so its sentinel
              # seen within 7d marks a hypervisor. A dark hypervisor also fires
              # HostExporterDown, which the inhibit in alertmanager-config mutes.
              - alert: ProxmoxHostDown
                expr: >-
                  up{job="node-exporter-host"} == 0
                  and on (instance)
                  (max_over_time(proxmox_corosync_health_collector_last_success_seconds[7d]) > 0)
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'Proxmox host {{ $labels.instance }} is down'
                  description: >-
                    The Proxmox host {{ $labels.instance }} has not answered a
                    scrape for 5 minutes, so its guests are down or failing
                    over.

              # corosync pinned near 100% CPU with the process alive: pmxcfs is
              # frozen while the host and its unit both look healthy. Normal
              # corosync CPU is 1-2%; membership-change spikes end inside 10m.
              - alert: CorosyncWedged
                expr: avg_over_time(proxmox_corosync_cpu_percent[10m]) > 90
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'corosync stuck at high CPU on {{ $labels.instance }}'
                  description: >-
                    corosync on {{ $labels.instance }} has averaged {{ $value |
                    printf "%.1f" }}% CPU over 10 minutes, so pmxcfs replication
                    has likely stopped on this node.

              # The HA manager rewrites /etc/pve/ha/manager_status every few
              # seconds. A deleted file reads mtime 0 and fires; the 7d arm keeps a
              # cluster that never ran HA quiet.
              - alert: PmxcfsStale
                expr: >-
                  time() - proxmox_pmxcfs_manager_status_mtime_seconds > 600
                  and on (instance)
                  (max_over_time(proxmox_pmxcfs_manager_status_mtime_seconds[7d]) > 0)
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'pmxcfs on {{ $labels.instance }} appears stale'
                  description: >-
                    /etc/pve/ha/manager_status on {{ $labels.instance }} has not
                    changed in {{ $value | humanizeDuration }}, so this node's
                    view of the cluster is frozen.

              # Silent when the metric was never written: HostExporterDown covers a
              # dark exporter.
              - alert: CorosyncHealthCollectorStale
                expr: >-
                  time() - proxmox_corosync_health_collector_last_success_seconds > 300
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'corosync-health-collector is degraded on {{ $labels.instance }}'
                  description: >-
                    The corosync health collector on {{ $labels.instance }} has
                    not succeeded in over 5 minutes, so CorosyncWedged and
                    PmxcfsStale read stale inputs there.

              # PSI is the earliest saturation signal on a hypervisor. The 15m
              # hold rides out a nightly backup burst; a real freeze lasts longer.
              - alert: ProxmoxHostIOPressure
                expr: >-
                  rate(node_pressure_io_waiting_seconds_total{job="node-exporter-host"}[5m]) > 0.20
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'Proxmox host {{ $labels.instance }} is I/O-pressure stalled'
                  description: >-
                    {{ $labels.instance }} has spent {{ $value |
                    humanizePercentage }} of the last 5 minutes with tasks
                    stalled on disk I/O.

              - alert: ProxmoxHostMemoryPressure
                expr: >-
                  rate(node_pressure_memory_waiting_seconds_total{job="node-exporter-host"}[5m]) > 0.10
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'Proxmox host {{ $labels.instance }} is under memory-reclaim pressure'
                  description: >-
                    {{ $labels.instance }} has spent {{ $value |
                    humanizePercentage }} of the last 5 minutes with tasks
                    stalled on memory reclaim.

              # Zero threads means nfsd is not serving. The second arm catches a
              # host that served NFS within 7d and no longer reports nfsd at all.
              - alert: NFSServerDown
                expr: >-
                  node_nfsd_server_threads{job="node-exporter-host"} == 0
                  or (
                    (
                      up{job="node-exporter-host"} == 1
                      unless on (instance) node_nfsd_server_threads{job="node-exporter-host"}
                    )
                    and on (instance)
                    (max_over_time(node_nfsd_server_threads{job="node-exporter-host"}[7d]) > 0)
                  )
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#nfs-server-down'
                  summary: 'NFS server on {{ $labels.instance }} is not serving'
                  description: >-
                    nfsd on {{ $labels.instance }} has had no threads, or
                    reported none at all, for 5 minutes, so every NFS-backed PV
                    is stalled.

      platform-cluster-health:
        groups:
          - name: platform.cluster-health
            rules:
              # Past 6h a node outage is an incident, not maintenance churn. The
              # storm-control inhibit never mutes a critical.
              - alert: NodeNotReadyProlonged
                expr: kube_node_status_condition{condition="Ready", status="true"} == 0
                for: 6h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'Node {{ $labels.node }} has been NotReady for over 6 hours'
                  description: >-
                    {{ $labels.node }} has been NotReady for more than 6 hours.

              # Any discovered member down eats into etcd's fault tolerance, and
              # upstream's etcdInsufficientMembers fires only once quorum is gone.
              # absent() covers the whole job being down.
              - alert: EtcdQuorumAtRisk
                expr: >-
                  count(up{job="kube-etcd"} == 1) < count(up{job="kube-etcd"})
                  or absent(up{job="kube-etcd"} == 1)
                for: 6h
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hypervisor-and-cluster-alerts'
                  summary: 'k3s etcd has been running a member short for 6h'
                  description: >-
                    At least one etcd member has been unreachable for 6 hours,
                    so every further server loss brings the cluster closer to
                    losing quorum.

      platform-temperature:
        groups:
          - name: platform.temperature
            rules:
              # hwmon from the hypervisors only: an LXC reads its host's sensors,
              # so an unscoped rule pages twice for one sensor. The corosync
              # sentinel marks a hypervisor.
              - alert: SATADriveTempWarning
                expr: >-
                  max by (instance, chip) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"drivetemp.*"}
                  ) >= 50
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 15m
                labels:
                  severity: warning
                  component: storage
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'SATA drive {{ $labels.chip }} on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    SATA drive {{ $labels.chip }} on {{ $labels.instance }} has
                    been at {{ $value | printf "%.0f" }}C for 15 minutes,
                    against a 50C warning.

              - alert: SATADriveTempCritical
                expr: >-
                  max by (instance, chip) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"drivetemp.*"}
                  ) >= 55
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 5m
                labels:
                  severity: critical
                  component: storage
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'SATA drive {{ $labels.chip }} on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    SATA drive {{ $labels.chip }} on {{ $labels.instance }} is
                    at {{ $value | printf "%.0f" }}C, the common HDD ceiling.

              # A two-step NVMe ladder: the 75-80C band is null-routed, and 80C
              # is where the drives start throttling.
              - alert: NVMeDriveTempHigh
                expr: >-
                  max by (instance, chip) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name="nvme"}
                  ) >= 75
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 10m
                labels:
                  severity: none
                  component: storage
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'NVMe drive {{ $labels.chip }} on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    NVMe drive {{ $labels.chip }} on {{ $labels.instance }} has
                    been at {{ $value | printf "%.0f" }}C for 10 minutes, below
                    the 80C throttle point.

              - alert: NVMeDriveTempCritical
                expr: >-
                  max by (instance, chip) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name="nvme"}
                  ) >= 80
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 2m
                labels:
                  severity: critical
                  component: storage
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'NVMe drive {{ $labels.chip }} on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    NVMe drive {{ $labels.chip }} on {{ $labels.instance }} is at
                    {{ $value | printf "%.0f" }}C, the thermal-throttle point where
                    the drive slows itself to shed heat.

              # coretemp is Intel, k10temp AMD. Desktop CPUs spike toward TJunction
              # under load, so the thresholds and holds target sustained heat.
              - alert: CPUTempWarning
                expr: >-
                  max by (instance) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"coretemp|k10temp"}
                  ) >= 90
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 15m
                labels:
                  severity: warning
                  component: cpu
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'CPU on {{ $labels.instance }} sustained {{ $value | printf "%.0f" }}C'
                  description: >-
                    CPU on {{ $labels.instance }} has been at or above 90C for
                    15 minutes.

              - alert: CPUTempCritical
                expr: >-
                  max by (instance) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"coretemp|k10temp"}
                  ) >= 95
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 5m
                labels:
                  severity: critical
                  component: cpu
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'CPU on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    CPU on {{ $labels.instance }} hit {{ $value | printf "%.0f"
                    }}C, close to TJunction, so thermal throttling is imminent.

              # Host-side hwmon GPU sensors. A passed-through GPU reports from
              # its guest instead, through the DCGM exporter where one is deployed.
              - alert: HostGpuTempWarning
                expr: >-
                  max by (instance, chip_name) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"xe|i915|nouveau|nvidia|amdgpu|radeon"}
                  ) >= 85
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 5m
                labels:
                  severity: warning
                  component: gpu
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'GPU ({{ $labels.chip_name }}) on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    GPU ({{ $labels.chip_name }}) on {{ $labels.instance }} has been
                    at or above 85C for 5 minutes.

              - alert: HostGpuTempCritical
                expr: >-
                  max by (instance, chip_name) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"xe|i915|nouveau|nvidia|amdgpu|radeon"}
                  ) >= 95
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 1m
                labels:
                  severity: critical
                  component: gpu
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'GPU ({{ $labels.chip_name }}) on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    GPU ({{ $labels.chip_name }}) on {{ $labels.instance }} is at
                    {{ $value | printf "%.0f" }}C, near the usual thermal-shutdown
                    point for consumer GPUs.

              # Fires only where node_exporter publishes a NIC sensor chip.
              - alert: NICTempWarning
                expr: >-
                  max by (instance, chip_name) (
                    node_hwmon_temp_celsius{job="node-exporter-host"}
                    * on (instance, chip) group_left(chip_name)
                    node_hwmon_chip_names{job="node-exporter-host", chip_name=~"nic.*"}
                  ) >= 90
                  and on (instance) proxmox_corosync_health_collector_last_success_seconds
                for: 10m
                labels:
                  severity: warning
                  component: network
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#hardware-temperature-alerts'
                  summary: 'NIC on {{ $labels.instance }} at {{ $value | printf "%.0f" }}C'
                  description: >-
                    NIC {{ $labels.chip_name }} on {{ $labels.instance }} has
                    been at or above 90C for 10 minutes.

      platform-resolvers:
        groups:
          - name: platform.resolvers
            rules:
              # unbound_up is the exporter's verdict on the control socket, so it
              # separates a dead resolver from a dead exporter. One resolver down
              # is a warning while the others still recurse.
              - alert: UnboundDown
                expr: unbound_up{job="unbound-exporter"} == 0
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#recursive-resolver-alerts'
                  summary: 'Unbound is not answering the exporter on {{ $labels.instance }}'
                  description: >-
                    unbound_exporter on {{ $labels.instance }} has not been able
                    to read Unbound's control socket for 5 minutes, so that
                    resolver cannot recurse.

              # A dead exporter otherwise looks healthy: unbound_up just stops
              # existing. The EndpointSlice is cluster-config's resolver roster.
              - alert: UnboundExporterDown
                expr: >-
                  up{job="unbound-exporter"} == 0
                  or absent(up{job="unbound-exporter"} == 1)
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#recursive-resolver-alerts'
                  summary: 'unbound_exporter is not being scraped on {{ $labels.instance }}'
                  description: >-
                    Prometheus has not scraped unbound_exporter on a resolver
                    for 15 minutes, so the Unbound alerts are blind there.

              # nodata is a subset of NOERROR, so it leaves the denominator. The
              # -1 arm fires where Unbound answers the exporter but exports no
              # rcode counters, which needs extended-statistics on.
              - alert: UnboundSERVFAILRatioHigh
                expr: >-
                  (
                    sum by (instance) (rate(unbound_answer_rcodes_total{job="unbound-exporter", rcode="SERVFAIL"}[15m]))
                    / sum by (instance) (rate(unbound_answer_rcodes_total{job="unbound-exporter", rcode!="nodata"}[15m]))
                    > 0.05
                  )
                  or
                  (
                    -1 * count by (instance) (unbound_up{job="unbound-exporter"} == 1)
                    unless on (instance)
                    count by (instance) (unbound_answer_rcodes_total{job="unbound-exporter"})
                  )
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#recursive-resolver-alerts'
                  summary: >-
                    {{ if lt $value 0.0 }}Unbound on {{ $labels.instance }} exports no rcode counters{{ else }}Unbound on {{ $labels.instance }} is answering {{ $value | humanizePercentage }} SERVFAIL{{ end }}
                  description: >-
                    {{ if lt $value 0.0 }}Unbound on {{ $labels.instance }}
                    exports no unbound_answer_rcodes_total, so the SERVFAIL
                    ratio cannot be measured.{{ else }}More than 5% of Unbound's
                    answers on {{ $labels.instance }} were SERVFAIL for 15
                    minutes.{{ end }}


      platform-mail:
        groups:
          - name: platform.mail
            rules:
              # A wedged upstream hop queues mail silently while the relay and
              # postfix both stay up, so only the queue depth shows the break.
              - alert: PostfixQueueBacklog
                expr: postfix_queue_depth > 5
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#mail-relay'
                  summary: 'Postfix queue backing up on {{ $labels.instance }}'
                  description: >-
                    The relay on {{ $labels.instance }} has held more than 5
                    queued messages for 30 minutes, so the upstream hop is
                    likely refusing it.

              - alert: PostfixDown
                expr: postfix_up == 0
                for: 10m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#mail-relay'
                  summary: 'Postfix is not active on {{ $labels.instance }}'
                  description: >-
                    postfix has been down on the relay for 10 minutes, so alert
                    email and host notifications are not leaving the cluster.

              # The absent() arm makes an undeployed collector loud, so the two
              # rules above never read stale inputs unnoticed.
              - alert: PostfixQueueCollectorStale
                expr: >-
                  (time() - postfix_queue_collector_last_success_seconds > 900)
                  or absent(postfix_queue_collector_last_success_seconds)
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#mail-relay'
                  summary: 'postfix-queue collector is degraded or missing on the relay'
                  description: >-
                    The postfix-queue collector has not succeeded in 15 minutes
                    or has never run, so the Postfix alerts read stale or no
                    inputs.

      platform-self-monitoring:
        groups:
          - name: platform.self-monitoring
            rules:
              # Loki runs one replica and senders do not buffer, so a sustained
              # 5xx rate on push or query loses logs silently.
              - alert: LokiRequestFailures
                expr: >-
                  sum(rate(loki_request_duration_seconds_count{status_code=~"5..",
                  job="observability/loki"}[5m]))
                  /
                  sum(rate(loki_request_duration_seconds_count{job="observability/loki"}[5m]))
                  > 0.05
                  and sum(rate(loki_request_duration_seconds_count{job="observability/loki"}[5m])) > 0
                for: 15m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: 'Loki is returning 5xx on more than 5% of requests'
                  description: >-
                    Loki is serving HTTP 5xx on {{ $value | humanizePercentage
                    }} of requests, and senders do not buffer.

              # A drop rate under the critical rule's 1%-for-15m is otherwise
              # invisible. Exempted from InfoInhibitor: it carries no namespace.
              - alert: AlertmanagerNotificationsDropping
                expr: >-
                  sum by (integration) (
                    increase(alertmanager_notifications_failed_total{job="kube-prometheus-stack-alertmanager",
                    container="alertmanager", namespace="observability"}[6h])
                  ) > 0
                for: 1h
                labels:
                  severity: info
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#where-to-look-first'
                  summary: '{{ $value | printf "%.0f" }} notifications to {{ $labels.integration }} failed in the last 6h'
                  description: >-
                    Alertmanager dropped notifications on {{ $labels.integration
                    }} over 6 hours without crossing the ratio that pages.
{%- endraw %}
{%- if storage_backend == 'zfs' %}{% raw %}

      platform-zfs-capacity:
        groups:
          - name: platform.zfs-capacity
            rules:
              # node_filesystem math cannot stand in for a pool: a dataset shrinks
              # as zvols fill the pool, so DiskUsage* stays low on a nearly full
              # pool. Pools share names across hosts, so the inhibit keys on both.
              - alert: ZFSPoolSpaceWarning
                expr: (zfs_pool_status_allocated_bytes / zfs_pool_status_size_bytes) * 100 > 80
                for: 10m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#zfs-pool-capacity'
                  summary: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} above 80% capacity'
                  description: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} is at {{ $value | printf "%.1f" }}% capacity.'

              - alert: ZFSPoolSpaceCritical
                expr: (zfs_pool_status_allocated_bytes / zfs_pool_status_size_bytes) * 100 > 90
                for: 5m
                labels:
                  severity: critical
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#zfs-pool-capacity'
                  summary: 'ZFS pool {{ $labels.pool }} on {{ $labels.instance }} above 90% capacity'
                  description: >-
                    ZFS pool {{ $labels.pool }} on {{ $labels.instance }} is at
                    {{ $value | printf "%.1f" }}% capacity, where ZFS slows
                    sharply.

              # The corosync sentinel witnesses a hypervisor whose pool collector
              # never wrote. The success arm catches a collector publishing no
              # pools; its 7d guard keeps a pool-less host quiet.
              - alert: ZFSPoolCollectorStale
                expr: >-
                  (time() - zfs_pool_status_collector_last_success_seconds > 900)
                  or on (instance) (
                    proxmox_corosync_health_collector_last_success_seconds
                    unless on (instance) zfs_pool_status_collector_last_success_seconds
                  )
                  or (
                    zfs_pool_status_collector_success == 0
                    and on (instance) (
                      max_over_time(zfs_pool_status_collector_success[7d]) > 0
                    )
                  )
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#zfs-pool-capacity'
                  summary: 'zpool-status-collector is degraded or missing on {{ $labels.instance }}'
                  description: >-
                    The pool collector on {{ $labels.instance }} is stale, has
                    never written, or reports no pool, so the ZFS pool alerts
                    read stale or no inputs.

              # SUnreclaim minus ARC: nearly all legitimate unreclaimable slab on
              # a ZFS host is the ARC, so the remainder is the leak. 16 GiB for
              # 24h is early enough to schedule the reboot window.
              - alert: HostSlabLeakSuspected
                expr: >-
                  (node_memory_SUnreclaim_bytes{job="node-exporter-host"} - node_zfs_arc_size{job="node-exporter-host"}) > 16 * 1024 * 1024 * 1024
                for: 24h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'Unreclaimable slab far above ARC on {{ $labels.instance }}'
                  description: >-
                    SUnreclaim on {{ $labels.instance }} has exceeded the ARC by
                    {{ $value | humanize1024 }}B for 24 hours, and only a reboot
                    reclaims it.

              # Swap that never dropped below 2 GiB across two nightly cycles: the
              # reset keeps aborting. Scoped to the hosts that run swap-clean.
              - alert: NASSwapNotClearing
                expr: >-
                  min_over_time(
                    (node_memory_SwapTotal_bytes{job="node-exporter-host"}
                    - node_memory_SwapFree_bytes{job="node-exporter-host"})[2d:30m]
                  ) > 2 * 1024 * 1024 * 1024
                  and on (instance) swap_clean_last_run_success
                for: 1h
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'Swap not clearing: above 2 GiB for 2 days on {{ $labels.instance }}'
                  description: >-
                    Swap on {{ $labels.instance }} has stayed above 2 GiB for 2
                    days, so swap-clean is aborting for lack of headroom.

              # No swap has no usage to accumulate, so the rule above cannot see
              # it. Defers to EncryptedSwapRestoreFailed where that gauge exists.
              - alert: NASSwapGone
                expr: >-
                  node_memory_SwapTotal_bytes{job="node-exporter-host"} == 0
                  and on (instance) swap_clean_last_run_success
                  unless on (instance) encrypted_swap_any_swap_active
                for: 30m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'No swap configured on {{ $labels.instance }}'
                  description: >-
                    {{ $labels.instance }} reports no swap while it runs
                    swap-clean, so the host has no safety margin.

              # A guest swap-clean stopped did not come back. The gauge is rewritten
              # every run, so the guest's own alerts are the persistent signal.
              - alert: SwapCleanGuestRestartFailed
                expr: swap_clean_guest_restart_failures > 0
                for: 5m
                labels:
                  severity: warning
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'swap-clean failed to restart a stopped guest on {{ $labels.instance }}'
                  description: >-
                    swap-clean stopped {{ $value | printf "%.0f" }} guest(s) on
                    {{ $labels.instance }} that did not restart.

              # A notice: ARC shrink alone no longer covers the swap. Exempted
              # from InfoInhibitor by name; [6h] keeps it from latching.
              - alert: SwapCleanStoppedGuests
                expr: max_over_time(swap_clean_guests_stopped_count[6h]) > 0
                for: 5m
                labels:
                  severity: info
                annotations:
                  runbook_url: '${cluster_runbook_base_url}/RUNBOOKS.md#host-memory-and-slab-alerts'
                  summary: 'swap-clean stopped guests to reclaim swap on {{ $labels.instance }}'
                  description: >-
                    swap-clean stopped and restarted {{ $value | printf "%.0f"
                    }} guest(s) in the last 6 hours to free RAM, so the host is
                    short on RAM.
{%- endraw %}{% endif %}
