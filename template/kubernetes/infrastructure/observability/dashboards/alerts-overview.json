        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(prometheus_notifications_alertmanagers_discovered)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Notify drops (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Notifications Prometheus dropped because they couldn't be sent to Alertmanager.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(prometheus_notifications_dropped_total[5m])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ]
