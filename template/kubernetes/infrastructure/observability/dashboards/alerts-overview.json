    {
      "type": "row",
      "id": 101,
      "title": "Currently firing",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Firing alerts",
      "description": "Every alert currently in firing state. Sorted by severity then start time.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 6 },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" },
        "sortBy": [{ "displayName": "Severity", "desc": true }, { "displayName": "Started", "desc": false }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "color": "red", "index": 0, "text": "critical" } } },
                  { "type": "value", "options": { "warning": { "color": "yellow", "index": 1, "text": "warning" } } },
                  { "type": "value", "options": { "info": { "color": "blue", "index": 2, "text": "info" } } },
                  { "type": "value", "options": { "none": { "color": "gray", "index": 3, "text": "none" } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Started" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Alert" },
            "properties": [{ "id": "custom.width", "value": 260 }]
          },
          {
            "matcher": { "id": "byName", "options": "Instance" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          },
          {
            "matcher": { "id": "byName", "options": "Namespace" },
            "properties": [{ "id": "custom.width", "value": 140 }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ALERTS_FOR_STATE and ignoring(alertstate) (ALERTS{alertstate=\"firing\"} == 1)",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "endpoint": true,
              "service": true,
              "container": true,
              "pod": true,
              "prometheus": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "Value": 2,
              "namespace": 3,
              "instance": 4,
              "job": 5
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "Value": "Started",
              "namespace": "Namespace",
              "instance": "Instance",
              "job": "Job"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Pending and silenced",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Pending alerts",
      "description": "Alerts that have triggered but haven't met their `for:` duration yet.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "ALERTS{alertstate=\"pending\"}",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "endpoint": true,
              "service": true,
              "container": true,
              "pod": true,
              "prometheus": true,
              "Value": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "namespace": 2,
              "instance": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "namespace": "Namespace",
              "instance": "Instance"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Active silences (Alertmanager)",
      "description": "Total count of active silences per Alertmanager replica. View or edit at /alerting/silences (Grafana alerting UI).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "filterable": false }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "alertmanager_silences{state=\"active\"}",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "service": true,
              "container": true,
              "pod": true,
              "prometheus": true,
              "namespace": true
            },
            "indexByName": {
              "instance": 0,
              "state": 1,
              "Value": 2
            },
            "renameByName": {
              "instance": "Alertmanager",
              "state": "State",
              "Value": "Active silences"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 103,
      "title": "Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Firing alerts over time, by severity",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 60,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (severity) (ALERTS{alertstate=\"firing\"})",
          "refId": "A",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Most-fired alerts (last 7d)",
      "description": "Top alerts by total time spent firing in the past 7 days. count_over_time samples are multiplied by 30 (the Prometheus evaluation interval in seconds); the factor must track that interval.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 28 },
      "options": {
        "showHeader": true,
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total firing time" },
            "properties": [
              { "id": "unit", "value": "dtdurations" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 3600 },
                    { "color": "red", "value": 86400 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(15, sum by (alertname, severity) (count_over_time(ALERTS{alertstate=\"firing\"}[7d])) * 30)",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "Value": 2
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "Value": "Total firing time"
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 104,
      "title": "Alertmanager health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 30,
      "type": "stat",
      "title": "Alertmanagers reachable",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Number of Alertmanager instances Prometheus has discovered and is sending to.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
