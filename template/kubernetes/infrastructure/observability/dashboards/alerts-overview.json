      "title": "AM notify failures (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Outbound notification failures from Alertmanager to integrations (Discord, etc).",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short",
          "noValue": "0"
        }
      },
      "options": {
