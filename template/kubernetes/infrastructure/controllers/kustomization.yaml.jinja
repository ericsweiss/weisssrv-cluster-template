---
# metrics-server/ is NOT listed here: its own Flux Kustomization
# (clusters/<name>/infrastructure-metrics-server.yaml) reconciles it, so its
# wait cannot freeze this stage and the two prunes never share an object.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - external-secrets
  - metallb
  - cert-manager
  - traefik
  - external-dns
  - vpa
  - kured
  - reloader
{%- if secrets_backend == 'onepassword' %}
  - onepassword-connect
{%- endif %}
{%- if vpn_tailscale %}
  - tailscale-operator
{%- endif %}
{%- if gpu == 'nvidia' %}
  - nvidia-device-plugin
{%- endif %}
{%- if tenant_storage %}
  - local-path-provisioner
{%- endif %}
{%- if postgres_operator %}
  - cnpg
{%- endif %}
