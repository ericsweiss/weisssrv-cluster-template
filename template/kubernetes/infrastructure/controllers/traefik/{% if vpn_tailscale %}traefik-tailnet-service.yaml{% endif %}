---
# Third Service selecting the same Traefik pods, exposed as a tailnet device by
# the Tailscale operator: one Service cannot be both MetalLB and tailscale. Plain
# TCP passthrough, so SNI and Host survive and Traefik terminates the cert.
apiVersion: v1
kind: Service
metadata:
  name: traefik-tailnet
  namespace: traefik
  annotations:
    tailscale.com/hostname: "traefik-tailnet"
    # Sizes the operator-created proxy pod (its chart default request is ~1Mi
    # against a ~55Mi working set) — see tailscale-operator/proxyclass.yaml.
    tailscale.com/proxy-class: default-proxyclass
spec:
  type: LoadBalancer
  loadBalancerClass: tailscale
  selector:
    app.kubernetes.io/name: traefik
    app.kubernetes.io/instance: traefik-traefik
  ports:
    - name: web
      port: 80
      targetPort: web
      protocol: TCP
    - name: websecure
      port: 443
      targetPort: websecure
      protocol: TCP
