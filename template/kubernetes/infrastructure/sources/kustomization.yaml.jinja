---
# Earliest-reconciling stage: HelmRepository sources plus the two ConfigMaps
# every later stage substitutes from. They live here because they MUST exist
# before controllers/ renders HelmReleases carrying ${...} placeholders.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - external-secrets.yaml
  - metallb.yaml
  - jetstack.yaml
  - traefik.yaml
  - external-dns.yaml
  - authentik.yaml
  - prometheus-community.yaml
  - grafana.yaml
  - grafana-community.yaml
  - fairwinds.yaml
  - kured.yaml
  - stakater.yaml
{%- if git_backend == 'gitlab_selfhosted' %}
  - gitlab.yaml
{%- endif %}
{%- if secrets_backend == 'onepassword' %}
  - onepassword-connect.yaml
{%- endif %}
{%- if vpn_tailscale %}
  - tailscale.yaml
{%- endif %}
{%- if gpu == 'nvidia' %}
  - nvidia.yaml
{%- endif %}
  - versions-configmap.yaml
  - cluster-config.yaml
