---
# Earliest-reconciling stage: HelmRepository sources, the two substitution
# ConfigMaps and the PriorityClasses, all of which must exist before
# controllers/ renders. Ordering rationale: kubernetes/README.md.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
# HelmRepositories alphabetically, so a new source has an obvious insertion
# point; the cluster-wide documents follow as a marked block.
resources:
  - authentik.yaml
  - external-dns.yaml
  - external-secrets.yaml
  - fairwinds-stable.yaml
  - grafana-community.yaml
  - grafana.yaml
  - jetstack.yaml
  - kured.yaml
  - metallb.yaml
  - prometheus-community.yaml
  - stakater.yaml
  - traefik.yaml
{%- if git_backend == 'gitlab_selfhosted' %}
  - gitlab.yaml
{%- endif %}
{%- if gpu == 'nvidia' %}
  - nvidia.yaml
{%- endif %}
{%- if secrets_backend == 'onepassword' %}
  - onepassword-connect.yaml
{%- endif %}
{%- if vpn_tailscale %}
  - tailscale.yaml
{%- endif %}
  # Not HelmRepositories: cluster identity, versions and the priority classes.
  - cluster-config.yaml
  - priorityclasses.yaml
  - versions-configmap.yaml
