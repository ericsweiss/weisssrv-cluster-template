---
{%- set n_compute = compute_node_count | default(2) | int %}
{%- set resolvers = upstream_dns_servers.split() %}
{%- set pve_hosts = [nas_host.split('.')[0]] %}
{%- for i in range(1, n_compute + 1) %}
{%- set _ = pve_hosts.append('pve-node-%02d' | format(i)) %}
{%- endfor %}
{%- set n_srv = 3 if pve_hosts | length >= 3 else 1 %}
# Cluster identity, addressing and backend names for Flux postBuild
# substitution — the sibling of cluster-versions. Every stage after sources
# substitutes from BOTH, which is why no manifest under kubernetes/ contains a
# literal domain, VIP or CIDR.
#
# Filled once by copier from the answers file; regenerate it from the Ansible
# inventory later if you prefer (keep the key names either way — they are a
# contract with every manifest in this tree). Renaming a key does NOT fail the
# build: Flux and envsubst both render an unknown ${placeholder} as an EMPTY
# STRING. `tests/test_cluster_invariants.py` is what catches that.
#
# Key names must match the Flux postBuild identifier grammar
# [A-Za-z_][A-Za-z0-9_]* and must not collide with a cluster-versions key.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-config
  namespace: flux-system
data:
  cluster_name: "{{ cluster_name }}"

  # Split-horizon DNS: internal names resolve on the LAN/tailnet only; external
  # names are published to the public zone.
  cluster_internal_domain: "{{ internal_domain }}"
  cluster_external_domain: "{{ external_domain }}"

  # Prefix for node role labels and taints (<prefix>/ingress, <prefix>/gpu,
  # <prefix>/nas, ...). The Ansible k3s layer MUST label nodes with this same
  # prefix or the affinity rules below never match.
  cluster_node_label_domain: "{{ internal_domain }}"

  cluster_lan_cidr: "{{ lan_cidr }}"
  cluster_pod_cidr: "{{ k3s_pod_cidr | default('10.42.0.0/16') }}"
  cluster_service_cidr: "{{ k3s_service_cidr | default('10.43.0.0/16') }}"
  # CGNAT range (RFC 6598) that Tailscale allocates from — a constant, kept here
  # so ingress allowlists stay declarative.
  cluster_tailnet_cidr: "100.64.0.0/10"

  # `cluster_api_vip` is what the manifests read; `cluster_k3s_api_vip` is the
  # reserved longer spelling, kept so a manifest written with the k3s_ segment
  # resolves rather than substituting to an empty string.
  cluster_api_vip: "{{ k3s_api_vip }}"
  cluster_k3s_api_vip: "{{ k3s_api_vip }}"
  # Pod egress to the apiserver must allow the SERVER NODE IPs, not the VIP:
  # kube-proxy DNATs the in-cluster API VIP before NetworkPolicy evaluation.
  # Widened to the LAN because the server roster is inventory data rather than a
  # copier answer — narrow it to the server /32s if you generate this file from
  # the inventory.
  cluster_apiserver_egress_cidr: "{{ lan_cidr }}"

  # etcd scrape targets for kube-prometheus-stack's kubeEtcd component (k3s
  # serves etcd metrics on :2381 with `etcd-expose-metrics`, which the k3s role
  # sets on every server). Enabling that component is also what enables the
  # UPSTREAM etcd alert rules — quorum loss, leader flapping, DB growth, fsync
  # latency — on the one component whose failure loses the cluster.
  #
  # A JSON FLOW SEQUENCE, not a plain string, and that is load-bearing: Helm
  # needs a real YAML list, while Flux postBuild (and envsubst) substitute TEXT.
  # Inlined as `endpoints: ${cluster_etcd_endpoints}` this parses as a list; a
  # space-separated string would silently become a single bogus endpoint.
  #
  # Seeded from the k3s server addresses the starter inventory generates.
  # RE-ADDRESS THE SERVERS AND CHANGE THIS TOO — stale entries surface as
  # etcd targets that are permanently down, not as silence.
  cluster_etcd_endpoints: '[{% for j in range(1, n_srv + 1) %}"{{ lan_prefix }}.{{ 30 + j }}"{{ ", " if not loop.last }}{% endfor %}]'

  # Scrape targets for the HOST node-exporters (port 9101, the `node_exporter_host`
  # role) — the machines the in-cluster DaemonSet cannot see. Consumed by
  # observability/exporters/node-exporter-host.yaml as the `endpoints:` list of a
  # hand-written EndpointSlice, so this is the same JSON FLOW SEQUENCE trick as
  # cluster_etcd_endpoints: a real YAML list is required where Flux only
  # substitutes text. `conditions.ready` is explicit — a slice with no controller
  # behind it has nobody to fill it in, and Prometheus skips a not-ready address.
  #
  # Seeded from the starter inventory's roster: the bare-metal hosts, the
  # resolver and relay LXCs, and the k3s servers. The k3s AGENTS are
  # deliberately absent — the in-cluster DaemonSet already scrapes them on 9100,
  # so listing them here would produce two series per agent under different
  # jobs. Add an app VM when it grows a textfile collector worth alerting on.
  cluster_node_exporter_host_addresses: '[{% for host in pve_hosts %}{"addresses": ["{{ lan_prefix }}.{{ 11 + loop.index0 }}"], "conditions": {"ready": true}}, {% endfor %}{% for addr in resolvers %}{"addresses": ["{{ addr }}"], "conditions": {"ready": true}}, {% endfor %}{"addresses": ["{{ lan_prefix }}.23"], "conditions": {"ready": true}}{% for j in range(1, n_srv + 1) %}, {"addresses": ["{{ lan_prefix }}.{{ 30 + j }}"], "conditions": {"ready": true}}{% endfor %}]'
{%- if storage_backend | default('zfs') == 'zfs' %}

  # Scrape targets for zfs_exporter (port 9134, the `zfs_exporter` role), which
  # the storage playbook installs on the NAS node. Same EndpointSlice flow
  # sequence as the roster above. Extend it if you run ZFS on more than the NAS.
  cluster_zfs_exporter_addresses: '[{"addresses": ["{{ lan_prefix }}.11"], "conditions": {"ready": true}}]'
{%- endif %}

  # Scrape targets for unbound_exporter (port 9167, the `unbound_exporter` role),
  # one per resolver the DNS playbook builds. Prometheus derives
  # instance=<ip>:9167 per address, so the two resolvers stay distinguishable
  # from a single Service.
  cluster_unbound_exporter_addresses: '[{% for addr in resolvers %}{"addresses": ["{{ addr }}"], "conditions": {"ready": true}}{{ ", " if not loop.last }}{% endfor %}]'

  # Gate for OffsiteBackupStale's absent() arm — a METRIC NAME, not a boolean,
  # because Flux substitutes text and `${...}` is only valid PromQL inside a
  # quoted string. "up" is the OFF position (always has series, so the arm can
  # never fire); set it to restic_offsite_last_success_timestamp_seconds in the
  # SAME change that flips `restic_offsite_enabled` true.
  cluster_offsite_backup_probe_metric: "up"

  cluster_metallb_public_vip: "{{ metallb_public_vip }}"
  cluster_metallb_internal_vip: "{{ metallb_internal_vip }}"

  # cert-manager
  cluster_issuer: "letsencrypt-prod"
  cluster_acme_email: "{{ admin_email }}"

  # Secrets backend: the ClusterSecretStore every ExternalSecret references. The
  # else-branch subscripts an empty mapping to hand `mandatory` an undefined
  # value, the same seam the Taskfile's secret_ref() macro uses: an unimplemented
  # backend FAILS THE RENDER instead of emitting an empty store name, which every
  # ExternalSecret would then reference as `name: ""`.
  cluster_secret_store: "{{ 'onepassword-cluster' if secrets_backend == 'onepassword' else {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no ClusterSecretStore — add a branch to cluster_secret_store in cluster-config.yaml.jinja') }}"
{%- if secrets_backend == 'onepassword' %}
  cluster_secrets_vault: "{{ onepassword_vault }}"
{%- endif %}

  cluster_git_host: "{{ git_host }}"
  # Prefix every alert's runbook_url gets. The repository is named cluster_name
  # (see copier.yml's git_namespace help) — the same composition the Taskfile's
  # flux bootstrap target and Terraform state project use, so a 3am alert link
  # and the repo Flux actually reconciles from can never drift apart.
  cluster_runbook_base_url: "https://{{ git_host }}/{{ git_namespace }}/{{ cluster_name }}/-/blob/main/docs"

  # Host-side services the platform talks to. These come from the copier ANSWERS
  # (nas_host, smtp_host, upstream_dns_servers), which also drive the Ansible
  # inventory — to move the NAS, the relay or a resolver, change the answer, or
  # change this file and hosts.yml together. Editing one alone splits the two
  # layers apart silently.
  cluster_nas_host: "{{ nas_host | default('pve-nas-01.' ~ internal_domain) }}"
  cluster_smtp_host: "{{ smtp_host | default('smtp-relay.' ~ internal_domain) }}"
  cluster_alert_email: "{{ alert_email | default(admin_email) }}"
  # LAN resolvers the in-cluster forwarders point at, space-separated — one per
  # address in the upstream_dns_servers answer.
  cluster_upstream_dns_servers: "{{ upstream_dns_servers | default(lan_prefix ~ '.21 ' ~ lan_prefix ~ '.22') }}"
  # Alternation of every Prometheus job the host/DaemonSet node-exporters
  # register under. Add labels, never replace them (copier.yml
  # node_exporter_job_regex).
  # The fallback must stay equal to copier.yml's default. `node-exporter` alone
  # is the value that validator exists to REJECT: dropping node-exporter-host
  # leaves every host rule matching zero series, and a rule that matches nothing
  # never fires — the one failure mode here that is completely silent.
  cluster_node_exporter_job_regex: "{{ node_exporter_job_regex | default('node-exporter|node-exporter-host') }}"
{%- if vpn_tailscale %}

  # MagicDNS suffix of your tailnet, from the Tailscale admin console DNS page.
  # The tailnet resolver hands out CNAMEs into it, so a wrong value silently
  # breaks remote access to internal names.
  cluster_tailnet_dns_suffix: "{{ tailnet_dns_suffix | default('CHANGEME.ts.net') }}"
{%- endif %}
{%- if dns_backend == 'cloudflare' %}

  # Records the DDNS CronJob keeps pointed at the current public IPv4.
  # Comma-separated "<name>:<proxied-on-create>"; add hostnames that must bypass
  # the Cloudflare proxy (large uploads, non-HTTP ports) as ":false".
  cluster_ddns_records: "{{ external_domain }}:true"
{%- endif %}
