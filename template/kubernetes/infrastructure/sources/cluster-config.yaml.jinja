---
{%- from "partials/roster.jinja" import resolvers, pve_hosts, k3s_server_ips with context %}
# Cluster identity, addressing and backend names for Flux postBuild substitution;
# every stage after sources substitutes from this and cluster-versions. Keys are a
# contract: StrictPostBuildSubstitutions fails the reconcile on an unknown one.

# The set is a deliberate SUPERSET of the reference cluster's: the rosters, probe
# gates and backend names below exist because a generated cluster is configured
# by answer rather than by hand. kubernetes/README.md tabulates every key.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-config
  namespace: flux-system
data:
  cluster_name: "{{ cluster_name }}"

  # Split-horizon DNS: internal names resolve on the LAN/tailnet only; external
  # names are published to the public zone.
  cluster_internal_domain: "{{ internal_domain }}"
  cluster_external_domain: "{{ external_domain }}"

  # Prefix for node role labels and taints (<prefix>/ingress, <prefix>/gpu,
  # <prefix>/nas, ...). The Ansible k3s layer MUST label nodes with this same
  # prefix or the affinity rules below never match.
  cluster_node_label_domain: "{{ internal_domain }}"

  cluster_lan_cidr: "{{ lan_cidr }}"
  # Default gateway on the LAN, mirroring the `lan_gateway` inventory variable.
  # A probe or an allowlist naming the router reads this, never a literal.
  cluster_lan_gateway: "{{ lan_gateway }}"
  cluster_pod_cidr: "{{ k3s_pod_cidr }}"
  cluster_service_cidr: "{{ k3s_service_cidr }}"

  # `cluster_api_vip` is what the manifests read; `cluster_k3s_api_vip` is the
  # reserved longer spelling, kept so a manifest written with the k3s_ segment
  # resolves rather than substituting to an empty string.
  cluster_api_vip: "{{ k3s_api_vip }}"
  cluster_k3s_api_vip: "{{ k3s_api_vip }}"
  # Pod egress to the apiserver must allow the SERVER NODE IPs, not the VIP:
  # kube-proxy DNATs the in-cluster API VIP before NetworkPolicy evaluation.
  # Widened to the LAN because the server roster is inventory data, not an answer.
  cluster_apiserver_egress_cidr: "{{ lan_cidr }}"

  # etcd scrape targets for kubeEtcd, from the starter inventory's servers —
  # re-address a server and change this too. A JSON FLOW SEQUENCE is load-bearing:
  # Helm needs a real list where Flux substitutes text.
  cluster_etcd_endpoints: '[{% for ip in k3s_server_ips %}"{{ ip }}"{{ ", " if not loop.last }}{% endfor %}]'

  # Scrape targets for the HOST node-exporters on :9101 — the hosts, resolver and
  # relay LXCs, and the k3s servers, each with an explicit conditions.ready.
  # Agents are absent: the in-cluster DaemonSet already scrapes them on 9100.
  cluster_node_exporter_host_addresses: '[{% for host in pve_hosts %}{"addresses": ["{{ lan_prefix }}.{{ 11 + loop.index0 }}"], "conditions": {"ready": true}}, {% endfor %}{% for addr in resolvers %}{"addresses": ["{{ addr }}"], "conditions": {"ready": true}}, {% endfor %}{"addresses": ["{{ lan_prefix }}.23"], "conditions": {"ready": true}}{% for ip in k3s_server_ips %}, {"addresses": ["{{ ip }}"], "conditions": {"ready": true}}{% endfor %}]'
{%- if storage_backend == 'zfs' %}

  # Scrape targets for zfs_exporter (port 9134, the `zfs_exporter` role), which
  # the storage playbook installs on the NAS node. Same EndpointSlice flow
  # sequence as the roster above. Extend it if you run ZFS on more than the NAS.
  cluster_zfs_exporter_addresses: '[{"addresses": ["{{ lan_prefix }}.11"], "conditions": {"ready": true}}]'
{%- endif %}

  # Scrape targets for unbound_exporter (port 9167, the `unbound_exporter` role),
  # one per resolver the DNS playbook builds.
  cluster_unbound_exporter_addresses: '[{% for addr in resolvers %}{"addresses": ["{{ addr }}"], "conditions": {"ready": true}}{{ ", " if not loop.last }}{% endfor %}]'

  # Gate for OffsiteBackupStale's absent() arm — a METRIC NAME, not a boolean:
  # Flux substitutes text and `${...}` is only valid PromQL inside a string.
  # "up" is the OFF position; RUNBOOKS.md § Backups and restore has the flip.
  cluster_offsite_backup_probe_metric: "up"

  # Same gate for the two other local tiers. "up" is the OFF position; point each
  # at its own metric in the change that turns the tier on.
  # archive: nas_storage_archive_backup_enabled -> archive_backup_last_success_timestamp_seconds
  cluster_archive_backup_probe_metric: "up"
  # vzdump: proxmox_backup_vzdump_jobs -> vzdump_backup_last_success_timestamp_seconds
  cluster_vzdump_probe_metric: "up"

  # The per-app dump tier ships ON (nas_storage_backup_artifact_apps is
  # populated), so its gate is armed: BackupArtifactStale must notice a
  # collector that stops emitting.
  cluster_backup_artifact_probe_metric: "backup_artifact_last_mtime_seconds"

  cluster_metallb_public_vip: "{{ metallb_public_vip }}"
  cluster_metallb_internal_vip: "{{ metallb_internal_vip }}"

  # cert-manager
  cluster_issuer: "letsencrypt-prod"
  cluster_acme_email: "{{ admin_email }}"

  # Secrets backend: the ClusterSecretStore every ExternalSecret references. The
  # else-branch hands `mandatory` an undefined value, so an unimplemented
  # backend FAILS THE RENDER instead of emitting `name: ""`.
  cluster_secret_store: "{{ 'onepassword-cluster' if secrets_backend == 'onepassword' else {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no ClusterSecretStore — add a branch to cluster_secret_store in cluster-config.yaml.jinja') }}"
{%- if secrets_backend == 'onepassword' %}
  cluster_secrets_vault: "{{ onepassword_vault }}"
{%- endif %}

  # The provider Deployment SecretsProviderDown watches. Same fail-the-render
  # seam as cluster_secret_store above.
  cluster_secrets_provider_namespace: "{{ 'external-secrets' if secrets_backend == 'onepassword' else {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no secrets-provider namespace — add a branch to cluster_secrets_provider_namespace in cluster-config.yaml.jinja') }}"
  cluster_secrets_provider_deployment: "{{ 'onepassword-connect' if secrets_backend == 'onepassword' else {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no secrets-provider Deployment — add a branch to cluster_secrets_provider_deployment in cluster-config.yaml.jinja') }}"

  cluster_git_host: "{{ git_host }}"
  # Prefix for every alert's runbook_url. The `/-/blob/` shape is GitLab's; a
  # GitHub forge needs `/blob/`. Forge seam:
  # https://github.com/ericsweiss/weisssrv-cluster-template/blob/main/docs/ARCHITECTURE.md
  cluster_runbook_base_url: "https://{{ git_host }}/{{ git_namespace }}/{{ cluster_name }}/-/blob/main/docs"

  # Host-side services, from the copier answers that also drive the Ansible
  # inventory. Moving one means changing the answer, or this file and hosts.yml
  # together — editing one alone splits the two layers apart silently.
  cluster_nas_host: "{{ nas_host }}"
  cluster_smtp_host: "{{ smtp_host }}"
  cluster_alert_email: "{{ alert_email }}"
  # Alternation of every job the host and DaemonSet node-exporters register
  # under; add members, never replace them. Dropping node-exporter-host
  # silences every host rule.
  cluster_node_exporter_job_regex: "{{ node_exporter_job_regex }}"
{%- if vpn_tailscale %}

  # CGNAT range (RFC 6598) that Tailscale allocates from — a constant, kept here
  # so ingress allowlists stay declarative. Emitted only with the module: without
  # it a manifest referencing it fails the reconcile under strict substitution.
  cluster_tailnet_cidr: "100.64.0.0/10"

  # MagicDNS suffix of your tailnet, from the Tailscale admin console DNS page.
  # The tailnet resolver hands out CNAMEs into it, so a wrong value silently
  # breaks remote access to internal names.
  cluster_tailnet_dns_suffix: "{{ tailnet_dns_suffix }}"

  # LAN resolvers the tailnet override zone forwards to, space-separated — one
  # per address in the upstream_dns_servers answer.
  cluster_upstream_dns_servers: "{{ upstream_dns_servers }}"
{%- endif %}

  # Site timezone, mirrored from `timezone` in group_vars/all.yml. Container TZ
  # env values and CronJob spec.timeZone read it instead of a literal.
  cluster_timezone: "{{ timezone }}"
{%- if dns_backend == 'cloudflare' %}

  # WAN A records the cloudflare-ddns CronJob owns, as `label[:proxied]` pairs;
  # `@` is the apex and proxied defaults to true.
  cluster_ddns_records: "{{ external_domain }}:true"
{%- endif %}
