---
# PriorityClasses for the two workload classes, `platform` and `ci-jobs`. In
# sources/ because Priority admission rejects a pod naming a class that does not
# exist, and controllers/ runs before configs/.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: platform
  annotations:
    # .value is immutable: without a forced replace, re-tuning it wedges the
    # sources stage, and every later stage dependsOn it.
    kustomize.toolkit.fluxcd.io/force: "Enabled"
value: 100000
globalDefault: false
preemptionPolicy: PreemptLowerPriority
description: >-
  Platform workloads that must win scheduling against ordinary apps and CI job
  pods. Applied per workload — nothing inherits it.
{%- if git_backend == 'gitlab_selfhosted' %}

---
# Every unclassed pod sits at 0 and outranks a CI job pod. preemptionPolicy
# Never means CI queues instead of evicting. Gated with the runner modules that
# set it — an ungated copy would be a class nothing names.
apiVersion: scheduling.k8s.io/v1
kind: PriorityClass
metadata:
  name: ci-jobs
  annotations:
    kustomize.toolkit.fluxcd.io/force: "Enabled"
value: -10
globalDefault: false
preemptionPolicy: Never
description: >-
  GitLab CI job pods. Ranked below every unclassed workload and never preempts —
  a burst queues rather than displacing running workloads. Set via
  [runners.kubernetes] priority_class_name in the runner TOMLs.
{%- endif %}
