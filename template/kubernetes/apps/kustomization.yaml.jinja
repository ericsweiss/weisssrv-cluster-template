---
# One entry per app module. Removing a line makes Flux prune that module and its
# namespace - the documented way to disable one. registry-cache has no answer
# gate, so it always renders; its README has the disable path.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - authentik
  - registry-cache
  - vm-ingress
{%- if vpn_tailscale %}
  - tailnet-dns
{%- endif %}
{%- if git_backend == 'gitlab_selfhosted' %}
  - gitlab-runner
  - gitlab-runner-privileged
  - gitlab-runner-reaper
{%- endif %}
