{#- CI capacity for both runner tiers comes from partials/ci-sizing.jinja, which
    resourcequota.yaml.jinja imports too, so the two files cannot drift.
    docs/ARCHITECTURE.md § CI runner capacity is the model. -#}
{%- import "partials/ci-sizing.jinja" as sizing with context -%}
---
# Privileged (infrastructure) runner; shared fields come from
# components/gitlab-runner-common, only the deltas are here.

# CRITICAL: register as a PROJECT runner locked to this repository — never an
# instance or group runner. The registration SCOPE is the security boundary and
# the tag is only cooperative routing, so any project could otherwise claim root
# + DinD on a runner with SSH reach to the hosts. Verify each registration:
# GET /api/v4/runners/<id> -> "runner_type": "project_type" (README.md has the
# reasoning and the tenant-build alternative).
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: gitlab-runner-privileged
  namespace: gitlab-runner-privileged
spec:
  releaseName: gitlab-runner-privileged
  values:
    # Size to the schedulable pool, never above it: overflow parks as Pending
    # pods and burns the job timeout clock. Derived from the compute_node_count
    # answer; raise it with the ResourceQuota's requests.cpu. Sizing: README.
    concurrent: {{ sizing.privileged_concurrent }}

    runners:
      name: k3s-runner-{{ ci_runner_tag }}

      secret: gitlab-runner-privileged-token

      # THE TAG THE RUNNER CLAIMS — must equal the `ci_runner_tag` answer every
      # job in this pipeline declares. Drift does not error: tagged jobs sit
      # "pending" until timeout. Both sides read the answer; hardcode neither.
      tags: "{{ ci_runner_tag }}"
      # ...and untagged jobs never do (they go to the shared runner).
      runUntagged: false

      # ACCEPTED RISK: lets this privileged runner execute MR pipelines from
      # UNPROTECTED branches. protected:true would silently break MR CI. The
      # isolation boundary is the registration scope, not the tag: README.md.
      protected: false

      executor: kubernetes

      config: |
        # TOML sections are positional: scalar keys first, sub-tables last.
        [[runners]]
          # request_concurrency 1 serializes job acquisition behind GitLab's
          # long-poll window and surfaces as runner_system_failure bursts; the
          # runner's own startup warning recommends 2-4.
          request_concurrency = 3

          # A [[runners]] scalar — must precede the [runners.kubernetes] sub-table.
          clone_url = "https://${cluster_git_host}"

          [runners.kubernetes]
            namespace = "gitlab-runner-privileged"
            # A start burst can transiently exceed placement capacity; the default
            # poll_timeout (180s) would fail a merely-Pending pod as
            # runner_system_failure. A scalar key — keep it above the sub-tables.
            poll_timeout = 1200
            # Default CI job image, digest-pinned (the tag is kept for
            # readability; the digest is authoritative).
            image = "python:3.11@sha256:9800957d2a88867f853ce6072ae1669e37fa269cc6f76009fa1aef4757f62212"
            privileged = true

            # ci-jobs ranks job pods below unclassed pods and never preempts. A
            # scalar key — keep it above the first sub-table.
            priority_class_name = "ci-jobs"

            # Build container: the CPU REQUEST is the scheduler's per-node
            # reservation, so it must match what a converge really uses (~0.9
            # cpu). No cpu_limit — burst-shaped work, a limit buys throttling.
            cpu_request = "900m"
            memory_limit = "1Gi"
            memory_request = "384Mi"

            # DinD service container: holds the test workload. No
            # service_cpu_limit, for the same reason as cpu_limit above.
            service_cpu_request = "500m"
            service_memory_limit = "2Gi"
            service_memory_request = "512Mi"

            # Ceilings bounding a per-job KUBERNETES_* override against the
            # namespace quota; at or just above each default, so an override can
            # only shrink the pod. Without them the runner ignores it outright.
            memory_limit_overwrite_max_allowed = "6Gi"
            memory_request_overwrite_max_allowed = "2Gi"
            service_memory_limit_overwrite_max_allowed = "4Gi"
            service_memory_request_overwrite_max_allowed = "1Gi"
            cpu_request_overwrite_max_allowed = "900m"

            # Helper (clone + artifacts) — tiny.
            helper_cpu_request = "100m"
            helper_memory_limit = "256Mi"
            helper_memory_request = "128Mi"

            # Job pods run as the token-less jobs SA (serviceaccount.yaml), not
            # the manager SA — they must not inherit its secrets/pods-exec Role.
            service_account = "gitlab-runner-privileged-jobs"

            # No pod_security_context: DinD needs a root Docker daemon. This is
            # the whole reason this tier exists in its own namespace.

            pull_policy = ["if-not-present"]

            # Let a job pick a CPU-compatibility class and nothing else — the
            # regex constrains the LABEL KEY shape, so a job cannot target an
            # arbitrary node.
            node_selector_overwrite_allowed = "^${cluster_node_label_domain}/cpu=(modern|legacy)$"

            # HARD-exclude CI job pods from the storage node: a soft taint lets a
            # burst spill onto it and swap other guests' cold pages. DoesNotExist
            # keeps unlabelled nodes eligible, where NotIn would need the key.
            [runners.kubernetes.affinity.node_affinity]
              [runners.kubernetes.affinity.node_affinity.required_during_scheduling_ignored_during_execution]
                [[runners.kubernetes.affinity.node_affinity.required_during_scheduling_ignored_during_execution.node_selector_terms]]
                  [[runners.kubernetes.affinity.node_affinity.required_during_scheduling_ignored_during_execution.node_selector_terms.match_expressions]]
                    key = "${cluster_node_label_domain}/nas"
                    operator = "DoesNotExist"

            # Spread job pods across agents: simultaneous same-node DinD starts
            # race the cgroup setup and die at prepare. Soft, so the scheduler
            # still packs under pressure rather than leaving jobs Pending.

            # CRITICAL: the value below is `infrastructure`, the TIER name, not
            # the runner tag — this anti-affinity, networkpolicy.yaml's egress
            # rule and kured's --blocking-pod-selector must all agree, so it
            # stays a literal (README § Isolation from the shared runner).
            [runners.kubernetes.affinity.pod_anti_affinity]
              [[runners.kubernetes.affinity.pod_anti_affinity.preferred_during_scheduling_ignored_during_execution]]
                weight = 100
                [runners.kubernetes.affinity.pod_anti_affinity.preferred_during_scheduling_ignored_during_execution.pod_affinity_term]
                  topology_key = "kubernetes.io/hostname"
                  [runners.kubernetes.affinity.pod_anti_affinity.preferred_during_scheduling_ignored_during_execution.pod_affinity_term.label_selector]
                    [[runners.kubernetes.affinity.pod_anti_affinity.preferred_during_scheduling_ignored_during_execution.pod_affinity_term.label_selector.match_expressions]]
                      key = "${cluster_node_label_domain}/runner-class"
                      operator = "In"
                      values = ["infrastructure"]

            # NetworkPolicy selector. Keep pod_labels LAST (positionality note).
            [runners.kubernetes.pod_labels]
              "${cluster_node_label_domain}/runner-class" = "infrastructure"

    serviceAccount:
      create: true
      name: gitlab-runner-privileged
