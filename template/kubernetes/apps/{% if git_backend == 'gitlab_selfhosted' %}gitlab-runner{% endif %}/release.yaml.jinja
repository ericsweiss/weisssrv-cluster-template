{#- CI capacity for both runner tiers comes from partials/ci-sizing.jinja, which
    resourcequota.yaml.jinja imports too, so the two files cannot drift.
    docs/ARCHITECTURE.md § CI runner capacity is the model. -#}
{%- import "partials/ci-sizing.jinja" as sizing with context -%}
---
# Shared, non-privileged GitLab Runner. The fields common to both runners (chart,
# timeouts, gitlabUrl, replicas, rbac, manager resources, affinity, tolerations)
# come from components/gitlab-runner-common; only the deltas live here.
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: gitlab-runner
  namespace: gitlab-runner
spec:
  releaseName: gitlab-runner
  values:
    # MUST stay at or below what the ResourceQuota admits: above it the runner
    # submits pods the quota 403s, which GitLab reports as a job failure with no
    # retry. Derived from the compute_node_count answer, as the quota is.
    concurrent: {{ sizing.shared_concurrent }}

    runners:
      name: k3s-runner-shared

      # Secret created by ESO (externalsecret.yaml).
      secret: gitlab-runner-token

      # Explicit routing tag, in addition to untagged jobs.
      tags: "k8s-deploy"

      # The default runner for projects that specify no tags.
      runUntagged: true

      # ACCEPTED RISK: protected:false lets this runner accept jobs from
      # unprotected branches, which is what makes MR pipelines work. Acceptable
      # only while it stays non-privileged and egress-contained (networkpolicy).
      protected: false

      executor: kubernetes

      config: |
        [[runners]]
          # request_concurrency 1 serializes job acquisition behind GitLab's
          # long-poll window and surfaces as runner_system_failure bursts; the
          # runner's own startup warning recommends 2-4.
          request_concurrency = 3

          # Keep clones on the internal path too (see gitlabUrl in the shared
          # component). A [[runners]] scalar — must precede any sub-table.
          clone_url = "https://${cluster_git_host}"

          # Running as non-root, containers may have no /etc/passwd entry, so HOME
          # is unset and git tries to write //.gitconfig. Point both at a writable
          # path (the emptyDir mounted at the bottom of this config).
          environment = ["HOME=/home/gitlab-runner", "GIT_CONFIG_GLOBAL=/home/gitlab-runner/.gitconfig"]

          # TOML sections are positional: scalar keys first, sub-tables last.
          [runners.kubernetes]
            namespace = "gitlab-runner"
            # A start burst can transiently exceed placement capacity; the
            # default poll_timeout (180s) would fail a merely-Pending pod as
            # runner_system_failure. A scalar key — keep it above the sub-tables.
            poll_timeout = 1200
            # Default CI job image, digest-pinned for reproducibility (the tag is
            # kept for readability; the digest is authoritative). Refresh with
            # `docker buildx imagetools inspect <image>:<tag>`.
            image = "debian:trixie@sha256:d07d1b51c39f51188e60be9b64e6bf769fa94e187f092bc32b91305cfa34ba5a"
            privileged = false

            # ci-jobs ranks job pods below unclassed pods and never preempts. A
            # scalar key — keep it above the first sub-table.
            priority_class_name = "ci-jobs"

            # No cpu_limit: CPU is compressible, so cpu_request sets the
            # contention share and the namespace ResourceQuota's requests.cpu
            # bounds the aggregate. A limit would only buy CFS throttling.
            cpu_request = "500m"
            memory_limit = "4Gi"
            memory_request = "1Gi"

            # Ceilings equal the defaults, so a per-job KUBERNETES_* override can
            # only shrink a pod, never grow it past the namespace quota. Without
            # them the runner ignores such an override outright.
            memory_limit_overwrite_max_allowed = "4Gi"
            memory_request_overwrite_max_allowed = "1Gi"
            service_memory_limit_overwrite_max_allowed = "4Gi"
            service_memory_request_overwrite_max_allowed = "1Gi"
            cpu_request_overwrite_max_allowed = "500m"

            # Token-less, RBAC-less job SA — NOT the manager SA, whose Role could
            # read the runner token and exec into concurrent jobs.
            service_account = "gitlab-runner-jobs"

            pull_policy = ["if-not-present"]

            # Let a job pick a CPU-compatibility class and nothing else. The regex
            # constrains the LABEL KEY shape, so a job cannot target an arbitrary
            # node by, say, kubernetes.io/hostname.
            node_selector_overwrite_allowed = "^${cluster_node_label_domain}/cpu=(modern|legacy)$"

            # NetworkPolicy selector: shared job pods get internet-only egress.
            # Keep pod_labels LAST (TOML positionality note above).
            [runners.kubernetes.pod_labels]
              "${cluster_node_label_domain}/runner-class" = "shared"

            # Non-root is appropriate here: this runner does kubectl/helm/lint
            # work. It has no SSH reach, no DinD and no privileged execution — for
            # those, use the privileged runner.
            [runners.kubernetes.pod_security_context]
              run_as_non_root = true
              run_as_user = 1000
              run_as_group = 1000
              fs_group = 1000

            # Writable HOME for non-root execution (the default HOME is read-only).
            [[runners.kubernetes.volumes.empty_dir]]
              name = "home"
              mount_path = "/home/gitlab-runner"

    serviceAccount:
      create: true
      name: gitlab-runner
