{#- Same model as release.yaml.jinja, imported from the one file that holds it. -#}
{%- import "partials/ci-sizing.jinja" as sizing with context -%}
---
# Aggregate bounds for the shared-runner namespace. Without them, `concurrent`
# job pods plus the manager can schedule enough requests — and burst to enough
# memory limits — to evict resident workloads on a tight node. Every number is
# derived from the same `concurrent` release.yaml computes, so the two cannot
# drift apart when the roster changes.
#
# requests.* are the scheduler's reservation and are doubled over real per-job
# usage, because a Terminating pod still counts: a thin buffer 403s under churn
# and GitLab reports that as a job failure with no retry. A job pod's real
# request is 500m + 100m of CPU and 1Gi + 256Mi of memory (the LimitRange
# default covers the helper); its DECLARED memory limits are 4Gi + 1Gi, the
# second being the LimitRange's default limit, since the helper declares none.
#
# limits.memory and pods do NOT double: at 5Gi a job that would put the ceiling
# above the whole agent pool, so churn there gets two extra SLOTS instead.
#
# Deliberately NO cpu / limits.cpu dimension: a CPU-limit quota forces EVERY pod
# in the namespace to declare a CPU limit, which would reject the runner manager
# (it runs without one on purpose, to avoid CFS throttling). CPU is bounded via
# requests.cpu; memory via both.
apiVersion: v1
kind: ResourceQuota
metadata:
  name: gitlab-runner-quota
  namespace: gitlab-runner
spec:
  hard:
    requests.cpu: "{{ sizing.shared_quota_cpu }}"
    requests.memory: {{ sizing.shared_quota_mem_gib }}Gi
    limits.memory: {{ sizing.shared_quota_limit_mem_gib }}Gi
    pods: "{{ sizing.shared_quota_pods }}"
---
# Defaults so a pod created without explicit resources (e.g. an auxiliary pod a
# job spawns via its pods:create RBAC) still counts against the quota instead of
# slipping in unbounded. Memory only — never a default CPU limit (see above).
apiVersion: v1
kind: LimitRange
metadata:
  name: gitlab-runner-limits
  namespace: gitlab-runner
spec:
  limits:
    - type: Container
      default:
        memory: 1Gi
      defaultRequest:
        cpu: 100m
        memory: 256Mi
