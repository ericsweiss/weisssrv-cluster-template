{#- Same model as release.yaml.jinja, imported from the one file that holds it. -#}
{%- import "partials/ci-sizing.jinja" as sizing with context -%}
---
# Aggregate bounds for this runner namespace, derived from the same `concurrent`
# release.yaml uses. Prose: README.md, Sizing.
apiVersion: v1
kind: ResourceQuota
metadata:
  name: gitlab-runner-quota
  namespace: gitlab-runner
spec:
  hard:
    requests.cpu: "{{ sizing.shared_quota_cpu }}"
    requests.memory: {{ sizing.shared_quota_mem_gib }}Gi
    limits.memory: {{ sizing.shared_quota_limit_mem_gib }}Gi
    pods: "{{ sizing.shared_quota_pods }}"
---
# Defaults so a pod created without explicit resources still counts against the
# quota instead of slipping in unbounded. Memory only, never a default CPU limit
# (README.md, Sizing).
apiVersion: v1
kind: LimitRange
metadata:
  name: gitlab-runner-limits
  namespace: gitlab-runner
spec:
  limits:
    - type: Container
      default:
        memory: 1Gi
      defaultRequest:
        cpu: 100m
        memory: 256Mi
