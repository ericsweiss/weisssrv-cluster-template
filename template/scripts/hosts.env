# PLACEHOLDER — the real file is generated by scripts/generate-hosts-env.py from
# ansible/inventories/prod/hosts.yml. Run `task hosts:sync` once the inventory
# describes your nodes, and after every change to it.
#
# Shell-sourceable and go-task `dotenv:`-loadable. *_HOSTS are hostnames
# (LAN/tailnet resolvable); every other list is IPs.
#
# Until it is generated the roster is empty: tasks that iterate over a list stop
# with an explicit message, and the CI deploy jobs seed no known_hosts entries.
NAS_HOSTS=""
NAS_IPS=""
COMPUTE_HOSTS=""
COMPUTE_IPS=""
PVE_HOSTS=""
PVE_IPS=""
DNS_IPS=""
MAIL_IPS=""
K3S_SERVERS=""
K3S_AGENTS=""
ALL_SSH_IPS=""
