# PLACEHOLDER — generated by scripts/generate-hosts-env.py from
# ansible/inventories/prod/hosts.yml. Run `task hosts:sync` once the inventory
# describes your nodes, and after every change to it.
#
# Shell-sourceable and go-task `dotenv:`-loadable. *_HOSTS are hostnames
# (LAN/tailnet resolvable); every other list is IPs. An empty roster means tasks
# that iterate stop with an explicit message and the CI deploy jobs seed no
# known_hosts entries.
#
# `task lint` and the CI `repo-sync` job fail against this placeholder until the
# sync has run, and name the command when they do — SETUP.md runs the sync before
# it runs the gates.
NAS_HOSTS=""
NAS_IPS=""
COMPUTE_HOSTS=""
COMPUTE_IPS=""
PVE_HOSTS=""
PVE_IPS=""
DNS_IPS=""
MAIL_IPS=""
K3S_SERVERS=""
K3S_AGENTS=""
ALL_SSH_IPS=""
