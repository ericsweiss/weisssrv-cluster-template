#!/usr/bin/env python3
"""Fail tenant onboarding without the Deny-bound tenant-traefik-policy.yaml, whatever
allowCrossNamespace says: Ingress annotations, forwardAuth addresses and endpoint
resolution cross namespaces without it. Each policy's shape is pinned, not just
its name. Exit 0 clean, 1 findings, 2 vacuous.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover - environment guard
    print("ERROR: PyYAML required: pip install pyyaml", file=sys.stderr)
    raise SystemExit(2) from None

REPO = Path(__file__).resolve().parent.parent
TENANTS_KUSTOMIZATION = "kubernetes/clusters/{{ cluster_name }}/tenants/kustomization.yaml"
TRAEFIK_RELEASE = "kubernetes/infrastructure/controllers/traefik/release.yaml"

# The one resource that is always present: the shared tenant RBAC, not a tenant.
BASELINE = {"tenant-crd-editor.yaml"}

# The admission policies that pin tenant Traefik references, and every Service
# Traefik may resolve, to the tenant's own namespace. Each must fail closed, match
# exactly these resources and keep this many validations, or a weakened copy
# would still pass by name. Change one together with tenant-traefik-policy.yaml.
TENANT_POLICY = "kubernetes/infrastructure/configs/tenant-traefik-policy.yaml"
CONFIGS_KUSTOMIZATION = "kubernetes/infrastructure/configs/kustomization.yaml"
WRITES = ["CREATE", "UPDATE"]
REQUIRED_POLICIES = {
    "tenant-traefik-route-refs": {
        "resourceRules": [
            {
                "apiGroups": ["traefik.io"],
                "apiVersions": ["*"],
                "operations": WRITES,
                "resources": ["ingressroutes", "ingressroutetcps", "ingressrouteudps"],
            },
        ],
        "validations": 4,
    },
    "tenant-traefik-object-refs": {
        "resourceRules": [
            {
                "apiGroups": ["traefik.io"],
                "apiVersions": ["*"],
                "operations": WRITES,
                "resources": ["middlewares", "traefikservices"],
            },
        ],
        "validations": 6,
    },
    "tenant-traefik-ingress-refs": {
        "resourceRules": [
            {
                "apiGroups": ["networking.k8s.io"],
                "apiVersions": ["*"],
                "operations": WRITES,
                "resources": ["ingresses"],
            },
            {
                "apiGroups": [""],
                "apiVersions": ["*"],
                "operations": WRITES,
                "resources": ["services"],
            },
        ],
        "validations": 1,
    },
    "tenant-no-externalname-services": {
        "resourceRules": [
            {
                "apiGroups": [""],
                "apiVersions": ["v1"],
                "operations": WRITES,
                "resources": ["services"],
            },
        ],
        "validations": 2,
    },
    "tenant-no-manual-endpoints": {
        "resourceRules": [
            {
                "apiGroups": [""],
                "apiVersions": ["v1"],
                "operations": WRITES,
                "resources": ["endpoints"],
            },
            {
                "apiGroups": ["discovery.k8s.io"],
                "apiVersions": ["v1"],
                "operations": WRITES,
                "resources": ["endpointslices"],
            },
        ],
        "validations": 1,
    },
}
TENANT_LABEL = "fluxcd.io/tenant"
TENANT_MATCH = {
    "namespaceSelector": {
        "matchExpressions": [{"key": TENANT_LABEL, "operator": "Exists"}]
    }
}


class Vacuous(Exception):
    """The gate could not inspect its subject — exit 2, never a silent pass."""


def _read(path: Path, root: Path) -> str:
    """Read one of the gate's inputs, or exit 2 through Vacuous."""
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise Vacuous(f"{path.relative_to(root)}: {exc}") from exc


def tenant_resources(path: Path, root: Path) -> list[str]:
    try:
        doc = yaml.safe_load(_read(path, root)) or {}
    except yaml.YAMLError as exc:
        raise Vacuous(f"{path.relative_to(root)}: {exc}") from exc
    return [str(r) for r in doc.get("resources") or []]


def allows_cross_namespace(path: Path, root: Path) -> bool | None:
    """The provider setting, or None when no HelmRelease here declares values —
    a missing values block leaves the question unanswerable, not answered."""
    answered = False
    try:
        docs = list(yaml.safe_load_all(_read(path, root)))
    except yaml.YAMLError as exc:
        raise Vacuous(f"{path.relative_to(root)}: {exc}") from exc
    for doc in docs:
        if not doc or doc.get("kind") != "HelmRelease":
            continue
        values = (doc.get("spec") or {}).get("values")
        if not isinstance(values, dict):
            continue
        answered = True
        providers = values.get("providers") or {}
        if (providers.get("kubernetesCRD") or {}).get("allowCrossNamespace"):
            return True
    return False if answered else None


def enforces(spec: object, required: dict) -> bool:
    """The policy fails closed, matches exactly the required resources with no
    match conditions, and keeps the required number of validations."""
    if not isinstance(spec, dict):
        return False
    validations = spec.get("validations")
    return (
        spec.get("failurePolicy") == "Fail"
        and spec.get("matchConstraints") == {"resourceRules": required["resourceRules"]}
        and not spec.get("matchConditions")
        and isinstance(validations, list)
        and len(validations) == required["validations"]
        and all(isinstance(v, dict) and v.get("expression") for v in validations)
    )


def policies_pin_tenants(path: Path, root: Path) -> bool:
    """True when the configs kustomization applies the policy file, every
    required policy exists in its pinned shape, and a Deny binding applies it,
    unnarrowed, to every namespace carrying the tenant label."""
    if not path.is_file():
        return False
    configs = root / CONFIGS_KUSTOMIZATION
    if not configs.is_file() or path.name not in tenant_resources(configs, root):
        return False
    try:
        docs = [d for d in yaml.safe_load_all(_read(path, root)) if isinstance(d, dict)]
    except yaml.YAMLError as exc:
        raise Vacuous(f"{path.relative_to(root)}: {exc}") from exc
    policies: dict[str, list[object]] = {}
    for doc in docs:
        if doc.get("kind") == "ValidatingAdmissionPolicy":
            name = (doc.get("metadata") or {}).get("name")
            policies.setdefault(name, []).append(doc.get("spec"))
    bound = set()
    for doc in docs:
        if doc.get("kind") != "ValidatingAdmissionPolicyBinding":
            continue
        spec = doc.get("spec") or {}
        if "Deny" not in (spec.get("validationActions") or []):
            continue
        # The tenant-label Exists must be the whole match: any other key narrows
        # the binding (objects, resources, namespaces) while it still reads true.
        if spec.get("matchResources") == TENANT_MATCH:
            bound.add(spec.get("policyName"))
    return all(
        name in bound
        and len(policies.get(name, [])) == 1
        and enforces(policies[name][0], required)
        for name, required in REQUIRED_POLICIES.items()
    )


def check(root: Path = REPO) -> list[str]:
    kustomization = root / TENANTS_KUSTOMIZATION
    release = root / TRAEFIK_RELEASE
    for path in (kustomization, release):
        if not path.is_file():
            return [f"{path.relative_to(root)} is missing — this gate no longer binds"]

    resources = tenant_resources(kustomization, root)
    if not resources:
        return [f"{TENANTS_KUSTOMIZATION} lists no resources — has the tenant wiring moved?"]

    allows = allows_cross_namespace(release, root)
    if allows is None:
        return [
            f"{TRAEFIK_RELEASE} declares no HelmRelease spec.values — this gate "
            "can no longer read the provider setting"
        ]

    tenants = [r for r in resources if r not in BASELINE]
    if not tenants:
        return []
    if policies_pin_tenants(root / TENANT_POLICY, root):
        return []

    return [
        f"{TENANTS_KUSTOMIZATION} onboards {', '.join(tenants)} without "
        f"the complete Deny-bound tenant policies in {TENANT_POLICY}. "
        "Those policies are required even when "
        "providers.kubernetesCRD.allowCrossNamespace is false: plain Ingress "
        "annotations, forwardAuth addresses, and Service endpoint resolution "
        "can otherwise make Traefik cross the tenant boundary."
    ]


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--repo", type=Path, default=REPO)
    args = ap.parse_args(argv)

    try:
        problems = check(args.repo)
    except Vacuous as exc:
        print(f"check-tenant-traefik-isolation inspected nothing: {exc}", file=sys.stderr)
        print(
            "    Fix: Flux would reject the file — make it parse, or move it out "
            "of the tree.",
            file=sys.stderr,
        )
        return 2
    if problems:
        print("check-tenant-traefik-isolation: FAILED", file=sys.stderr)
        for problem in problems:
            print(f"  {problem}", file=sys.stderr)
        return 1
    print("check-tenant-traefik-isolation: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
