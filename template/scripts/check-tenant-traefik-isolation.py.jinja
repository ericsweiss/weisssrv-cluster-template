#!/usr/bin/env python3
"""Fail tenant onboarding without the Deny-bound, shape-pinned tenant policies,
whatever allowCrossNamespace says: Ingress annotations, forwardAuth and endpoints
cross namespaces without them. Exit 0 clean, 1 findings, 2 vacuous.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover - environment guard
    print("ERROR: PyYAML required: pip install pyyaml", file=sys.stderr)
    raise SystemExit(2) from None

