---
# Site data for scripts/check-alertmanager-behaviour.py (--config). The route
# cases, the synthetic alertnames and the upstream alert inventory are all
# cluster-specific, so the vendored gate cannot carry them.

# One case per receiver the config should reach. `amtool config routes test`
# prints every match in tree order and only the first delivers, so `receiver`
# is compared against the first line.
route_cases:
  # Watchdog carries severity=none and MUST beat the severity=none null route.
  - receiver: watchdog-heartbeat
    labels: [alertname=Watchdog, severity=none]
  - receiver: "null"
    labels: [alertname=InfoInhibitor, severity=none]
  - receiver: email-and-chat
    labels: [alertname=ZFSPoolNotOnline, severity=critical]
  - receiver: chat-default
    labels: [alertname=DiskUsageWarning, severity=warning]
  # severity=info has its own child route ahead of the root, carrying repeat_interval 24h.
  - receiver: chat-default
    labels: [alertname=NodeOutageStormControl, severity=info]
  - receiver: chat-default
    labels: [alertname=SomeUnlabelledAlert]
  # The durability and latch branches keep the root receivers, at a longer repeat.
  - receiver: email-and-chat
    labels: [alertname=ZFSPoolDataErrors, severity=critical]
  - receiver: chat-default
    labels: [alertname=MaintenanceRebootDeferred, severity=warning]
  - receiver: chat-default
    labels: [alertname=AlertmanagerNotificationsDropping, severity=info]

# Route-case alertnames that deliberately name no rule. Only the fall-through
# case, whose point is that an alert matching no child route still reaches the
# root receiver.
synthetic_route_alerts:
  - SomeUnlabelledAlert

# Rule trees the Prometheus extractor never reads: Loki's ruler evaluates these
# as plain `groups:` documents, so their alertnames and severities need listing.
rule_corpora:
  - kubernetes/infrastructure/observability/loki/host-log-staleness.yaml
{%- if git_backend == 'gitlab_selfhosted' %}
  - kubernetes/infrastructure/observability/loki/runner-reaper.yaml
{%- endif %}

# Alerts shipped by the kube-prometheus-stack chart's own rule groups. Every
# alertname in an inhibit rule must resolve to a rule this repository ships or
# to an entry here; verify a new entry against the chart, as a typo is inert.
upstream_alerts:
  - AlertmanagerFailedToSendAlerts
  - InfoInhibitor
  - KubeAggregatedAPIDown
  - KubeContainerWaiting
  - KubeDaemonSetMisScheduled
  - KubeDaemonSetRolloutStuck
  - KubeDeploymentReplicasMismatch
  - KubePodNotReady
  - KubeStatefulSetReplicasMismatch
  - NodeSystemSaturation
  - Watchdog

# Label keys the inhibit rule for every escalation pair must share, so one
# host's critical does not silence another host's warning. The default suits a
# textfile-collector series; a pair keyed on an object declares its own below.
escalation_equal:
  - instance

# Pairs the name-stem rule does not derive, or whose identity is not a host, so
# `instance` is not what distinguishes two firing alerts. The labels here are the
# ones the inhibit rules in alertmanager-config.yaml already share.
escalation_pairs:
  - critical: PVCUsageCritical
    warning: PVCUsageWarning
    equal: [namespace, persistentvolumeclaim]
  - critical: CertExpiringCritical
    warning: CertExpiringWarning
    equal: [namespace, name]
  - critical: AlertmanagerClusterFailedToSendAlerts
    warning: AlertmanagerFailedToSendAlerts
    equal: [namespace, service, integration]
{%- if tenant_storage %}
  - critical: TenantVolumesNearlyFull
    warning: TenantVolumesFilling
    equal: [instance]
{%- endif %}
{%- if postgres_operator %}
  - critical: CNPGBaseBackupStaleCritical
    warning: CNPGBaseBackupStale
    equal: [namespace, pod]
{%- endif %}
