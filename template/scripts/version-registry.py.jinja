"""Tracked-version registry: one entry per pin in ansible/inventories/prod/group_vars/all.yml.

Read by `task maintenance:check-versions`; coverage enforced by `task lint:version-coverage`.
Field reference and categories: weisssrv-lib docs/SCRIPTS.md.
"""

# Charts reconciled by Flux: nothing to deploy, the push is the deploy.
_FLUX = "git push (Flux reconciles)"


def _chart(name, key, repo, chart, **extra):
    entry = {
        "name": name,
        "var_name": f"helm_chart_versions.{key}",
        "category": "helm",
        "helm_repo": repo,
        "helm_chart": chart,
        "deploy_command": _FLUX,
    }
    entry.update(extra)
    return entry


