{%- set roots = [('cloudflare', 'cloudflare-zone'), ('authentik', 'authentik-sso')] -%}
{%- if vpn_tailscale %}{% set _ = roots.append(('tailscale', 'tailscale-acl')) %}{% endif -%}
{%- if use_unifi %}{% set _ = roots.append(('unifi', 'unifi-network')) %}{% endif -%}
---
# Files beyond .gitlab-ci.yml and ansible/requirements.yml that repeat the
# library tag, one entry per rendered Terraform root so a root that stops pinning
# fails by name. check-lib-pins.py's docstring owns the entry contract.
sites:
{%- for dir, module in roots %}
  - path: terraform/{{ dir }}/main.tf
    pattern: '//terraform/modules/{{ module }}\?ref=(v\d+\.\d+\.\d+)'
{%- endfor %}
