    #   NAMESPACE NAME READY STATUS RESTARTS AGE
    def test_running_and_ready_is_healthy(self):
        out = _run(
            "list_unhealthy_pods",
            "ns app-1 1/1 Running 0 5m\n"
            "ns app-2 2/2 Running 0 5m\n",
        ).stdout.strip()
        assert out == ""
