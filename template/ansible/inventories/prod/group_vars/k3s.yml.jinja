---
# k3s nodes (servers + agents). The API VIP lives in all.yml.

# The server token also pulls cluster CA material; the agent token is
# worker-only. Both fail loud when unset.
k3s_token: >-
  {% raw %}{{ lookup('ansible.builtin.env', 'K3S_TOKEN')
     or undef(hint='K3S_TOKEN must be set (run via the task wrapper / op run)') }}{% endraw %}
k3s_agent_token: >-
  {% raw %}{{ lookup('ansible.builtin.env', 'K3S_AGENT_TOKEN')
     or undef(hint='K3S_AGENT_TOKEN must be set (run via the task wrapper / op run)') }}{% endraw %}

# Neither may overlap {{ lan_cidr }}, and k3s derives the cluster DNS ClusterIP
# from the service CIDR. Both come from answers - re-answer, never edit here.
k3s_cluster_cidr: "{{ k3s_pod_cidr }}"
k3s_service_cidr: "{{ k3s_service_cidr }}"

# Empty on purpose: a host search domain plus ndots:5 probes every in-cluster
# lookup externally first.
resolv_conf_search_domains: []

# Replaced by MetalLB and the Traefik release in infrastructure/controllers/.
# local-storage goes too, so a claim without a storageClassName goes Pending
# rather than landing unbacked on a node bootdisk.
k3s_disable:
  - servicelb
  - traefik
  - local-storage

# WireGuard-encrypted pod-to-pod traffic (UDP/51820). Changing it on a running
# cluster needs a server-by-server restart.
k3s_flannel_backend: "wireguard-native"

# Earlier than the 85/80 default: on a 64G root disk the image store otherwise
# grows for tens of gigabytes before kubelet prunes.
k3s_kubelet_args:
  - "image-gc-high-threshold={{ k3s_image_gc_high_threshold }}"
  - "image-gc-low-threshold=50"

# kube-apiserver audit logging (servers only). The log is node-local, not in Loki.
k3s_audit_enabled: true

# The interface kube-vip advertises the API VIP on; a renamed NIC breaks failover.
k3s_kube_vip_interface: "eth0"

# Delegate target for cluster-wide kubectl in the maintenance playbooks: a k3s
# server OTHER than the host being worked on, falling back to the first server.
# Templated lazily, so it tracks each host.
k3s_delegate_server: >-
  {% raw %}{{ (groups['k3s_servers'] | difference([inventory_hostname]) | first)
     | default(groups['k3s_servers'][0]) }}{% endraw %}

# NFS-over-TLS on every node, client-side only: no node carries a cert.
nfs_tls_enabled: true

# Each server copies its newest etcd snapshot to the NAS. The export is
# provisioned in group_vars/nas.yml - the two must move together.
k3s_etcd_snapshot_offnode_enabled: true
k3s_etcd_snapshot_nfs_server: "{{ nas_host }}"
k3s_etcd_snapshot_nfs_export: /k3s-etcd

# CRITICAL: /etc/hosts pins so pulls and PV mounts survive a cluster-DNS
# outage. The NFS mount must be by HOSTNAME - the wildcard cert has no IP SAN,
# so an IP mount fails the handshake.
k3s_storage_host_pins:
  - name: "{{ nas_host }}"
    ip: "{% raw %}{{ hostvars[groups['nas'][0]].ansible_host }}{% endraw %}"
k3s_registry_host_pins: []
