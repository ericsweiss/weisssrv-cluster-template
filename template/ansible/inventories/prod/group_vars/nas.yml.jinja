---
{%- from "partials/roster.jinja" import k3s_server_ips, k3s_agent_ips
    with context %}
# The storage host: ZFS properties, NFS exports, Samba, backups.
# Pools and datasets are created BY HAND, never by Ansible; a declared dataset
# that does not exist fails the deploy. Bootstrap: docs/RUNBOOKS.md Storage.

# REQUIRED: your pool and dataset layout. The rest of this template assumes two
# pools - a bulk one for media and backups, a fast one for app data.
nas_storage_zfs_pools:
  - name: tank
    datasets:
      - name: tank/media
        properties:
          mountpoint: /mnt/tank/media
          atime: "off"
          compression: zstd
          recordsize: 1M       # large sequential reads
      - name: tank/share
        properties:
          mountpoint: /mnt/tank/share
          atime: "off"
          compression: zstd
      # Backup landing zone. The apps and k3s-etcd exports below are plain
      # subdirectories of it, created and owned by the role.
      - name: tank/backups
        properties:
          mountpoint: /mnt/tank/backups
          atime: "off"
          compression: zstd
  - name: ssd
    datasets:
      - name: ssd/appdata
        properties:
          mountpoint: /mnt/ssd/appdata
          atime: "off"
          compression: lz4     # latency over ratio for live app data
      # proxmox_vm materializes a parent filesystem per app zvol, which mounts
      # inside the /export/appdata bind unless canmount=off. Declare those
      # datasets here only once the k3s VMs exist.

# Unified media directory across tiers; empty with a single media pool. When the
# branch is re-exported over NFS, inodecalc/noforget are required or clients
# hit ESTALE.
nas_storage_mergerfs_mounts: []

# NFS exports. /export is an NFSv4 pseudo-root; every real export binds a
# dataset under it. `xprtsec: tls` rejects plaintext, and clients mount by
# HOSTNAME - the wildcard cert has no IP SAN, so an IP mount fails the handshake.
nas_storage_exports:
  - path: /export
    clients:
      - spec: "{{ lan_cidr }}"
        options: "ro,sync,hide,no_subtree_check,fsid=0,sec=sys,root_squash"

  # CRITICAL: all_squash maps every client to 1000:2000, so a LAN-wide rw
  # client here is LAN-wide write access to app state. A non-k3s consumer gets
  # its own line here AND in the nfs_clients ipset.
  - path: /export/appdata
    bind_source: /mnt/ssd/appdata
    owner: 1000
    group: 2000
    mode: "02775"
    xprtsec: "tls"
    clients:
{%- for ip in k3s_server_ips + k3s_agent_ips %}
      - spec: "{{ ip }}/32"
        options: "rw,sync,no_subtree_check,all_squash,anonuid=1000,anongid=2000,fsid=11"
{%- endfor %}

  # The household share, k3s nodes only. A LAN consumer belongs in
  # nas_storage_samba_shares, since `xprtsec: tls` rejects plaintext here.
  - path: /export/share
    bind_source: /mnt/tank/share
    owner: 1000
    group: 2000
    mode: "02775"
    xprtsec: "tls"
    clients:
{%- for ip in k3s_server_ips + k3s_agent_ips %}
      - spec: "{{ ip }}/32"
        options: "rw,sync,no_subtree_check,root_squash,fsid=12"
{%- endfor %}

  # REQUIRED by k3s_etcd_snapshot_offnode_enabled. A snapshot is a full copy of
  # every Secret, hence 0700 root:root and a server-only client list.
  - path: /export/k3s-etcd
    bind_source: /mnt/tank/backups/k3s-etcd
    bind_source_check: /mnt/tank/backups
    owner: 0
    group: 0
    mode: "0700"
    xprtsec: "tls"
    clients:
{%- for ip in k3s_server_ips %}
      - spec: "{{ ip }}/32"        # k3s-srv-{{ '%02d' | format(loop.index) }}
        options: "rw,sync,no_subtree_check,no_root_squash,fsid=13"
{%- endfor %}

  # REQUIRED by the authentik-pg-dump PV. Each app gets its own export with a
  # fresh fsid, so one app's client cannot read another's dumps.
  - path: /export/backups-apps/authentik
    bind_source: /mnt/tank/backups/apps/authentik
    bind_source_check: /mnt/tank/backups
    owner: 1000
    group: 2000
    mode: "02775"
    xprtsec: "tls"
    clients:
{%- for ip in k3s_agent_ips %}
      - spec: "{{ ip }}/32"        # k3s-agt-{{ '%02d' | format(loop.index) }}
        options: "rw,sync,no_subtree_check,all_squash,anonuid=1000,anongid=2000,fsid=14"
{%- endfor %}

# Per-app directories under the appdata bind source, owned to match the export's
# squash. `grafana` is REQUIRED by the grafana-data PV; an app with its own
# block device does not belong here.
nas_storage_appdata_dirs:
  - grafana

# Samba shares (SMB clients only — the cluster uses NFS). The share password
# comes from the SAMBA_NAS_PASSWORD environment variable.
nas_storage_samba_shares: []

# SMART monitoring: list the device paths of each pool's members (use stable
# /dev/disk/by-id/ paths). Empty lists disable the checks for that class.
nas_storage_smartd_enabled: true
nas_storage_smartd_tank_disks: []
nas_storage_smartd_ssd_disks: []
nas_storage_smartd_nvme_disks: []

nas_storage_zfs_scrub_enabled: true
nas_storage_zfs_scrub_schedule: "Sun *-*-1..7 04:00:00"   # first Sunday, monthly

# ARC ceiling in bytes, owned by nas_storage here rather than zfs_arc_cap. Empty
# leaves the ZFS default of about half of RAM. Example: 4294967296 (4 GiB).
nas_storage_zfs_arc_max_bytes: ""

# Datasets on encrypted pools whose bind mounts wait for the key load, so an
# export does not publish an empty directory at boot.
nas_storage_encrypted_bind_sources: []

# NAS-side "the dump landed" signal, one entry per app with a landing zone
# above. Each needs `name` and `pattern`; a bare string emits no series.
nas_storage_backup_artifact_apps:
  - name: authentik
    pattern: "authentik-*.sql.gz"

# --- Backups ----------------------------------------------------------------
# vzdump, archive and offsite ship OFF until configured; ZFS snapshots and the
# per-app dumps above ship on, with the BackupArtifact* alerts armed.

# Cluster-wide vzdump target and jobs, applied from the NAS because storage.cfg
# is clustered. Empty leaves both unmanaged; the NFS target must already exist.
proxmox_backup_storage: []
proxmox_backup_vzdump_jobs: []

# Nightly ZFS replication to a detachable archive pool. OFF by default: the
# control script rewrites the destination pool's root properties.
nas_storage_archive_backup_enabled: false

# Offsite backup (restic over rclone). Off until the archive tier above runs and
# a RESTORE is tested; a half-configured enable fails the deploy.
restic_offsite_enabled: false

# Hard kill timer on the backup and restore-drill units. Size it above the
# longest expected run for this repo and uplink; the deep verify has its own.
restic_offsite_timeout_start_sec: 6h

# The other half of the swap-clean interlock below: without it a swap-clean
# night starting after the upload took the lock still stops guests underneath
# it. restic_offsite asserts this once nas_storage_swap_clean_enabled is true.
restic_offsite_conflicting_units:
  - swap-clean.service

# restic_offsite is a separate role, so its unit is named here. The OnSuccess
# chain is the primary trigger; the offsite timer is the fallback.
nas_storage_archive_backup_on_success_units:
  - restic-offsite.service

# CRITICAL: without restic-offsite.service here, swap-clean shrinks the ARC and
# stops guests under an in-flight upload. The other two are the role defaults,
# repeated because naming any unit replaces the whole list.
nas_storage_swap_clean_conflicting_units:
  - archive-backup.service
  - media-mover.service
  - restic-offsite.service
