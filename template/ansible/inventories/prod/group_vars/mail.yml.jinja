---
# The SMTP relay: one authenticated smarthost for everything that sends mail.

proxmox_lxc_nesting: true

# The SAME from=-restricted key base deploys, not the plain SSH_PUBLIC_KEY the
# role defaults to, so the two managers agree; the ternary short-circuits when
# SSH_PUBLIC_KEY is unset (skip, not error).
proxmox_lxc_ssh_public_keys: >-
  {% raw %}{{ ssh_authorized_keys | join("\n")
     if lookup('ansible.builtin.env', 'SSH_PUBLIC_KEY', default='') else '' }}{% endraw %}

# REQUIRED: the smarthost this relay forwards to, as Postfix `[host]:port` -
# the brackets suppress the MX lookup. E.g. "[smtp.example.com]:587".
smtp_relay_upstream: ""

# Credentials for the smarthost (upstream_*) and for senders authenticating to
# THIS relay (sasl_*). All four are asserted.
smtp_relay_upstream_user: "{% raw %}{{ lookup('ansible.builtin.env', 'SMTP_UPSTREAM_USER') }}{% endraw %}"
smtp_relay_upstream_password: "{% raw %}{{ lookup('ansible.builtin.env', 'SMTP_UPSTREAM_PASSWORD') }}{% endraw %}"
smtp_relay_sasl_user: "{% raw %}{{ lookup('ansible.builtin.env', 'SMTP_RELAY_USER') }}{% endraw %}"
smtp_relay_sasl_password: "{% raw %}{{ lookup('ansible.builtin.env', 'SMTP_RELAY_PASSWORD') }}{% endraw %}"

# CRITICAL: deltas over smtp_relay_default_config only - the role owns TLS,
# SASL, cert paths, mydestination and the submission service. Leave mynetworks
# at loopback-only: the LAN there is an open relay for every DHCP lease.
smtp_relay_config:
  # What Alertmanager and every null client submit to, so the relay must greet
  # under exactly that name.
  myhostname: "{{ smtp_host }}"
  # /etc/mailname, not the bare domain: the Debian package owns that file.
  myorigin: "/etc/mailname"
