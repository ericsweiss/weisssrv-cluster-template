---
# Bare-metal hypervisors (the `nas` + `compute` groups).

# Migration and replication run as root over SSH, so root key auth stays on here.
ssh_permit_root_login: "prohibit-password"

# Protect the web UI (:8006) from credential stuffing.
base_fail2ban_pveproxy_enabled: true

# Proxmox-only textfile collectors (cluster/quorum, guest state).
node_exporter_host_proxmox: true

# tlshd on every host: storage.cfg is cluster-wide and its NFS target needs TLS.
# Client mode only - the NAS overrides nfs_tls_is_server.
nfs_tls_enabled: true

# ZFS ARC ceiling in bytes on the compute hosts; the NAS sets its own. Empty
# leaves the ZFS default of about half of RAM. Example: 8589934592 (8 GiB).
zfs_arc_cap_max_bytes: ""

# 1Password vault holding the encrypted-pool passphrase items, asserted
# non-empty on any host declaring zfs_encryption_pools. docs/SETUP.md.
# zfs_encryption_connect_vault: ""

# Default-deny OUT on the node plus the sg-host-egress allowlist. Off so a first
# deploy cannot lock a host out of apt or the cluster. Guest egress is untouched.
proxmox_firewall_egress_filtering: false
# Ports sg-host-egress does not build in, such as a non-standard forge SSH port.
# proxmox_firewall_host_egress_extra_ports:
#   - {port: 2222, proto: tcp, comment: forge SSH}

# vfio_passthrough reconciles both ways: false also removes the drop-ins it
# owns, and a hand-written one is reported and kept. The GPU host overrides this
# inline in hosts.yml; the role fails on an empty vfio_passthrough_pci_ids.
vfio_passthrough_enabled: false
# vfio_passthrough_manage_absent: false
{%- if vpn_tailscale %}

# CRITICAL: apply the tailnet ACL before this role runs, or the advertised route
# is never approved.
tailscale_advertise_routes:
  - "{{ lan_cidr }}"
tailscale_advertise_tags:
  - "tag:subnet-router"
tailscale_additional_flags:
  - "--operator={{ admin_user }}"
  - "--ssh"

# Required for subnet routing; pve-firewall resets it, so nic_tuning persists it.
nic_tuning_ip_forward: true
{%- endif %}

# Proxmox HA (playbooks/proxmox-ha.yml), opt-in and empty by default: a moved
# guest needs its storage replicated to every node its rules allow.
proxmox_ha_resources: []
proxmox_ha_rules: []
proxmox_ha_replication_jobs: []
