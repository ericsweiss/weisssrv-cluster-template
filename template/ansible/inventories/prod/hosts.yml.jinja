---
{%- from "partials/roster.jinja" import n_compute, nas_name, smtp_name, resolvers,
    pve_hosts, n_srv, gpu_host, k3s_server_names, k3s_server_ips, k3s_agent_names,
    k3s_agent_ips with context %}
# Starter roster for {{ cluster_name }}: one NAS host, {{ n_compute }} compute host(s),
# {{ resolvers | length }} DNS resolver(s), one SMTP relay, and a {{ n_srv }}-server /
# {{ pve_hosts | length }}-agent k3s cluster. Guest vmid = 100 + last octet.

# Host prerequisites and the address plan: the template's PRE-SETUP.md,
# https://github.com/ericsweiss/weisssrv-cluster-template/blob/main/docs/PRE-SETUP.md.

# The hosts and VIPs named by an answer - {{ nas_name }}, {{ smtp_name }}, the
# resolvers and the three VIPs - are read by the Kubernetes layer too, so
# renaming one HERE alone is not enough. Everything else is a placeholder.

# Bands the answers are kept out of (copier.yml reserved_address_bands):
# {{ reserved_address_bands | map(attribute=2) | join('; ') }}

all:
  vars:
    ansible_user: {{ admin_user }}
    ansible_become: true
    ansible_python_interpreter: /usr/bin/python3

  children:
    # Bare-metal hypervisors. proxmox_role picks each guest's default storage
    # out of proxmox_storage_defaults (group_vars/all.yml).
    proxmox:
      children:
        nas:
        compute:
        # Hardware-trait groups (an e1000e_hosts, a small_ram_hosts) belong here
        # too, carrying per-trait tuning once. As children their group_vars
        # outrank group_vars/proxmox.yml; siblings only resolve alphabetically.

    nas:
      hosts:
        {{ pve_hosts[0] }}:
          ansible_host: {{ lan_prefix }}.11
          proxmox_role: nas
          # NFS-over-TLS server (the one host holding the wildcard cert+key);
          # every other host and guest is a TLS client.
          nfs_tls_is_server: true
          # Encrypted pools need a key load before guests can start, so an
          # unattended reboot can strand this host — maintenance defers it to an
          # operator. Set true once you have proven an unattended reboot.
          proxmox_self_reboot_safe: false
          firewall_ipsets:
            - pve_hosts
            - core-cluster
            - nfs_clients

    compute:
      hosts:
{%- for host in pve_hosts[1:] %}
        {{ host }}:
          ansible_host: {{ lan_prefix }}.{{ 11 + loop.index }}
          proxmox_role: compute
{%- if gpu == 'nvidia' and host == gpu_host %}
          # GPU passthrough host. REQUIRED: replace with the vendor:device IDs of
          # every function of your card (`lspci -nn`); the role blacklists the
          # in-tree driver and binds vfio-pci to them, then flags reboot-required.
          vfio_passthrough_enabled: true
          vfio_passthrough_pci_ids: []
{%- endif %}
          firewall_ipsets:
            - pve_hosts
            - core-cluster
            - nfs_clients
{%- endfor %}

    # Recursive resolvers (unbound behind AdGuard Home), one per host so a host
    # loss never takes them all; dns-01 is the config primary. These addresses ARE
    # the upstream_dns_servers answer - edit the answer, never this list.
    dns:
      hosts:
{%- for addr in resolvers %}
        dns-{{ '%02d' | format(loop.index) }}:
          ansible_host: {{ addr }}
          # vmid = 100 + last octet, per the scheme above. Re-addressing a
          # resolver moves its vmid — check it collides with nothing here.
          vmid: {{ 100 + addr.split('.')[-1] | int }}
          proxmox_host: {{ pve_hosts[loop.index % (pve_hosts | length)] }}
{%- if loop.first %}
          adguard_home_is_primary: true
          # Certificate authority: acme.sh, the renewal cron and the push
          # channel run HERE and nowhere else. A second resolver with this flag
          # would issue a competing wildcard (settings: group_vars/dns.yml).
          acme_certs_enabled: true
{%- if resolvers | length > 1 %}
          # Pushes this resolver's config to every replica.
          adguard_sync_enabled: true
{%- else %}
          # No second resolver to sync to. Add an address to
          # upstream_dns_servers and flip this to true.
          adguard_sync_enabled: false
{%- endif %}
{%- endif %}
          proxmox_resource_pool: infra-core
          proxmox_startup_order: 10
          proxmox_startup_delay: 10
          firewall_ipsets:
            - core-cluster
          guest_security_groups:
            - sg-vm-admin
            - sg-dns
            - sg-metrics
{%- endfor %}

    # Certificate distribution and the adguardhome-sync run from the primary
    # only; the plays address this group rather than a hostname.
    dns_primary:
      hosts:
        dns-01:

    mail:
      hosts:
        {{ smtp_name }}:
          ansible_host: {{ lan_prefix }}.23
          vmid: 123
          proxmox_host: {{ pve_hosts[1] if pve_hosts | length > 1 else pve_hosts[0] }}
          proxmox_resource_pool: infra-core
          proxmox_startup_order: 20
          proxmox_startup_delay: 10
          firewall_ipsets:
            - core-cluster
          guest_security_groups:
            - sg-vm-admin
            - sg-smtp-relay
            - sg-metrics
          # Guests honour policy_out (hosts do not): this flips the relay to
          # default-deny egress, enforcing the sg-smtp-relay OUT allowlist.
          guest_firewall_policy_out: "DROP"

    # k3s control plane. {{ n_srv }} server(s) — etcd tolerates one loss at three,
    # and only an ODD count adds fault tolerance. Each lands on a different host.
    k3s_servers:
      vars:
        k3s_role: server
        k3s_labels:
          {{ internal_domain }}/control-plane: "true"
        k3s_taints:
          - key: node-role.kubernetes.io/control-plane
            value: "true"
            effect: NoSchedule
      hosts:
{%- for name in k3s_server_names %}
        {{ name }}:
          ansible_host: {{ k3s_server_ips[loop.index0] }}
          vmid: {{ 130 + loop.index }}
          proxmox_host: {{ pve_hosts[loop.index0] }}
{%- if loop.first %}
          # Bootstraps the cluster (`cluster-init`); every other server joins it.
          k3s_is_first_server: true
          # CRITICAL: greenfield bootstrap only - delete this line once the
          # cluster is up. Left set, a rebuilt first server re-inits a NEW
          # cluster instead of rejoining the surviving quorum.
          k3s_bootstrap_new_cluster: true
{%- endif %}
          proxmox_resource_pool: platform
          proxmox_vm_cpu_type: host
          proxmox_vm_cores: 2
          proxmox_vm_memory: 6144
          proxmox_vm_disk_size: 64G
          proxmox_startup_order: 30
          proxmox_startup_delay: 10
          firewall_ipsets:
            - k3s_nodes
            - core-cluster
            - nfs_clients
          guest_security_groups:
            - sg-vm-admin
            - sg-k3s-core
            - sg-metrics
{%- endfor %}

    # One agent per host. Node labels are the scheduling contract the Kubernetes
    # manifests select on (they reference the same prefix through the
    # cluster-config ConfigMap), so renaming one here means renaming it there.
    k3s_agents:
      vars:
        k3s_role: agent
      hosts:
{%- for name in k3s_agent_names %}
{%- set agent_host = pve_hosts[loop.index0] %}
        {{ name }}:
          ansible_host: {{ k3s_agent_ips[loop.index0] }}
          vmid: {{ 140 + loop.index }}
          proxmox_host: {{ agent_host }}
          proxmox_resource_pool: platform
          proxmox_vm_cpu_type: host
          proxmox_vm_cores: 4
          proxmox_vm_memory: 8192
          proxmox_vm_disk_size: 64G
          proxmox_startup_order: 40
          proxmox_startup_delay: 10
{%- if loop.first %}
          # NAS-colocated agent (PreferNoSchedule, so it still takes overflow).
          # These three zvols back the prometheus-data, loki-data and
          # authentik-postgres-data hostPath PVs; never reorder scsi_slot.
          vm_additional_disks:
            - name: prometheus-data
              size: 150G
              zvol: ssd/appdata/prometheus/data
              mount_point: /mnt/prometheus-data
              fstype: ext4
              scsi_slot: 1
              sparse: true
              # Already captured by ZFS replication of ssd/appdata; without this
              # the nightly vzdump would store 150G of TSDB in the VM image too.
              vzdump_backup: false
            - name: loki-data
              size: 75G
              zvol: ssd/appdata/loki/data
              mount_point: /mnt/loki-data
              fstype: ext4
              scsi_slot: 2
              sparse: true
              vzdump_backup: false
            - name: postgres-data
              size: 10G
              zvol: ssd/appdata/authentik/postgres
              mount_point: /mnt/postgres-data
              fstype: ext4
              scsi_slot: 3
              sparse: true
              # The restorable copy is the nightly pg_dump on the NAS
              # (/backups-apps/authentik), not this block device.
              vzdump_backup: false
{%- endif %}
          k3s_labels:
            {{ internal_domain }}/general: "true"
            # The secret-detection job pins itself here via ci_cpu_selector; this label
            # is rendered from that answer, so the two cannot disagree.
            {{ ci_cpu_selector.split('=')[0] }}: "{{ ci_cpu_selector.split('=')[1] }}"
{%- if loop.first %}
            {{ internal_domain }}/nas: "true"
{%- endif %}
{%- if loop.first and pve_hosts | length < 3 %}
            # Ingress too: Traefik's HA floor and its PDB need two ingress nodes.
{%- endif %}
{%- if not loop.first or pve_hosts | length < 3 %}
            {{ internal_domain }}/ingress: "true"
{%- endif %}
{%- if gpu == 'nvidia' and agent_host == gpu_host %}
            # The nvidia-device-plugin and DCGM exporter select on this label;
            # only this node advertises nvidia.com/gpu.
            {{ internal_domain }}/gpu: "nvidia"
{%- endif %}
{%- if loop.first %}
          k3s_taints:
            - key: {{ internal_domain }}/nas
              value: "true"
              effect: PreferNoSchedule
{%- endif %}
{%- if gpu == 'nvidia' and agent_host == gpu_host %}
          # Installs the NVIDIA driver + container toolkit here (k3s role
          # tasks/gpu.yml) so k3s wires up the nvidia container runtime.
          k3s_gpu_node: true
          # REQUIRED: the PCI address of the card on {{ gpu_host }} (`lspci`).
          # Bare `0000:BB:DD` (no function) passes the whole device. Applied at
          # qm-create ONLY; an existing VM needs `qm set <vmid> --hostpci0 ...`.
          proxmox_vm_hostpci: []
{%- endif %}
          firewall_ipsets:
            - k3s_nodes
            - core-cluster
            - nfs_clients
          guest_security_groups:
            - sg-vm-admin
            - sg-k3s-core
{%- if not loop.first or pve_hosts | length < 3 %}
            - sg-k3s-ingress-int
            - sg-k3s-ingress-pub
{%- endif %}
            - sg-metrics
{%- endfor %}

    # Guests Ansible cannot log into (appliance images, Windows). Their tasks are
    # delegated to the Proxmox host, so each entry needs ansible_connection:
    # local, a vmid, a proxmox_host and guest_security_groups.
    services:
      # ansible_become: false lives in group_vars/services.yml.
      hosts: {}

    lxc_containers:
      children:
        dns:
        mail:

    k3s:
      children:
        k3s_servers:
        k3s_agents:

    # Hosts that get the base role (SSH hardening, packages, timezone, fail2ban).
    # k3s nodes get it from playbooks/k3s.yml instead, on their own lifecycle.
    base_managed:
      children:
        proxmox:
        dns:
        mail:

    # Application VMs/LXCs you add later, enrolled in rolling OS patching. Add
    # each app's own group as a child here.
    app_servers:
      hosts: {}
