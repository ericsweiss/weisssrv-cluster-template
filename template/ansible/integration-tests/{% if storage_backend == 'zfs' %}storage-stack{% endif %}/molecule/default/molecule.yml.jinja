---
{%- from "partials/molecule.jinja" import systemd_platform, galaxy_dependency,
    molecule_env, test_sequence with context %}
# nas_storage: NFS export and Samba share rendering, the Samba service and
# client access. Docker cannot mount NFS or CIFS, so the server side is the
# boundary. Scenario conventions: ansible/TESTING.md.

driver:
  name: docker

platforms:
  - name: nas-server
    # Shared systemd-container shape; SYS_ADMIN is the NAS server's alone.
    <<: &systemd_platform
{{- systemd_platform('storage-stack-net') }}
    capabilities:
      - SYS_ADMIN
    groups:
      - storage
      - nas_servers

  # Lists and reads the Samba shares; Docker cannot mount an NFS client.
  - name: smb-client-01
    <<: *systemd_platform
    groups:
      - storage
      - smb_clients

{{ galaxy_dependency() }}
provisioner:
  name: ansible
{{- molecule_env() }}
    # nas_storage_samba_password defaults to this env var and sets the `nas`
    # smbpasswd. Anonymous access is off, so verify authenticates with it.
    SAMBA_NAS_PASSWORD: molecule-test-samba-pw
  config_options:
    defaults:
      callbacks_enabled: profile_tasks, timer
      stdout_callback: ansible.builtin.default
      result_format: yaml
  playbooks:
    prepare: ../../../_shared/prepare.yml
    converge: converge.yml
    verify: verify.yml
  inventory:
    group_vars:
      nas_servers:
        # base runs as a nas_storage dependency. Its own scenario covers SSH
        # hardening, so this stack skips it.
        base_skip_ssh_config: true
        base_skip_dns_config: true  # DNS resolver needs real network

        # ZFS needs kernel modules; this also bypasses the bind-source guard.
        nas_storage_skip_zfs_operations: true
        # exportfs -ra fails without NFS kernel support.
        nas_storage_skip_nfs_reload: true
        # No block devices in a container.
        nas_storage_skip_smartd_service: true

        nas_storage_exports:
          # 1777: the SMB write test proves the share layer is writable; the
          # fixture dirs stay sticky-world-writable so no unix user plumbing
          # is needed in the container.
          - path: /tank/media
            mode: "1777"
            clients:
              - spec: "172.16.0.0/12"
                options: "rw,sync,no_subtree_check,no_root_squash"
          - path: /tank/share
            mode: "1777"
            clients:
              - spec: "172.16.0.0/12"
                options: "rw,sync,no_subtree_check,no_root_squash"
          # Prod-shaped export: bind_source under the pool mount, export-level
          # xprtsec=tls, fsid, all_squash mapping. verify.yml asserts the
          # rendered /etc/exports line.
          - path: /export/appdata
            bind_source: /mnt/tank/appdata
            owner: 1000
            group: 2000
            mode: "02775"
            xprtsec: "tls"
            clients:
              - spec: "172.16.0.0/12"
                options: "rw,sync,no_subtree_check,all_squash,anonuid=1000,anongid=2000,fsid=11"

        nas_storage_samba_shares:
          - name: media
            path: /tank/media
            comment: "Media Library"
            read_only: false
            browseable: true
            guest_ok: true
            create_mask: "0664"
            directory_mask: "0775"
          - name: share
            path: /tank/share
            comment: "Shared Files"
            read_only: false
            browseable: true
            guest_ok: true
            create_mask: "0664"
            directory_mask: "0775"

        # Mock ZFS mount points (created in converge)
        mock_zfs_mounts:
          - /tank/media
          - /tank/share

        # The smartd disk lists default to empty, so no device is needed.
        nas_storage_smartd_enabled: true

verifier:
  name: ansible

{{ test_sequence() }}
