{#- The .jinja suffix is load-bearing: a literal template/.gitignore would
    be applied by git to this template repository's own tree. -#}
# Secrets / local env — never commit these. NOT `*.env`: scripts/hosts.env is
# generated from the inventory and IS committed (CI diffs it), and a broad glob
# would silently drop it.
.env
.env.*
.tmp/

# Kubeconfigs — fetched from the cluster, never committed
kubeconfig
*.kubeconfig
.kube/

# Terraform state / plans. The provider lockfile IS committed — it belongs to
# the root module and pins what CI validates against.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
tfplan
tfplan.json
plan.out
# Local provider/backend overrides and crash dumps, never the committed state.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
# coverage.py: local `coverage run` / pytest --cov output.
.coverage
.coverage.*
coverage.xml
htmlcov/

# ansible caches (local ansible-lint / molecule runs)
.ansible/
.ansible-home/
*.retry
# An ansible-vault file is a committed secret; the vault password is not here.
ansible/inventories/*/host_vars/*/vault.yml
ansible/inventories/*/group_vars/*/vault.yml

# Installed collections. `task ansible:install-collections` puts weisssrv.infra
# here, and ansible-lint auto-installs it to the same place — either way it is
# fetched at the pinned lib_ref, never committed.
ansible_collections/

# Pinned weisssrv-lib checkout (`task lib:sync`) and the version checker's cache
.weisssrv-lib/
.version-cache/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
# Everything under .claude/ except the committed guardrails below.
# `.claude/*`, NOT `.claude/` — a directory pattern cannot be negated.
.claude/*
!.claude/settings.json
!.claude/skills/

# Git worktrees (multi-branch local working dirs)
.worktrees/

# State collection outputs (generated by task collect-state, not tracked)
cluster-state-*.txt
CLUSTER_STATUS.txt

# Secret material that the bring-up path places IN the repo root.
# flux:bootstrap-secrets reads ./1password-credentials.json, and SETUP tells
# you to `git add -A` in the same session — without these it lands in git.
1password-credentials.json
*.key
*.pem
*.tfvars
*.tfvars.json
crash.log
crash.*.log
**/secrets/

# CI dependency/tool cache dirs (PIP_CACHE_DIR, collections, lint toolchains)
.cache/

# Temporary files
*.tmp
*.temp
*.log
tmp/
temp/

# Helm chart pull scratch (created by the flux:lint helm validation runs)
.helm-tmp/
