---
# promtool unit tests for TenantVolumesFilling and TenantVolumesNearlyFull. Each
# fixture sits one point either side of a threshold; another mount and the host
# exporter's view of the same mount stay silent.
rule_files:
  - rules.yaml
evaluation_interval: 1m
tests:
  - interval: 1m
    input_series:
      # 11% free: warning, one point clear of critical.
      - series: 'node_filesystem_avail_bytes{job="node-exporter", instance="10.42.1.7:9100", mountpoint="/mnt/tenant-volumes"}'
        values: '11+0x30'
      - series: 'node_filesystem_size_bytes{job="node-exporter", instance="10.42.1.7:9100", mountpoint="/mnt/tenant-volumes"}'
        values: '100+0x30'
      # 9% free: both.
      - series: 'node_filesystem_avail_bytes{job="node-exporter", instance="10.42.1.8:9100", mountpoint="/mnt/tenant-volumes"}'
        values: '9+0x30'
      - series: 'node_filesystem_size_bytes{job="node-exporter", instance="10.42.1.8:9100", mountpoint="/mnt/tenant-volumes"}'
        values: '100+0x30'
      # 21% free: healthy, one point clear of warning.
      - series: 'node_filesystem_avail_bytes{job="node-exporter", instance="10.42.1.9:9100", mountpoint="/mnt/tenant-volumes"}'
        values: '21+0x30'
      - series: 'node_filesystem_size_bytes{job="node-exporter", instance="10.42.1.9:9100", mountpoint="/mnt/tenant-volumes"}'
        values: '100+0x30'
      # Another mount, nearly full: the generic disk alerts' business.
      - series: 'node_filesystem_avail_bytes{job="node-exporter", instance="10.42.1.9:9100", mountpoint="/"}'
        values: '5+0x30'
      - series: 'node_filesystem_size_bytes{job="node-exporter", instance="10.42.1.9:9100", mountpoint="/"}'
        values: '100+0x30'
      # The host exporter's view of a full mount: the DaemonSet already reports it.
      - series: 'node_filesystem_avail_bytes{job="node-exporter-host", instance="192.0.2.11:9101", mountpoint="/mnt/tenant-volumes"}'
        values: '5+0x30'
      - series: 'node_filesystem_size_bytes{job="node-exporter-host", instance="192.0.2.11:9101", mountpoint="/mnt/tenant-volumes"}'
        values: '100+0x30'
    alert_rule_test:
      # Inside each hold.
      - eval_time: 10m
        alertname: TenantVolumesFilling
        exp_alerts: []
      - eval_time: 3m
        alertname: TenantVolumesNearlyFull
        exp_alerts: []
      - eval_time: 20m
        alertname: TenantVolumesFilling
        exp_alerts:
          - exp_labels:
              severity: warning
              job: node-exporter
              instance: '10.42.1.7:9100'
              mountpoint: /mnt/tenant-volumes
          - exp_labels:
              severity: warning
              job: node-exporter
              instance: '10.42.1.8:9100'
              mountpoint: /mnt/tenant-volumes
      - eval_time: 10m
        alertname: TenantVolumesNearlyFull
        exp_alerts:
          - exp_labels:
              severity: critical
              job: node-exporter
              instance: '10.42.1.8:9100'
              mountpoint: /mnt/tenant-volumes
