---
# promtool tests for the base-backup age alerts at a 15m interval, because
# their windows are 30h and 54h.
rule_files:
  - rules.yaml
evaluation_interval: 15m
tests:
  - interval: 15m
    input_series:
      - series: 'barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{namespace="app", pod="app-db-1"}'
        values: '3600x260'
      - series: 'barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{namespace="other-app", pod="other-app-db-1"}'
        values: '0+900x260'
    alert_rule_test:
      - eval_time: 31h45m
        alertname: CNPGBaseBackupStale
        exp_alerts: []
      - eval_time: 32h30m
        alertname: CNPGBaseBackupStale
        exp_alerts:
          - exp_labels:
              severity: warning
              namespace: app
              pod: app-db-1
      - eval_time: 55h45m
        alertname: CNPGBaseBackupStaleCritical
        exp_alerts: []
      - eval_time: 56h30m
        alertname: CNPGBaseBackupStaleCritical
        exp_alerts:
          - exp_labels:
              severity: critical
              namespace: app
              pod: app-db-1
  # A timestamp of 0 is a database never backed up; it must fire too.
  - interval: 15m
    input_series:
      - series: 'barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{namespace="fresh", pod="fresh-db-1"}'
        values: '0x260'
    alert_rule_test:
      - eval_time: 30h45m
        alertname: CNPGBaseBackupStale
        exp_alerts: []
      - eval_time: 31h30m
        alertname: CNPGBaseBackupStale
        exp_alerts:
          - exp_labels:
              severity: warning
              namespace: fresh
              pod: fresh-db-1
      - eval_time: 54h45m
        alertname: CNPGBaseBackupStaleCritical
        exp_alerts: []
      - eval_time: 55h30m
        alertname: CNPGBaseBackupStaleCritical
        exp_alerts:
          - exp_labels:
              severity: critical
              namespace: fresh
              pod: fresh-db-1
