"""Coverage for check-unifi-doc-parity.py.

The live pair is in step, so it proves nothing about failure. Each arm runs
against a fixture pair, and every mutation case must FAIL.
"""
from __future__ import annotations

import textwrap
from pathlib import Path

import pytest
from conftest import REPO, load_script

gate = load_script("check-unifi-doc-parity.py")


MAIN_TF = textwrap.dedent(
    """\
    module "unifi" {
      site_settings = {
        # A comment naming auto_upgrade must not be parsed.
        auto_upgrade           = true
        ips_mode               = "ips"
        igmp_snooping_networks = ["home", "iot"]
      }
    }
    """
)

DOC = textwrap.dedent(
    """\
    ### Site settings

    | Setting | Value | Why |
    |---|---|---|
    | `mgmt.auto_upgrade` | `true` | nightly firmware |
    | `ips.ips_mode` | `"ips"` | inline blocking |
    | `igmp_snooping_networks` | `["home", "iot"]` | the casting path |

    ## Next section
    """
)


def write(root: Path, rel: str, body: str) -> None:
    path = root / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body)


@pytest.fixture
def repo(tmp_path: Path) -> Path:
    write(tmp_path, gate.MAIN_TF, MAIN_TF)
    write(tmp_path, gate.DOC, DOC)
    return tmp_path


def test_a_matching_pair_passes(repo: Path) -> None:
    assert gate.check(repo)[0] == []
    assert gate.main(["--repo-root", str(repo)]) == 0


def test_a_flipped_documented_value_fails(repo: Path) -> None:
    write(repo, gate.DOC, DOC.replace('`"ips"`', '`"ids"`'))
    problems, _ = gate.check(repo)
    assert any("ips_mode" in p for p in problems)
    assert gate.main(["--repo-root", str(repo)]) == 1


def test_a_flipped_terraform_value_fails(repo: Path) -> None:
    write(repo, gate.MAIN_TF, MAIN_TF.replace("auto_upgrade           = true", "auto_upgrade           = false"))
    assert any("auto_upgrade" in p for p in gate.check(repo)[0])


def test_a_reordered_list_is_still_a_difference(repo: Path) -> None:
    write(repo, gate.DOC, DOC.replace('`["home", "iot"]`', '`["iot", "home"]`'))
    assert any("igmp_snooping_networks" in p for p in gate.check(repo)[0])


def test_an_undocumented_setting_fails(repo: Path) -> None:
    write(repo, gate.DOC, DOC.replace("| `ips.ips_mode` | `\"ips\"` | inline blocking |\n", ""))
    assert any("which no docs/unifi-network.md" in p and "row names" in p for p in gate.check(repo)[0])


def test_two_matching_rows_are_ambiguous(repo: Path) -> None:
    write(repo, gate.DOC, DOC.replace(
        "| `igmp_snooping_networks` | `[\"home\", \"iot\"]` | the casting path |",
        "| `igmp_snooping_networks` | `[\"home\", \"iot\"]` | the casting path |\n"
        "| `site.igmp_snooping_networks` | `[\"home\"]` | a stale duplicate |",
    ))
    assert any("ambiguous" in p for p in gate.check(repo)[0])


IPS_LINE = '    ips_mode               = "ips"\n'


def _with_extra(body: str) -> str:
    assert IPS_LINE in MAIN_TF
    return MAIN_TF.replace(IPS_LINE, IPS_LINE + body)


def test_a_nested_map_is_not_a_setting(repo: Path) -> None:
    """Its opening line assigns `{`, which no docs row can ever match."""
    write(repo, gate.MAIN_TF, _with_extra("    nested = {\n      inner = 1\n    }\n"))
    assert "nested" not in gate.terraform_settings((repo / gate.MAIN_TF).read_text())
    assert gate.check(repo)[0] == []


def test_a_single_line_nested_map_is_still_a_setting(repo: Path) -> None:
    write(repo, gate.MAIN_TF, _with_extra("    nested = { inner = 1 }\n"))
    assert gate.terraform_settings((repo / gate.MAIN_TF).read_text())["nested"] == "{ inner = 1 }"


def test_a_hash_inside_a_quoted_value_is_not_a_comment(repo: Path) -> None:
    write(repo, gate.MAIN_TF, _with_extra('    banner = "lab #1" # trailing comment\n'))
    assert gate.terraform_settings((repo / gate.MAIN_TF).read_text())["banner"] == "lab #1"


def test_a_key_inside_a_longer_setting_name_does_not_match(repo: Path) -> None:
    """`mode` is a substring of `ips.ips_mode` but names no row of its own."""
    write(repo, gate.MAIN_TF, _with_extra("    mode = true\n"))
    problems = gate.check(repo)[0]
    assert any("sets mode" in p and "row names" in p for p in problems), problems


def test_an_enabled_suffix_still_names_the_key(repo: Path) -> None:
    write(repo, gate.MAIN_TF, _with_extra("    upnp = false\n"))
    write(repo, gate.DOC, DOC.replace(
        "| `ips.ips_mode`", "| `usg.upnp_enabled` | `false` | declared forwards |\n| `ips.ips_mode`"
    ))
    assert gate.check(repo)[0] == []


def test_a_missing_section_is_vacuous(repo: Path) -> None:
    write(repo, gate.DOC, "# Some other page\n")
    with pytest.raises(gate.Vacuous):
        gate.check(repo)
    assert gate.main(["--repo-root", str(repo)]) == 2


def test_a_missing_site_settings_map_is_vacuous(repo: Path) -> None:
    write(repo, gate.MAIN_TF, 'module "unifi" {\n}\n')
    with pytest.raises(gate.Vacuous):
        gate.check(repo)


def test_the_live_pair_is_in_step() -> None:
    assert gate.check(REPO)[0] == []
