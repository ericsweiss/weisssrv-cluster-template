# gitleaks allowlist for the {{ cluster_name }} cluster repository.
#
# Consumed by GitLab's secret_detection job (which uses gitleaks under the hood)
# through the passthrough in .gitlab/secret-detection-ruleset.toml — GitLab loads
# the ruleset from that fixed path and the passthrough points it here.
#
# docs are scanned normally: the `regexes` content allowlist below covers the
# placeholder SHAPES this tree uses (1Password op:// references, `[your-…]` and
# `<angle-bracket>` placeholders, the published supply-chain pins), so a real
# secret committed under docs/ is still caught.
#
# `useDefault = true` is REQUIRED — without it gitleaks loads only the rules
# defined in this file (which has none), disabling all detection.

title = "{{ cluster_name }} allowlist"

[extend]
useDefault = true

[[allowlists]]
description = "{{ cluster_name }} false positives"
regexes = [
  # 1Password reference URIs — not secrets, just pointers to vault items.
  '''op://[A-Za-z0-9_ /-]+''',
  # Documentation placeholders like [your-cloudflare-api-token].
  '''\[your-[a-z0-9-]+\]''',
  # Documentation placeholders written as <angle-bracket> tokens, e.g. the
  # `curl -u admin:<password>` example in the observability README. A literal
  # <…> is never real credential material.
  '''<[a-z][a-z0-9_-]*>''',
  # Test/fixture tokens — anchored at start of token so a real secret prefixed
  # with "prodtestkey_…" or similar can't be silenced.
  '''^(test|fake|dummy|example)[-_]?(password|token|key|secret)[A-Za-z0-9_-]*''',
  # Published supply-chain pins the CI templates verify downloaded key material
  # against (1Password's apt GPG fingerprint and its apk public key's sha256).
  # Both are public by construction but trip gitleaks' generic-api-key entropy
  # rule. Listed as exact values, so rotating a pinned key forces this allowlist
  # to be reviewed alongside it rather than silently covering the new material.
  '''^3FEF9748469ADBE15DA7CA80AC2D62742012EA22$''',
  '''^0e88171d9f8b7630763f70cbf69f2a01b4ba8ea1d8e79487f59c162db255eb84$''',
]

paths = [
  # Vendored galaxy dependency collections (gitignored; installed into the
  # tree by the ansible-lint flow) — third-party test fixtures are full of
  # dummy keys and are not ours to scan.
  '''\.ansible-home/''',
  '''ansible_collections/''',
]
