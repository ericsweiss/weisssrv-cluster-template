# GitLab Secret Detection custom ruleset, read only from
# `.gitlab/secret-detection-ruleset.toml`. A bare gitleaks.toml reaches the scan
# only through the passthrough below.
[secrets]
  description = "Secret Detection ruleset for {{ cluster_name }}"
  [[secrets.passthrough]]
    type = "file"
    target = "gitleaks.toml"
    value = ".gitleaks.toml"
