# GitLab Secret Detection custom ruleset for the {{ cluster_name }} cluster.
#
# GitLab's Secret-Detection job runs gitleaks under the hood, but
# `SECRET_DETECTION_RULESET_PATH` is not a documented GitLab variable and is
# silently ignored, so a bare gitleaks.toml has no effect. The supported
# mechanism is a `[[secrets.passthrough]]` entry in this file, at this exact
# path, pointing at the gitleaks config.
# https://docs.gitlab.com/ee/user/application_security/secret_detection/pipeline/#custom-rulesets-schema
[secrets]
  description = "Secret Detection ruleset for {{ cluster_name }}"
  [[secrets.passthrough]]
    type = "file"
    target = "gitleaks.toml"
    value = ".gitleaks.toml"
