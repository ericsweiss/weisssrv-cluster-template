{%- set lib_url_ = lib_url -%}
{%- set lib_project = lib_project | default(lib_url_.split('://')[1].split('/', 1)[1] | replace('.git', '')) -%}
{%- set runner_tag = ci_runner_tag | default('infrastructure') -%}
{%- set cpu_selector = ci_cpu_selector | default(internal_domain ~ '/cpu=modern') -%}
{%- set cluster_dir = 'kubernetes/clusters/' ~ cluster_name -%}
{%- set versions_cm = 'kubernetes/infrastructure/sources/versions-configmap.yaml' -%}
{#- SECRETS SEAM, the pipeline half of Taskfile.yml.jinja's. `secret_ref()`
    composes one reference, `secret_read()` the command that fetches one to
    stdout, and `secret_runner()` the wrapper that resolves the references a
    job's environment holds (emitted once, as $SECRET_RUNNER). Every credential
    site below emits their output, so a second backend is a branch here plus the
    matching `secrets_backend` choice in copier.yml. The else-branches subscript
    an empty mapping to hand `mandatory` an undefined value: an unimplemented
    backend fails the RENDER instead of generating a pipeline whose deploy jobs
    resolve nothing.

    One thing stays backend-specific by nature: the library deploy fragment
    included below fetches the SSH key with `op read` itself. A second backend
    replaces that include (docs/ci-pipeline.md § Backend seams). -#}
{%- macro secret_ref(item, field) -%}
{%- if secrets_backend == 'onepassword' -%}
op://{{ onepassword_vault }}/{{ item }}/{{ field }}
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no reference syntax — add a branch to secret_ref() in .gitlab-ci.yml.jinja') }}
{%- endif -%}
{%- endmacro -%}
{%- macro secret_read(item, field) -%}
{%- if secrets_backend == 'onepassword' -%}
op read "{{ secret_ref(item, field) }}"
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no fetch command — add a branch to secret_read() in .gitlab-ci.yml.jinja') }}
{%- endif -%}
{%- endmacro -%}
{%- macro secret_runner() -%}
{%- if secrets_backend == 'onepassword' -%}
op run --
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no host-side runner — add a branch to secret_runner() in .gitlab-ci.yml.jinja') }}
{%- endif -%}
{%- endmacro -%}
---
# CI for the {{ cluster_name }} cluster. Generic lint / validate / security /
# review jobs are pulled from {{ lib_project }} at a pinned ref; only the deploy
# jobs and the wiring below are local. See docs/ci-pipeline.md for the runner,
# schedule and credential prerequisites.
#
# `include: project:` resolves on THIS GitLab instance, so the library must
# exist here as {{ lib_project }} — mirror or fork it if the cluster does not
# live on the instance that hosts it.
stages:
  - lint
  - validate
  - test
  - security
  - ai-review
  - gate
  - deploy
  # Post-deploy verification, a SEPARATE stage rather than a deploy-stage job
  # with `needs:` on the deploys: a job that declares ANY `needs:` starts as soon
  # as those needs complete and ignores stage order, and a need that was created
  # and then FAILED blocks it (`optional: true` only tolerates one that was never
  # created). deploy-verify therefore carries NO `needs:` — stage order alone
  # sequences it — plus `when: always`, so a partly-failed deploy stage is still
  # verified instead of leaving the cluster unchecked.
  - verify
  - maintenance
{%- if enable_semantic_release | default(false) %}
  - release
{%- endif %}

# Settings every job inherits unless it says otherwise.
default:
  # PINNED, and stated here rather than left to the runner: a job with no image
  # runs on whatever the runner's config names as its default, which is neither
  # reviewable nor reproducible from this repository. The deploy fragment
  # apt-installs and pip-installs, so the image must be Debian-based with pip.
  image: python:3.13-slim
  # An UNTAGGED job goes to whichever runner accepts untagged work — the shared,
  # non-root, LAN-blocked one — where an apt-get and any SSH reach to the hosts
  # both fail. Every job below and every library include already carries this
  # tag; the default is what makes a forgotten one land correctly anyway.
  tags: ["{{ runner_tag }}"]
  # Cancel a superseded pipeline's jobs on a new commit — see the workflow
  # policy below. Deploys, the gate and the terraform plan/apply override this
  # to false; everything else is safe to interrupt.
  interruptible: true

workflow:
  # AUTHORITATIVE description of this pipeline's cancellation policy; jobs that
  # override `interruptible` point here rather than restating it.
  #
  # MR refs: `on_new_commit: interruptible` — a new push cancels the previous
  # pipeline's interruptible jobs instead of letting them pile up on a scarce
  # runner. GitLab's project default is "conservative", which stops cancelling as
  # soon as any non-interruptible job has started, so it leaves them running.
  #
  # main: `on_new_commit: none` (the rule below) — a merged pipeline always runs
  # to completion. Cancelling one would skip validation-gate and leave the first
  # merge's deploys unmet, with its `changes:` not re-covered by the second
  # pipeline. Rapid merges instead QUEUE at the deploy jobs' `resource_group`s,
  # which are per target and oldest-first.
  auto_cancel:
    on_new_commit: interruptible
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == "main"'
      auto_cancel:
        on_new_commit: none
    # version-bump-bot runs on a pipeline schedule; without this clause the
    # schedule creates no pipeline at all.
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
    - if: '$CI_PIPELINE_SOURCE == "web"'

variables:
  # Single source for the library pin. `include:` CANNOT read this — GitLab
  # resolves includes before job variables exist — so every entry below repeats
  # the tag as a literal and scripts/check-lib-pins.py (vendored from the
  # library, run by tests/test_lib_pins.py) fails the pipeline if one drifts or
  # pins a branch. Bump here, then `scripts/check-lib-pins.py --fix`.
  WEISSSRV_LIB_REF: "{{ lib_ref }}"
  # The project half of the same pin, so the gate checks the includes this
  # cluster actually resolves (a fork or mirror answers lib_project).
  LIB_PROJECT: "{{ lib_project }}"
  PYYAML_VERSION: "6.0.2"
  # Single source for the Ansible the local jobs pip-install. `include:` inputs
  # cannot read it (they resolve before this block exists), so the deploy-base
  # entry below repeats the literal — bump the two together.
  ANSIBLE_VERSION: "11.6.0"
  # The command that resolves the secret references in a job's environment. Every
  # deploy script goes through it rather than naming a backend's CLI, so the
  # `secrets_backend` seam has one runtime half and one render-time half (the
  # secret_ref macro that writes the references themselves).
  SECRET_RUNNER: "{{ secret_runner() }}"

include:
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/yaml-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      # -c .yamllint, not -d relaxed: the repo's config is what pre-commit and
      # `task lint` use, and a job that ignores it reports different findings.
      config: "-c .yamllint"
      targets: "ansible/ kubernetes/ terraform/ scripts/ .gitlab-ci.yml Taskfile.yml"
      changes:
        - "ansible/**/*"
        - "kubernetes/**/*"
        - "terraform/**/*"
        - "scripts/**/*.yml"
        - "Taskfile.yml"
        - ".yamllint"
        - ".gitlab-ci.yml"

  # collections_path is empty: this repo ships no in-repo collection, so the
  # only search path is the galaxy install of weisssrv.infra from requirements.yml.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/ansible-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      targets: "ansible/"
      collections_path: ""
      galaxy_requirements: "ansible/requirements.yml"
      # Full image, not slim: galaxy installs the collection from a git+ URL,
      # which needs the git executable.
      image: python:3.13
      changes:
        - "ansible/**/*"
        - ".ansible-lint"
        - ".ansible-lint-ignore"
        - ".gitlab-ci.yml"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/shellcheck.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      # terraform/*/*.sh is the SSO import helper, which is a real script and
      # not covered by the scripts/ glob.
      direct_globs: "scripts/*.sh terraform/*/*.sh"
      find_dir: ""
      changes:
        - "scripts/**/*.sh"
        - "terraform/**/*.sh"
        - ".gitlab-ci.yml"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/python-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      image: python:3.13-slim
      # kubernetes/ is in the list for the Python a manifest delivers through a
      # configMapGenerator (the DDNS CronJob's program): a real file so ruff can
      # see it, which an inlined heredoc could not be.
      targets: "scripts tests kubernetes"
      changes:
        - "scripts/**/*.py"
        - "tests/**/*.py"
        - "kubernetes/**/*.py"
        - "ruff.toml"
        - "pyproject.toml"
        - ".gitlab-ci.yml"

  # tests/ holds the cluster invariants (substitution coverage, no site literals
  # in the Kubernetes tree) and the library-pin gate. apt_packages is cleared and
  # the FULL python image used so the job stays runnable on a non-root runner.
  #
  # `changes:` must name every file the suite READS, not just the ones it lives
  # next to: test_lib_pins.py reads ansible/requirements.yml, Taskfile.yml and
  # terraform/*/*.tf to prove they pin the same library ref as this file's
  # `ref:`. Without those three entries an MR that bumps only a pin — the exact
  # change the gate exists for — never starts the job that would catch it.
  # test_cluster_invariants.py reads four more by the same rule:
  # ansible/inventories/prod/hosts.yml (the address-consistency asserts),
  # .copier-answers.yml (the site-values-not-in-the-k8s-tree assert, which
  # sources the literals to hunt for from the answers file), the whole
  # ansible/playbooks/ tree and scripts/deploy-coverage.conf (the playbook
  # gates: every playbook the Taskfile names exists, and every playbook is
  # mapped to a deploy job or acknowledged in the conf). Deleting or renaming a
  # playbook touches ONLY that tree, so without it the gate is silent on the
  # exact change it exists for.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/test/python-tests.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      image: python:3.13
      apt_packages: ""
      test_dir: "tests"
      changes:
        - "tests/**/*"
        - "kubernetes/**/*"
        - "scripts/**/*.py"
        - "ansible/requirements.yml"
        - "ansible/inventories/prod/hosts.yml"
        - "ansible/playbooks/**/*"
        - "scripts/deploy-coverage.conf"
        - ".copier-answers.yml"
        - "Taskfile.yml"
        - "terraform/**/*.tf"
        - ".gitlab-ci.yml"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/validate/terraform.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      fmt_dir: "terraform/"
      module_glob: "terraform/*/"
      changes:
        - "terraform/**/*"
        - ".gitlab-ci.yml"

  # Substitute mode mirrors what kustomize-controller does at reconcile time:
  # every ${placeholder} in a rendered Kustomization must resolve to a postBuild
  # ConfigMap key, and the result is kubeconform'd.
  #
  # flux_render_script is scripts/flux-env.sh, NOT the vendored flux-render.sh:
  # this cluster substitutes from TWO ConfigMaps (cluster-versions for pins,
  # cluster-config for domains/VIPs/CIDRs) while the library helper takes one
  # file per call, and flux-env.sh is the wrapper that adds the second. Passing
  # the vendored copy directly would forfeit every cluster_* key — and `task
  # flux:lint` calls flux-env.sh too, so both see identical variables.
  #
  # extra_validation runs the cluster-invariant gates the library ships against
  # the SAME rendered corpus kubeconform sees. Each one covers a class the
  # kustomize/kubeconform pass structurally cannot: the corpus never renders a
  # chart, so `.spec.values` is unvalidated; an HPA/VPA pair fighting over one
  # workload is schema-valid; a PVC with no storageClassName is rewritten by the
  # DefaultStorageClass admission plugin at create time; a scraped namespace
  # behind an ingress default-deny reports only as TargetDown; and a
  # ClusterSecretStore with no conditions is readable from every namespace.
  # `changes:` below therefore names the gate scripts and their policy files too
  # — a change that loosens one must run the job it loosens.
  # require_cluster_root is FALSE here because a freshly generated cluster has no
  # gotk-components.yaml / gotk-sync.yaml until `flux bootstrap` runs, and the
  # input defaults to true — which would fail the very first pipeline on a root
  # it cannot build yet. Flip it to true (or drop the line) once bootstrapped:
  # from then on it is the gate that fails a cluster which has LOST its
  # flux-system content, instead of silently skipping the build.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/validate/flux-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      substitute: true
      require_cluster_root: false
      cluster_dir: "{{ cluster_dir }}"
      versions_configmap: "{{ versions_cm }}"
      flux_render_script: "scripts/flux-env.sh"
      skipped_script: "scripts/kubeconform-skipped.py"
      extra_validation: 'echo "=== Checking HPA/VPA invariant ==="; python3 scripts/check-hpa-vpa-invariant.py --require-chart-native-vpas --policy-config scripts/autoscaling-policy.yaml < "$RENDER_ALL" || FAILED=1; echo "=== Checking scrape/NetworkPolicy invariant ==="; python3 scripts/check-scrape-netpol.py < "$RENDER_ALL" || FAILED=1; echo "=== Checking ingress default-deny coverage ==="; python3 scripts/check-default-deny-coverage.py < "$RENDER_ALL" || FAILED=1; echo "=== Checking ClusterSecretStore scoping ==="; python3 scripts/check-secretstore-scope.py < "$RENDER_ALL" || FAILED=1; echo "=== Checking PVC storageClassName ==="; python3 scripts/check-pvc-storageclass.py < "$RENDER_ALL" || FAILED=1; echo "=== Schema-validating HelmRelease values blocks (helm template) ==="; MERGED_CM=$(mktemp /tmp/merged-cm-XXXXXX.yaml); scripts/flux-env.sh merged-configmap "{{ versions_cm }}" > "$MERGED_CM" && python3 scripts/validate-helm-values.py --kubeconform --releases scripts/helm-values-releases.yaml --versions-configmap "$MERGED_CM" --policy-config scripts/autoscaling-policy.yaml || FAILED=1; rm -f "$MERGED_CM"'
      changes:
        - "kubernetes/**/*"
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/autoscaling-policy.yaml"
        - "scripts/helm-values-releases.yaml"
        - "scripts/check-hpa-vpa-invariant.py"
        - "scripts/check-scrape-netpol.py"
        - "scripts/check-default-deny-coverage.py"
        - "scripts/check-secretstore-scope.py"
        - "scripts/check-pvc-storageclass.py"
        - "scripts/validate-helm-values.py"
        - "scripts/flux-env.sh"
        - "scripts/kubeconform-skipped.py"
        - ".gitlab-ci.yml"

  # Doc-link rot: the checker is vendored (scripts/check-doc-links.py) and
  # `task lint:doc-links` runs it locally; this is the gate that makes it
  # mandatory rather than a habit.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/docs-link-check.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      changes:
        - "docs/**/*"
        - "README.md"
        - "**/README.md"
        - "scripts/check-doc-links.py"
        - ".gitlab-ci.yml"

  # Findings BLOCK (the library default). The paired allowlists ship
  # with the repo — .gitleaks.toml and .gitlab/secret-detection-ruleset.toml —
  # so the `op://` references and the published supply-chain sha256 pins this
  # tree is full of do not fail the job. Amend .gitleaks.toml (with a rationale)
  # rather than disabling the gate.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/security/secret-detection.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      cpu_selector: "{{ cpu_selector }}"

  # env mode: the two keys come from masked CI/CD variables, so the job needs no
  # 1Password CLI and no root. The gate means a pipeline without them simply has
  # no AI review rather than a red job.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/review/pr-agent.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      secrets_source: "env"
      gate: '$OPENAI__KEY && $GITLAB__PERSONAL_ACCESS_TOKEN'
      needs:
        - job: yaml-lint
          optional: true
        - job: ansible-lint
          optional: true
        - job: flux-lint
          optional: true
        - job: secret_detection
          optional: true

  # The READ-ONLY half of the version pair: reports what is available and changes
  # nothing, so an MR author sees pin drift while they are already looking at the
  # diff. The bot below is the other half, acting on drift when nobody is looking.
  # A repo wants both — this one needs no token and no schedule.
  #
  # The report is written even when the checker exits 1 ("updates available"),
  # because the redirect creates the file before the exit code exists. The -s
  # guard covers the other case: a checker that dies mid-run leaves an EMPTY
  # report, which uploads as a perfectly valid-looking artifact saying nothing is
  # available. That is the wrong answer delivered quietly, so it exits non-zero
  # instead — visible as a warning, since this job is soft-fail everywhere.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/maintenance/version-check.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      setup_command: "pip install --user --quiet pyyaml==$PYYAML_VERSION"
      check_command: >-
        python3 scripts/check-versions.py --json > "$REPORT_PATH"; RC=$?;
        [ -s "$REPORT_PATH" ] ||
        { echo "check-versions wrote no report (rc=$RC)"; exit 2; };
        exit "$RC"
      changes:
        - "ansible/inventories/prod/group_vars/all.yml"
        - "kubernetes/**/*"
        - ".gitlab-ci.yml"

  # Weekly pin refresh. Runs ONLY from a pipeline schedule (or a manual web run)
  # and needs $VERSION_BUMP_BOT_TOKEN — see docs/ci-pipeline.md for both.
  #
  # check_command is the non-interactive twin of `task maintenance:update-all-versions`
  # and runs the VENDORED scripts/check-versions.py, exactly as the Taskfile
  # does: the checker resolves its registry relative to its own parent's parent,
  # so a copy run out of a library checkout looks for the registry inside that
  # checkout and finds nothing. Keep the two in step — including --nested-key,
  # without which every helm_chart_versions_* key vanishes from the regenerated
  # ConfigMap.
  #
  # Exit-code handling mirrors the Taskfile rather than `|| true`: rc 1 is
  # "updates available" (information, and the whole point of the run) while rc 2
  # is a real failure that must turn the job red — a blanket `|| true` would
  # keep the weekly job green while it checked nothing.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/maintenance/version-bump-bot.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      setup_command: "pip install --user --quiet pyyaml==$PYYAML_VERSION"
      check_command: >-
        python3 scripts/check-versions.py --json > version-report.json ||
        { RC=$?; [ "$RC" -le 1 ] || exit "$RC"; };
        python3 scripts/check-versions.py --update-all || exit $?;
        python3 scripts/generate-versions-configmap.py
        --vars-file ansible/inventories/prod/group_vars/all.yml
        --output {{ versions_cm }}
        --nested-key helm_chart_versions
        --regen-command "task flux:sync-versions" || exit $?
      paths: "ansible/inventories/prod/group_vars/all.yml kubernetes/"
      report_path: "version-report.json"
      title: "chore(deps): {{ cluster_name }} version bumps"
{%- if enable_semantic_release | default(false) %}

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/release/semantic-release.yml
    inputs:
      tags: ["{{ runner_tag }}"]
{%- endif %}

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/templates/dep-cache.yml

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/templates/install-1password.yml

  # `.deploy-base` — the toolchain every Ansible deploy job extends: the op CLI
  # and dependency cache, a pinned Ansible, a 0600 ansible.cfg copy, the deploy
  # SSH key, a TOFU keyscan of scripts/hosts.env, and the collection install.
  # `apt_packages` defaults to `git`, which ansible-galaxy needs to install
  # weisssrv.infra from the `git+` source requirements.yml pins.
  #
  # This fragment is the 1Password-bound half of the `secrets_backend` seam: it
  # reads the SSH key with `op read` and exports the Loki push references. A
  # different backend replaces the include, not just the macros at the top of
  # this file.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/deploy/deploy-base.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      op_vault: "{{ onepassword_vault }}"
      ansible_version: "11.6.0"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/templates/terraform-http-backend.yml
    inputs:
      # ${CI_API_V4_URL} tracks the instance the pipeline runs on; TF_HTTP_PASSWORD
      # is the job token, which is only valid there.
      api_url: "${CI_API_V4_URL}"
      state_name: "{{ dns_backend }}"

# ==============================================================================
# Local jobs
# ==============================================================================

# The version-bump-bot below only reports pins that exist in
# scripts/version-registry.py. A pin added to all.yml without an entry there is
# never checked and never mentioned — the weekly job stays green while it
# silently skips it, which is the worst shape a security gate can take. This is
# the offline check that keeps the registry in step with the pins; it needs no
# credentials and no network, hence stage: lint rather than maintenance.
version-coverage:
  stage: lint
  image: python:3.13-slim
  tags: ["{{ runner_tag }}"]
  needs: []
  script:
    - python3 scripts/check-versions.py --check-coverage
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/version-registry.py"
        - "scripts/check-versions.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes:
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/version-registry.py"
        - "scripts/check-versions.py"
        - ".gitlab-ci.yml"
    - if: '$CI_PIPELINE_SOURCE == "web"'

# Two files in this repository are OUTPUTS, not sources: scripts/hosts.env is
# generated from the inventory and {{ versions_cm }} from
# group_vars/all.yml. Nothing else ever compares them against their source
# again — flux-lint substitutes FROM the ConfigMap, so it renders and passes on
# a stale pin, and the version-bump bot reads all.yml, so it reports that pin as
# current. The MR diff then shows only all.yml and the cluster keeps running the
# old version. This is the job that closes that: regenerate each file into a
# temp dir and diff. `task lint:repo-sync` is the identical local gate.
repo-sync:
  stage: lint
  image: python:3.13-slim
  tags: ["{{ runner_tag }}"]
  needs: []
  before_script:
    # --user, like every other unprivileged pip here: docs/ci-pipeline.md tells
    # the operator only the three privileged jobs need a root-capable runner,
    # and a bare `pip install` cannot write site-packages as non-root.
    - pip install --user --quiet "pyyaml==$PYYAML_VERSION"
  script:
    - |
      set -uo pipefail
      FAILED=0
      OUT=$(mktemp -d)

      python3 scripts/generate-hosts-env.py \
        --inventory ansible/inventories/prod/hosts.yml \
        --map scripts/hosts-env-map.yml \
        --output "$OUT/hosts.env" \
        --regen-command "task hosts:sync" >/dev/null
      if ! diff -u scripts/hosts.env "$OUT/hosts.env"; then
        echo "ERROR: scripts/hosts.env is out of sync with ansible/inventories/prod/hosts.yml"
        echo "Run: task hosts:sync and commit the result."
        FAILED=1
      fi

      python3 scripts/generate-versions-configmap.py \
        --vars-file ansible/inventories/prod/group_vars/all.yml \
        --output "$OUT/versions-configmap.yaml" \
        --nested-key helm_chart_versions \
        --regen-command "task flux:sync-versions" >/dev/null
      if ! diff -u {{ versions_cm }} "$OUT/versions-configmap.yaml"; then
        echo "ERROR: {{ versions_cm }} is out of sync with group_vars/all.yml"
        echo "Run: task flux:sync-versions and commit the result."
        FAILED=1
      fi
      exit $FAILED
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &repo_sync_paths
        - "ansible/inventories/prod/hosts.yml"
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/hosts.env"
        - "scripts/hosts-env-map.yml"
        - "scripts/generate-hosts-env.py"
        - "scripts/generate-versions-configmap.py"
        - "{{ versions_cm }}"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *repo_sync_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The LAN fence. Public egress is written as `ipBlock: {cidr: 0.0.0.0/0,
# except: [...]}` and the except-list is what keeps a compromised pod off the
# LAN, loopback and cloud-metadata ranges — repeated in every policy that needs
# it, because kustomize has no mechanism to share a list fragment. This compares
# each one against the canonical sets, and also catches the two edits that
# re-open the LAN without touching an except-list: an egress rule with no `to:`
# peers, and blocks that individually look specific but together contain a whole
# fenced range. Deliberate exceptions are declared in scripts/netpol-except.yaml
# with their reason.
#
# It reads the manifests on disk rather than the rendered corpus, so it also
# covers `kubernetes/clusters/*/flux-system/`, which no Kustomization builds.
netpol-parity:
  stage: lint
  image: python:3.13-slim
  tags: ["{{ runner_tag }}"]
  needs: []
  before_script:
    - pip install --user --quiet "pyyaml==$PYYAML_VERSION"
  script:
    - python3 scripts/check-netpol-except-parity.py --config scripts/netpol-except.yaml kubernetes/
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &netpol_parity_paths
        - "kubernetes/**/*"
        - "scripts/netpol-except.yaml"
        - "scripts/check-netpol-except-parity.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *netpol_parity_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The `changes:` list on a deploy job is a contract, and nothing else enforces
# it: a playbook or inventory path that no deploy job lists goes green on every
# MR while never actually deploying. This fails the MR that introduces the gap,
# and takes `scripts/deploy-coverage.conf` as the acknowledged-manual list
# (every entry there needs an inline rationale).
deploy-coverage:
  stage: lint
  # The FULL python image: the checker shells out to git, which python:*-slim
  # does not ship.
  image: python:3.13
  tags: ["{{ runner_tag }}"]
  needs: []
  variables:
    # The MR base commit must be in the local history for the diff to resolve.
    GIT_DEPTH: "0"
  script:
    - pip install --user --quiet "pyyaml==$PYYAML_VERSION"
    - bash scripts/check-deploy-coverage.sh
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - "ansible/**/*"
        - "scripts/deploy-coverage.conf"
        - ".gitlab-ci.yml"
    - if: '$CI_PIPELINE_SOURCE == "web"'

# Credential-free preflight over the deploy jobs themselves: every
# `ansible-playbook` invocation in a job extending .deploy-base names a playbook
# that exists, and every `--tags` selection reaches at least one task. A tag that
# matches nothing makes a deploy job a green no-op — the failure mode nothing
# else in this pipeline can see, because the play still exits 0.
deploy-preflight:
  stage: validate
  needs: []
  # The FULL python image: ansible-galaxy installs weisssrv.infra from a git+ URL.
  image: python:3.13
  tags: ["{{ runner_tag }}"]
  before_script:
    - apt-get update -qq && apt-get install -y -qq --no-install-recommends git
    - pip install --quiet "ansible==$ANSIBLE_VERSION" "pyyaml==$PYYAML_VERSION"
    - for i in 1 2 3; do ansible-galaxy collection install -r ansible/requirements.yml && break; [ "$i" = 3 ] && exit 1; echo "galaxy install failed (attempt $i) - retrying in 20s"; sleep 20; done
  script:
    - |
      python3 - <<'PREFLIGHT'
      import re
      import shlex
      import subprocess
      import sys
      from pathlib import Path

      import yaml

      class Loader(yaml.SafeLoader):
          pass

      # The pipeline uses !reference throughout; resolve every unknown tag to None.
      Loader.add_multi_constructor("!", lambda *_: None)

      ANSIBLE_DIR = Path("ansible")
      pipeline = yaml.load(Path(".gitlab-ci.yml").read_text(), Loader=Loader)

      VALUE_FLAGS = ("-i", "--inventory", "--inventory-file", "-e", "--extra-vars")

      def invocations(text):
          """Every `ansible-playbook` call in a job's script -> (inventory, playbook, argv).

          Read the argv rather than a fixed argument ORDER: both
          `-i <inv> <playbook>` and `-i <inv> -e "..." <playbook>` occur, and a
          YAML flow scalar can fold two calls onto one line.
          """
          found = []
          for segment in text.split("ansible-playbook")[1:]:
              # The next shell command is not part of this argv.
              segment = re.split(r"[;&|\n]", segment, maxsplit=1)[0]
              try:
                  tokens = shlex.split(segment)
              except ValueError:
                  # An unbalanced quote is the tail of the enclosing `bash -c '...'`.
                  tokens = segment.replace('"', " ").replace("'", " ").split()
              inventory = None
              playbook = None
              index = 0
              while index < len(tokens):
                  token = tokens[index]
                  if token in VALUE_FLAGS:
                      if token.startswith("-i") or token.startswith("--inventory"):
                          inventory = tokens[index + 1] if index + 1 < len(tokens) else None
                      index += 2
                      continue
                  if playbook is None and not token.startswith("-") and token.endswith(".yml"):
                      playbook = token
                  index += 1
              if playbook:
                  found.append((inventory, playbook, " ".join(tokens)))
          return found

      TAGS = re.compile(r"--(?:skip-)?tags[= ]+(?P<tags>[A-Za-z0-9_,.-]+)")
      # `--list-tasks` prints one `TAGS: [a, b]` per selected task. `always` tasks
      # are printed for ANY selection, so output alone proves nothing — the
      # requested tag must appear in a task's own tag list.
      TASK_TAGS = re.compile(r"TAGS: \[([^\]]*)\]")

      failures = []
      playbooks = set()
      selections = 0

      for name, job in pipeline.items():
          if not isinstance(job, dict) or name.startswith("."):
              continue
          # extends is a string OR a list; a job naming several parents must not
          # slip the preflight.
          parents = job.get("extends") or []
          if isinstance(parents, str):
              parents = [parents]
          if not {".deploy-base", ".maintenance-base"}.intersection(parents):
              continue
          script = "\n".join(str(line) for line in job.get("script") or [])
          parsed = invocations(script)
          # Refuse to shrink silently: a shape the parser cannot read would cost
          # coverage with no output at all.
          written = script.count("ansible-playbook")
          if len(parsed) < written:
              failures.append(
                  f"{name}: parsed {len(parsed)} of {written} `ansible-playbook` "
                  "invocation(s) - this job is written in a shape the preflight "
                  "parser does not understand, so its playbook/tag checks were "
                  "skipped. Fix invocations() rather than the job."
              )
          for inventory, playbook, argv in parsed:
              if not (ANSIBLE_DIR / playbook).is_file():
                  failures.append(f"{name}: playbook ansible/{playbook} does not exist")
                  continue
              playbooks.add(playbook)
              tags = sorted({
                  t
                  for m in TAGS.finditer(argv)
                  for t in m.group("tags").split(",")
                  if t
              })
              # A job may omit `-i` and take ansible.cfg's default inventory.
              # Omitting the flag reproduces that; `-i None` is a TypeError.
              inventory_argv = ["-i", inventory] if inventory else []
              for tag in tags:
                  selections += 1
                  proc = subprocess.run(
                      ["ansible-playbook", *inventory_argv, playbook,
                       "--list-tasks", "--tags", tag],
                      cwd=ANSIBLE_DIR, capture_output=True, text=True,
                  )
                  if proc.returncode != 0:
                      failures.append(
                          f"{name}: --list-tasks failed for {playbook} --tags {tag}\n"
                          f"{proc.stderr.strip()}"
                      )
                      continue
                  selected = any(
                      tag in [t.strip() for t in m.group(1).split(",")]
                      for m in TASK_TAGS.finditer(proc.stdout)
                  )
                  if selected:
                      print(f"OK   {name}: {playbook} --tags {tag}")
                  else:
                      failures.append(
                          f"{name}: `--tags {tag}` on {playbook} selects NO task - "
                          "that deploy step is a silent no-op"
                      )

      if not playbooks:
          failures.append(
              "preflight resolved 0 playbooks - candidate-job selection or "
              "invocation parsing is no longer inspecting the deploy jobs"
          )

      # The starter deploy jobs run whole playbooks, so 0 tag selections is the
      # expected state, not a fault - it only means the no-op-tag guard had
      # nothing to inspect.
      print(f"\n{len(playbooks)} playbook(s), {selections} tag selection(s) checked")
      if failures:
          print("", file=sys.stderr)
          for f in failures:
              print(f"FAIL {f}", file=sys.stderr)
          sys.exit(1)
      PREFLIGHT
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &deploy_preflight_paths
        # Everything the answer depends on: the playbooks and tags it walks, the
        # inventory `--list-tasks` parses, the collection pin it installs, and the
        # deploy jobs it reads the invocations out of.
        - "ansible/playbooks/**/*"
        - "ansible/inventories/prod/**/*"
        - "ansible/requirements.yml"
        - "ansible/ansible.cfg"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *deploy_preflight_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# ==============================================================================
# GATE STAGE — the single dependency every deploy job carries.
#
# Stage order alone does NOT gate a deploy job that declares `needs:`, and a job
# whose every needs: entry was DROPPED (the needed job's rules excluded it) has
# an EMPTY needs set, which GitLab starts immediately — before its own stage.
# Deploy jobs therefore need THIS job non-optionally rather than naming lint
# jobs directly: it always exists on a main pipeline, so the needs set is never
# empty and stage order is never bypassed.
# https://docs.gitlab.com/ci/yaml/#needsoptional
#
# Path-filtered jobs are listed optional; secret_detection has no path filter
# and always runs on main, which is what keeps this gate's own needs set
# non-empty. The drift plans and pr-agent-review are `allow_failure: true` and
# so could never block anything.
validation-gate:
  stage: gate
  image: alpine:3.23
  tags: ["{{ runner_tag }}"]
  # A newer commit must not auto-cancel this gate mid-run: the first pipeline's
  # not-yet-started deploy jobs all need it, and would be orphaned.
  interruptible: false
  needs:
    # Path-filtered (may not exist in this pipeline)
    - job: yaml-lint
      optional: true
    - job: ansible-lint
      optional: true
    - job: shellcheck
      optional: true
    - job: python-lint
      optional: true
    - job: python-tests
      optional: true
    - job: flux-lint
      optional: true
    - job: docs-link-check
      optional: true
    - job: terraform-fmt
      optional: true
    - job: terraform-validate
      optional: true
    - job: terraform-plan
      optional: true
    - job: version-coverage
      optional: true
    - job: repo-sync
      optional: true
    - job: deploy-coverage
      optional: true
    - job: deploy-preflight
      optional: true
    - job: netpol-parity
      optional: true
    # Always created on a main pipeline (no path filter)
    - job: secret_detection
  script:
    # Every deploy job gates on `$CI_COMMIT_BRANCH == "main" &&
    # $OP_SERVICE_ACCOUNT_TOKEN`. With the token unset or empty those jobs are
    # never CREATED, so main goes green having deployed nothing. This gate has no
    # token clause of its own, so it is the one place that can say so out loud.
    - |
      if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
        echo "ERROR: OP_SERVICE_ACCOUNT_TOKEN is unset/empty on a main pipeline." >&2
        echo "       Every deploy job gates on it and was silently skipped," >&2
        echo "       deploying nothing while the pipeline reports success." >&2
        echo "       Set the CI/CD variable (masked, protected) and re-run." >&2
        exit 1
      fi
    - echo "All applicable checks passed - deploy jobs may proceed"
  # These rules MUST stay a superset of every deploy job's: a deploy job needing
  # a gate that was not created fails pipeline CREATION. Deploy jobs are
  # main-only and skip schedules, so this is that set without the token clause
  # (the gate itself needs no credentials).
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main"'

# ==============================================================================
# Deploy — starter set. One job per playbook, gated to main + a changes list, so
# a merge deploys exactly what it touched. Every job needs validation-gate
# (non-optional). Adding a playbook means adding a job: the pattern is
# documented in docs/ci-pipeline.md. `.deploy-base` itself comes from the
# library (see the include above).
# ==============================================================================

# Each job's `variables:` mirror the matching Taskfile task's `env:`, minus the
# Loki push pair that `.deploy-base` declares for every deploy. $SECRET_RUNNER
# resolves EVERY reference in the environment, so a job declares what its
# playbook needs and nothing more — an item the vault lacks is a hard failure,
# not an unused variable.
# Runs site.yml, the full host stack — the CI twin of `task infra:deploy`. It
# has to: its trigger list includes the whole inventory and the roles site.yml
# adds on top of base.yml (Proxmox host config, certs, firewall, host metrics
# and log shipping), and a job that ran only base.yml would report a green
# deploy for changes it never applied. The three group jobs below are the fast
# path for a change scoped to one group.
deploy-ansible-base:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-base
  needs:
    - job: validation-gate
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    SMTP_UPSTREAM_USER: "{{ secret_ref('SMTP Smarthost', 'username') }}"
    SMTP_UPSTREAM_PASSWORD: "{{ secret_ref('SMTP Smarthost', 'password') }}"
    ADGUARD_ADMIN_PASSWORD: "{{ secret_ref('AdGuard Home', 'password') }}"
    SAMBA_NAS_PASSWORD: "{{ secret_ref('Samba NAS User', 'password') }}"
    ACME_SSH_PRIVATE_KEY: "{{ secret_ref('Cert Distribution Key', 'private key') }}"
    ACME_SSH_PUBLIC_KEY: "{{ secret_ref('Cert Distribution Key', 'public key') }}"
{%- if vpn_tailscale %}
    TAILSCALE_AUTH_KEY: "{{ secret_ref('Tailscale Auth Key', 'credential') }}"
{%- endif %}
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/site.yml
  environment:
    name: production/ansible-base
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        # Cluster-wide inventory. The per-group group_vars files belong to the
        # group jobs below, so a DNS-only edit does not re-run every host.
        - "ansible/inventories/prod/hosts.yml"
        - "ansible/inventories/prod/group_vars/all.yml"
        - "ansible/inventories/prod/group_vars/proxmox.yml"
        - "ansible/inventories/prod/host_vars/**/*"
        - "ansible/playbooks/base.yml"
        - "ansible/playbooks/site.yml"
        - "ansible/requirements.yml"

# The DNS stack alone — the CI twin of `task dns:deploy`. dns.yml runs one
# resolver at a time, so a bad change never takes both down at once.
deploy-ansible-dns:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-dns
  needs:
    - job: validation-gate
    # Ordering only: base is not created for a DNS-only change, so this must
    # stay optional — validation-gate above is what actually gates the deploy.
    - job: deploy-ansible-base
      optional: true
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    ADGUARD_ADMIN_PASSWORD: "{{ secret_ref('AdGuard Home', 'password') }}"
    ACME_SSH_PRIVATE_KEY: "{{ secret_ref('Cert Distribution Key', 'private key') }}"
    ACME_SSH_PUBLIC_KEY: "{{ secret_ref('Cert Distribution Key', 'public key') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/dns.yml
  environment:
    name: production/ansible-dns
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "ansible/inventories/prod/group_vars/dns.yml"
        - "ansible/playbooks/dns.yml"

# The NAS alone — the CI twin of `task storage:deploy`. Add the restic
# references here too when you enable the offsite backup role.
deploy-ansible-storage:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-storage
  needs:
    - job: validation-gate
    # Ordering only — see deploy-ansible-dns.
    - job: deploy-ansible-base
      optional: true
  variables:
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SAMBA_NAS_PASSWORD: "{{ secret_ref('Samba NAS User', 'password') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/storage.yml
  environment:
    name: production/ansible-storage
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "ansible/inventories/prod/group_vars/nas.yml"
        - "ansible/playbooks/storage.yml"

# The SMTP relay alone. Every host's null client submits through it, so a relay
# change is worth deploying without re-running the whole stack.
deploy-ansible-mail:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-mail
  needs:
    - job: validation-gate
    # Ordering only — see deploy-ansible-dns.
    - job: deploy-ansible-base
      optional: true
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    SMTP_UPSTREAM_USER: "{{ secret_ref('SMTP Smarthost', 'username') }}"
    SMTP_UPSTREAM_PASSWORD: "{{ secret_ref('SMTP Smarthost', 'password') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/mail.yml
  environment:
    name: production/ansible-mail
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "ansible/inventories/prod/group_vars/mail.yml"
        - "ansible/playbooks/mail.yml"

# Manual: a k3s change can restart the control plane, so an operator triggers it
# after reading the diff.
deploy-ansible-k3s:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-k3s
  needs:
    - job: validation-gate
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    K3S_TOKEN: "{{ secret_ref('K3s Cluster Token', 'credential') }}"
    # Agents join with the lower-privilege worker token the servers advertise.
    K3S_AGENT_TOKEN: "{{ secret_ref('K3s Agent Token', 'credential') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/k3s.yml
  environment:
    name: production/k3s
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "ansible/inventories/prod/hosts.yml"
        - "ansible/inventories/prod/group_vars/all.yml"
        - "ansible/inventories/prod/group_vars/k3s.yml"
        - "ansible/playbooks/k3s.yml"
        - "ansible/playbooks/k3s-provision-vms.yml"
      when: manual
      allow_failure: false

# Every Terraform module sources the library over `git::https://`, so `init`
# needs a git credential. GIT_CONFIG_* is the env form of `git config --global`,
# which keeps this a variables-only fragment the library's own terraform-validate
# job can extend without its script being rewritten.
#
# Scoped to {{ git_host }} — this pipeline's OWN instance — on purpose:
# CI_JOB_TOKEN is only valid where it was issued, so rewriting any other host's
# URLs would send the token off-instance for nothing. It reaches
# {{ lib_project }} only if that project's job-token allowlist includes this one,
# or it is public. A library hosted elsewhere needs its own credential (a netrc
# entry or a deploy token) instead; mirroring it here is the simpler answer, and
# the `include:` block already requires that.
.terraform-git-credential:
  tags: ["{{ runner_tag }}"]
  variables:
    GIT_CONFIG_COUNT: "1"
    GIT_CONFIG_KEY_0: "url.https://gitlab-ci-token:${CI_JOB_TOKEN}@{{ git_host }}/.insteadOf"
    GIT_CONFIG_VALUE_0: "https://{{ git_host }}/"

# Keys-only override of the library's terraform-validate job: it runs
# `terraform init -backend=false`, which still fetches the modules. The tag
# repeats what the include's `tags` input already passes.
terraform-validate:
  extends: .terraform-git-credential
  tags: ["{{ runner_tag }}"]
{% if dns_backend == 'cloudflare' %}
# Pre-merge preview of the zone change, and the plan deploy-terraform applies.
# The directory is the literal `terraform/cloudflare` the payload ships, and the
# pair of jobs is gated on the answer instead — composing the path from
# `dns_backend` would render a pipeline pointing at a directory no render
# creates, failing at `cd` instead of at generation time.
terraform-plan:
  stage: validate
  extends: [.terraform-http-backend, .terraform-git-credential]
  needs: []
  tags: ["{{ runner_tag }}"]
  # A cancelled plan leaves deploy-terraform with no artifact to apply.
  interruptible: false
  image:
    name: hashicorp/terraform:1.15
    entrypoint: [""]
  before_script:
    - !reference [.install-1password-alpine, before_script]
  script:
    - cd terraform/cloudflare
    # -lockfile=readonly: provider hashes are committed; CI rewriting them would
    # mask supply-chain drift.
    - terraform init -lockfile=readonly
    - |
      export TF_VAR_cloudflare_api_token=$({{ secret_read("Cloudflare Terraform Token", "credential") }})
      export TF_VAR_cloudflare_account_id=$({{ secret_read("Cloudflare Terraform Token", "username") }})
      terraform plan -input=false -no-color -lock-timeout=120s -out=tfplan
    # Change counts for the merge request's Terraform widget.
    - |
      terraform show -json tfplan | jq -r '
        ([.resource_changes[]?.change.actions?]|flatten)|
        {"create":(map(select(.=="create"))|length),
         "update":(map(select(.=="update"))|length),
         "delete":(map(select(.=="delete"))|length)}
      ' > tfplan.json
  artifacts:
    # The binary plan embeds rendered resource attributes, including anything a
    # provider does not mark sensitive; restrict download to developer+.
    # deploy-terraform still gets it through needs:artifacts, which `access`
    # does not gate.
    access: developer
    paths:
      - terraform/cloudflare/tfplan
    reports:
      terraform: terraform/cloudflare/tfplan.json
    # A day, not an hour: deploy-terraform is a manual job in a later stage and
    # the plan must still exist when someone presses it.
    expire_in: 1 day
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    # This is the only job that reads the secret store on a merge-request ref.
    # It earns that because it is the only pre-merge view of a change an
    # operator then applies from main. Marking OP_SERVICE_ACCOUNT_TOKEN
    # protected removes the plan from merge requests; a tokenless pipeline gets
    # no plan at all, which is a skip, not a clean plan.
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "terraform/cloudflare/**/*"
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "terraform/cloudflare/**/*"

deploy-terraform:
  stage: deploy
  extends: [.terraform-http-backend, .terraform-git-credential]
  # Same reasoning as .deploy-base: .install-1password-alpine installs a package
  # and this job holds a live API token, so it belongs on the privileged runner.
  tags: ["{{ runner_tag }}"]
  interruptible: false
  image:
    name: hashicorp/terraform:1.15
    entrypoint: [""]
  # validation-gate first, so the lint/validate/test stages gate the apply;
  # terraform-plan second, to fetch the saved plan. Both needs are NON-optional:
  # terraform-plan carries the same rules as this job, so the plan always exists
  # when this one is offered, and an optional entry here could be dropped and
  # leave the apply reaching for an artifact that is not there.
  needs:
    - job: validation-gate
    - job: terraform-plan
      artifacts: true
  before_script:
    - !reference [.install-1password-alpine, before_script]
  script:
    - cd terraform/cloudflare
    # -lockfile=readonly: provider hashes are committed; CI rewriting them would
    # mask supply-chain drift.
    - terraform init -lockfile=readonly
    # Applies the SAVED plan, so what ships is what the merge request showed.
    # A fresh apply-time plan could delete a record nobody reviewed.
    - |
      export TF_VAR_cloudflare_api_token=$({{ secret_read("Cloudflare Terraform Token", "credential") }})
      export TF_VAR_cloudflare_account_id=$({{ secret_read("Cloudflare Terraform Token", "username") }})
      terraform apply -auto-approve -lock-timeout=120s tfplan
  environment:
    name: production/cloudflare
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "terraform/cloudflare/**/*"
      when: manual
      allow_failure: false
{% endif %}
{%- if vpn_tailscale %}
# Read-only drift plan for the tailnet ACL. It never applies — that stays
# supervised (terraform/tailscale/README.md) — so a console hot-fix would
# otherwise sit undetected until someone happened to plan. Exit-code and state
# handling as in authentik-drift-plan below.
tailscale-drift-plan:
  stage: validate
  extends: [.terraform-http-backend, .terraform-git-credential]
  needs: []
  tags: ["{{ runner_tag }}"]
  image:
    name: hashicorp/terraform:1.15
    entrypoint: [""]
  variables:
    TF_HTTP_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/tailscale"
    TF_HTTP_LOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/tailscale/lock"
    TF_HTTP_UNLOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/tailscale/lock"
  before_script:
    - !reference [.install-1password-alpine, before_script]
  script:
    - cd terraform/tailscale
    - terraform init -lockfile=readonly
    - |
      export TF_VAR_tailscale_oauth_client_id=$({{ secret_read("Tailscale OAuth", "client id") }})
      export TF_VAR_tailscale_oauth_client_secret=$({{ secret_read("Tailscale OAuth", "credential") }})
      terraform plan -input=false -no-color -lock-timeout=120s -detailed-exitcode
  allow_failure: true
  rules:
    # The schedule is the real detector: no changes: filter, so it catches an
    # admin-console edit made when nothing in-repo moved.
    - if: '$CI_PIPELINE_SOURCE == "schedule" && $OP_SERVICE_ACCOUNT_TOKEN'
    # Post-merge, before the supervised apply. No merge_request_event rule:
    # this materializes vault secrets into a job running an unmerged branch's
    # own code, and an advisory signal does not justify that.
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "terraform/tailscale/**/*"
{% endif %}
# Read-only drift plan for the SSO objects. The apply is `task
# terraform:authentik-apply`, which refuses to run non-interactively, so this
# job is the only thing that notices an admin-UI edit. -detailed-exitcode exits
# 2 on a non-empty diff (a plain plan exits 0), which is what makes
# allow_failure render drift as a warning rather than a pass. Own state name,
# so the three TF_HTTP_*ADDRESS vars are overridden.
#
# Add a TF_VAR_ line here for every client-secret variable you add — a missing
# one fails the plan, which is the intended behaviour, not drift.
authentik-drift-plan:
  stage: validate
  extends: [.terraform-http-backend, .terraform-git-credential]
  needs: []
  tags: ["{{ runner_tag }}"]
  image:
    name: hashicorp/terraform:1.15
    entrypoint: [""]
  variables:
    TF_HTTP_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/authentik"
    TF_HTTP_LOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/authentik/lock"
    TF_HTTP_UNLOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/authentik/lock"
  before_script:
    - !reference [.install-1password-alpine, before_script]
  script:
    - cd terraform/authentik
    - terraform init -lockfile=readonly
    - |
      export TF_VAR_authentik_token=$({{ secret_read("Authentik Terraform Token", "credential") }})
      export TF_VAR_oauth2_client_secret_grafana=$({{ secret_read("Grafana SSO", "oidc-client-secret") }})
      terraform plan -input=false -no-color -lock-timeout=120s -detailed-exitcode
  allow_failure: true
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule" && $OP_SERVICE_ACCOUNT_TOKEN'
    # No merge_request_event rule: this job reads every OIDC client secret.
    - if: '$CI_COMMIT_BRANCH == "main" && $OP_SERVICE_ACCOUNT_TOKEN'
      changes:
        - "terraform/authentik/**/*"

# ==============================================================================
# VERIFY STAGE — read-only, runs after the deploy stage whatever it did.
# ==============================================================================

# The postflight play: SSH reachability, disk headroom, service state, on every
# managed host. It extends .deploy-base for the SSH key and the collection, and
# changes nothing — a failure here means the deploy left the fleet in a state
# the assertions reject.
#
# `when: always` is relative to the WHOLE pipeline, not just the deploy stage: on
# a main pipeline that matches the rules below but fails at lint or validate, the
# deploys are blocked by validation-gate and this job still runs, verifying hosts
# nothing was deployed to. It is read-only, so that is a second failure surface
# on an already-red pipeline rather than a risk — no rule can see gate status.
deploy-verify:
  stage: verify
  when: always
  extends: .deploy-base
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/postflight.yml
  environment:
    name: production/verify
  # Each deploy job's rules verbatim, so this job appears if and only if at least
  # one deploy job does and the two trigger sets cannot drift. Rules are
  # first-match-wins and every block starts with the same schedule guard, so
  # schedules stay excluded; a manual deploy's rule makes this manual too.
  rules:
    - !reference [deploy-ansible-base, rules]
    - !reference [deploy-ansible-dns, rules]
    - !reference [deploy-ansible-storage, rules]
    - !reference [deploy-ansible-mail, rules]
    - !reference [deploy-ansible-k3s, rules]
{%- if dns_backend == 'cloudflare' %}
    - !reference [deploy-terraform, rules]
{%- endif %}
