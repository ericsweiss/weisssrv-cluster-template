{%- set runner_tag = ci_runner_tag -%}
{%- set cpu_selector = ci_cpu_selector -%}
{#- Exact patch tag: a two-component tag floats, so a Terraform minor release
    lands mid-pipeline between plan and apply. -#}
{%- set terraform_image = 'hashicorp/terraform:1.15.9' -%}
{%- set cluster_dir = 'kubernetes/clusters/' ~ cluster_name -%}
{%- set versions_cm = 'kubernetes/infrastructure/sources/versions-configmap.yaml' -%}
{#- Every host the starter inventory names, so a host_vars file gets literal
    coverage: check-deploy-coverage.sh credits a named path, never a glob. -#}
{%- from "partials/roster.jinja" import pve_hosts, smtp_name, dns_names,
    k3s_server_names, k3s_agent_names with context -%}
{%- set inventory_hosts = pve_hosts + [smtp_name] + dns_names
    + k3s_server_names + k3s_agent_names -%}
{#- Each deploy job's `changes:` list, and with it the union deploy-verify runs
    on. Spelled once so the two cannot drift apart. -#}
{%- set deploy_paths = {
      'base': [
        'ansible/inventories/prod/hosts.yml',
        'ansible/inventories/prod/group_vars/all.yml',
        'ansible/inventories/prod/group_vars/proxmox.yml',
        'ansible/inventories/prod/group_vars/services.yml',
        'ansible/inventories/prod/host_vars/**/*',
        'ansible/playbooks/base.yml',
        'ansible/playbooks/site.yml',
        'ansible/requirements.yml',
      ],
      'dns': [
        'ansible/inventories/prod/group_vars/dns.yml',
        'ansible/playbooks/dns.yml',
        'ansible/requirements.yml',
      ],
      'storage': [
        'ansible/inventories/prod/group_vars/nas.yml',
        'ansible/playbooks/storage.yml',
        'ansible/requirements.yml',
      ],
      'mail': [
        'ansible/inventories/prod/group_vars/mail.yml',
        'ansible/playbooks/mail.yml',
        'ansible/requirements.yml',
      ],
      'k3s': [
        'ansible/inventories/prod/hosts.yml',
        'ansible/inventories/prod/group_vars/all.yml',
        'ansible/inventories/prod/group_vars/k3s.yml',
        'ansible/playbooks/k3s.yml',
        'ansible/playbooks/k3s-provision-vms.yml',
        'ansible/requirements.yml',
      ],
    } -%}
{%- for h in inventory_hosts -%}
{%- set _ = deploy_paths['base'].append('ansible/inventories/prod/host_vars/' ~ h ~ '.yml') -%}
{%- endfor -%}
{%- if dns_backend == 'cloudflare' -%}
{%- set _ = deploy_paths.update({'terraform': ['terraform/cloudflare/**/*']}) -%}
{%- endif -%}
{#- SECRETS SEAM: partials/secrets.jinja is the one home for these five macros,
    shared with Taskfile.yml.jinja. An unimplemented backend fails the RENDER
    there, naming the macro. docs/ARCHITECTURE.md Backend seams. -#}
{%- import "partials/secrets.jinja" as secrets with context -%}
{%- set secret_ref = secrets.secret_ref -%}
{%- set secret_read = secrets.secret_read -%}
{%- set secret_runner = secrets.secret_runner -%}
{%- set secret_vault = secrets.secret_vault -%}
{%- set secret_gate_var = secrets.secret_gate_var -%}
{%- set gate_var = secret_gate_var() -%}
---
# CI for the {{ cluster_name }} cluster. Generic lint / validate / security /
# review jobs come from {{ lib_project }} at a pinned ref; only the deploy jobs
# and the wiring below are local. Prerequisites: docs/ci-pipeline.md.
stages:
  - lint
  - validate
  - test
  - security
  - ai-review
  - gate
  - deploy
  # Post-deploy verification is its own stage: a job with any `needs:` ignores
  # stage order and a failed need blocks it. deploy-verify therefore carries no
  # `needs:` and `when: always` — docs/ci-pipeline.md § Stages.
  - verify
  - maintenance
{%- if enable_semantic_release %}
  - release
{%- endif %}

# Settings every job inherits unless it says otherwise.
default:
  # Pinned here rather than left to the runner default, which is not reviewable
  # from this repository. The deploy fragment apt-installs and pip-installs, so
  # the image must be Debian-based with pip.
  image: python:3.13-slim
  # An untagged job goes to the shared, non-root, LAN-blocked runner, where
  # apt-get and every SSH reach to the hosts fail. This default catches a job
  # that forgets the tag.
  tags: ["{{ runner_tag }}"]
  # Cancel a superseded pipeline's jobs on a new commit — see the workflow
  # policy below. Deploys, the gate and the terraform plan/apply override this
  # to false; everything else is safe to interrupt.
  interruptible: true

workflow:
  # CRITICAL: MR refs cancel a superseded pipeline's interruptible jobs; main
  # never cancels (the rule below), because cancelling skips validation-gate and
  # leaves the first merge's deploys unmet. Rapid merges queue at the deploy
  # jobs' oldest-first `resource_group`s instead.
  # docs/ci-pipeline.md § Cancellation policy.
  auto_cancel:
    on_new_commit: interruptible
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH == "main"'
      auto_cancel:
        on_new_commit: none
    # Every schedule creates a pipeline; each opt-in job selects itself on
    # $SCHEDULE_TYPE.
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
    - if: '$CI_PIPELINE_SOURCE == "web"'

variables:
  # Single source for the library pin. `include:` cannot read it, so every entry
  # below repeats the tag literally and scripts/check-lib-pins.py fails a drifted
  # or branch pin. Bump here, then `scripts/check-lib-pins.py --fix`.
  WEISSSRV_LIB_REF: "{{ lib_ref }}"
  # The project half of the same pin, so the gate checks the includes this
  # cluster actually resolves (a fork or mirror answers lib_project).
  LIB_PROJECT: "{{ lib_project }}"
  PYYAML_VERSION: "6.0.2"
  # Pre-seeded for check-doc-links' backticked-path pass; inert until the library
  # pin ships it.
  CHECK_DOC_LINKS_PATHS: "1"
  # fnmatch exceptions for cited paths that are not files here: the library's own
  # docs, the forge-hosted terraform states, a gitignored plan file, and the
  # vendored-copy checker that lives in the library.
  CHECK_DOC_LINKS_IGNORE: "docs/[A-Z]* terraform/state/* */tfplan */check-vendored-copies.py"
  # Single source for the Ansible the local jobs pip-install. `include:` inputs
  # cannot read it (they resolve before this block exists), so the deploy-base
  # entry below repeats the literal — bump the two together.
  ANSIBLE_VERSION: "14.4.0"
  # kustomize for the cluster-verify server-side dry-run, pinned with the
  # sha256 the script verifies the downloaded tarball against. Same pin as
  # scripts/ci-fetch-tools.py, so one kustomize version runs in every job.
  KUSTOMIZE_VERSION: "5.8.2"
  KUSTOMIZE_SHA256: "06af0a202c2b831207d0173f9c9cdb1b30abceca0747cb3fbb72792d26055c95"
  # The command that resolves a job's secret references. Every deploy script
  # goes through it rather than naming a backend CLI, so `secrets_backend` has
  # one runtime half here and one render-time half in the secret_ref macro.
  SECRET_RUNNER: "{{ secret_runner() }}"
  # One exact patch tag for every terraform job, lint and credentialed alike.
  # The plan/apply and drift jobs hold vault credentials, so append
  # @sha256:<digest> here when you resolve one.
  TF_JOB_IMAGE: "{{ terraform_image }}"
  # The Python image for jobs that have already been handed vault credentials or
  # a kubeconfig, so a repointed upstream tag would execute there. Append
  # @sha256:<digest> here when you resolve one; lint-only jobs stay floating.
  PY_JOB_IMAGE: "python:3.13-slim"
  # git reads these three as config, so every clone of the library — terraform
  # init, ansible-galaxy, molecule's dependency step — authenticates with the
  # job token and no ~/.gitconfig. Only credential-less URLs are rewritten.
  GIT_CONFIG_COUNT: "1"
  GIT_CONFIG_KEY_0: "url.https://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}/.insteadOf"
  GIT_CONFIG_VALUE_0: "https://${CI_SERVER_HOST}/"

include:
  # Local: the integration-test matrix, split out so its `changes:` trigger can
  # name a file that only it lives in (see the header there).
  - local: .gitlab/ci/integration-jobs.yml

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/yaml-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      # -c lint/yamllint-relaxed.yml, not -d relaxed: the repo's config is what
      # `task lint` uses, and a different config reports different findings.
      config: "-c lint/yamllint-relaxed.yml"
      targets: "ansible/ kubernetes/ terraform/ scripts/ taskfiles/ lint/ .gitlab-ci.yml .gitlab/ Taskfile.yml"
      changes:
        - "ansible/**/*"
        - "kubernetes/**/*"
        - "terraform/**/*"
        - "scripts/**/*.yml"
        - "scripts/**/*.yaml"
        - "Taskfile.yml"
        - "taskfiles/**/*.yml"
        - "lint/yamllint-relaxed.yml"
        - ".gitlab-ci.yml"
        - ".gitlab/**/*"

  # collections_path is empty: this repo ships no in-repo collection, so the
  # only search path is the galaxy install of weisssrv.infra from requirements.yml.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/ansible-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      targets: "ansible/"
      collections_path: ""
      galaxy_requirements: "ansible/requirements.yml"
      # Full image, not slim: galaxy installs the collection from a git+ URL,
      # which needs the git executable.
      image: python:3.13
      changes:
        - "ansible/**/*"
        - ".ansible-lint"
        - ".ansible-lint-ignore"
        - ".gitlab-ci.yml"

  # kubectl + the kubeconfig, pulled into cluster-verify's before_script. The item
  # and field names are the include's own defaults (K3s Kubeconfig / kubeconfig),
  # and the stored value is base64.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/deploy/kubectl-setup.yml
    inputs:
      op_vault: "{{ secret_vault() }}"
      # Pinned here, not left to the include's default, so it is reviewable next
      # to k3s_version in group_vars/all.yml: keep it within one minor of that.
      # sha256 is the linux/amd64 binary, from <version>/bin/linux/amd64/kubectl.sha256.
      kubectl_version: "v1.37.1"
      kubectl_sha256: "65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/shellcheck.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      # terraform/*/*.sh is the SSO import helper, which is a real script and
      # not covered by the scripts/ glob.
      direct_globs: "scripts/*.sh terraform/*/*.sh"
      find_dir: ""
      changes:
        - "scripts/**/*.sh"
        - "terraform/**/*.sh"
        - ".gitlab-ci.yml"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/python-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      image: python:3.13-slim
      # ruff is pinned here; include inputs resolve before job variables exist.
      ruff_version: "0.16.7"
      # kubernetes/ is in the list for the Python a manifest delivers through a
      # configMapGenerator (the DDNS CronJob's program): a real file so ruff can
      # see it, which an inlined heredoc could not be.
      targets: "scripts tests kubernetes"
      # `changes:` must name the same surface as `targets:`, or the job skips a
      # source commit.
      changes:
        - "scripts/**/*.py"
        - "tests/**/*.py"
        - "kubernetes/**/*.py"
        - "ruff.toml"
        - "pyproject.toml"
        - ".gitlab-ci.yml"

  # tests/ + scripts/ = cluster invariants, the gate suites, the library-pin
  # gate. `changes:` must name every file they read — docs/ci-pipeline.md.
  # test_vendored_byte_identity.py reads the library from the clone below.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/test/python-tests.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      image: python:3.13
      # jq: test_collect_state_lib.py drives the collector's jq filters.
      # ansible-core: test_deploy_preflight.py fails rather than skips without it,
      # and the pin is the core line requirements.txt's `ansible==` resolves to.
      apt_packages: "jq"
      pip_packages: "ansible-core==2.21.5"
      test_dir: "tests scripts"
      setup_command: 'python3 scripts/ci-fetch-tools.py jq kustomize kubeconform shellcheck && mkdir -p "$(dirname "$WEISSSRV_LIB_PATH")" && git clone --depth 1 --branch "$WEISSSRV_LIB_REF" "${CI_SERVER_PROTOCOL}://gitlab-ci-token:${CI_JOB_TOKEN}@${CI_SERVER_HOST}:${CI_SERVER_PORT}/{{ lib_project }}.git" "$WEISSSRV_LIB_PATH"'
      changes:
        - "tests/**/*"
        - "kubernetes/**/*"
        - "scripts/**/*"
        - "docs/**/*"
        - "ansible/requirements.yml"
        - "ansible/inventories/prod/**/*"
        - "ansible/playbooks/**/*"
        - "ansible/integration-tests/**/*"
        - "ansible/TESTING.md"
        - ".copier-answers.yml"
        - "Taskfile.yml"
        - "taskfiles/**/*.yml"
        - "terraform/**/*"
        - ".gitignore"
        # Every path the vendored-copy manifest declares outside scripts/,
        # fork or byte-identical copy: an edit to one must run the gate that
        # holds it against the library.
        - "ruff.toml"
        - ".editorconfig"
        - "lint/yamllint-relaxed.yml"
        - ".gitleaks.toml"
        - ".gitlab/secret-detection-ruleset.toml"
        - ".pre-commit-config.yaml"
        - ".gitattributes"
        - "ansible/molecule/**/*"
        - ".gitlab-ci.yml"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/validate/terraform.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      image: "{{ terraform_image }}"
      fmt_dir: "terraform/"
      module_glob: "terraform/*/"
      changes:
        - "terraform/**/*"
        - ".gitlab-ci.yml"

  # flux-lint in substitute mode. flux_render_script is scripts/flux-env.sh, the
  # wrapper that adds the second ConfigMap this cluster substitutes from;
  # flux-render.sh parses one file — docs/ci-pipeline.md § flux-lint.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/validate/flux-lint.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      substitute: true
      # false until `flux bootstrap` has created gotk-sync.yaml — see README.
      # After bootstrap, flip to true: it fails a cluster that has LOST its
      # flux-system content instead of silently skipping the build.
      require_cluster_root: false
      cluster_dir: "{{ cluster_dir }}"
      versions_configmap: "{{ versions_cm }}"
      flux_render_script: "scripts/flux-env.sh"
      skipped_script: "scripts/kubeconform-skipped.py"
      # The revision taskfiles/flux.yml pins as CRD_CATALOG_REF, so `task
      # flux:lint` and this job resolve CR schemas against one catalog.
      crd_catalog_ref: "ad3b08c5045129d7bb1eeffd8e61719b2c8dd1e2"
      # With a baseline set, a kind skipped outside it fails the job rather than
      # degrading the run to core kinds in silence.
      expected_skipped_file: "scripts/kubeconform-expected-skipped.txt"
      extra_validation: 'bash scripts/flux-corpus-gates.sh "$RENDER_ALL" "{{ versions_cm }}" || FAILED=1'
      changes:
        - "kubernetes/**/*"
        - "ansible/inventories/prod/group_vars/all.yml"
        - "ansible/inventories/prod/group_vars/nas.yml"
        - "scripts/autoscaling-policy.yaml"
        - "scripts/check-backup-artifact-apps.py"
        - "scripts/helm-values-releases.yaml"
        - "scripts/check-hpa-vpa-invariant.py"
        - "scripts/check-scrape-netpol.py"
        - "scripts/check-default-deny-coverage.py"
        - "scripts/check-secretstore-scope.py"
        - "scripts/check-pvc-storageclass.py"
        - "scripts/check-nfs-tls.py"
        - "scripts/gate_common.py"
        - "scripts/validate-helm-values.py"
        - "scripts/flux-corpus-gates.sh"
        - "scripts/flux-env.sh"
        - "scripts/kubeconform-skipped.py"
        - "scripts/kubeconform-expected-skipped.txt"
        - ".gitlab-ci.yml"

  # Doc-link rot: the checker is vendored (scripts/check-doc-links.py) and
  # `task lint:doc-links` runs it locally; this is the gate that makes it
  # mandatory rather than a habit.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/docs-link-check.yml
    inputs:
      job_name: lint-docs-links
      tags: ["{{ runner_tag }}"]
      changes:
        - "**/*.md"
        - "scripts/check-doc-links.py"
        - ".gitlab-ci.yml"

  # The comment-length house rule, the CI half of `task lint:comment-length`.
  # scripts/comment-length.yaml carries the scan scope and the vendored copies
  # the gate skips, because their comments are the library's.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/lint/comment-length.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      config: "--config scripts/comment-length.yaml"
      changes:
        - "**/*"

  # Findings block. The paired allowlists .gitleaks.toml and
  # .gitlab/secret-detection-ruleset.toml keep the secret references and sha256
  # pins green. Amend .gitleaks.toml rather than disabling the gate.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/security/secret-detection.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      cpu_selector: "{{ cpu_selector }}"

  # env mode: the two keys come from masked CI/CD variables, so the job needs no
  # 1Password CLI and no root. The gate means a pipeline without them simply has
  # no AI review rather than a red job.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/review/pr-agent.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      secrets_source: "env"
      gate: '$OPENAI__KEY && $GITLAB__PERSONAL_ACCESS_TOKEN'
      needs:
        - job: yaml-lint
          optional: true
        - job: ansible-lint
          optional: true
        - job: flux-lint
          optional: true
        - job: secret_detection
          optional: true

  # The read-only half of the version pair: reports pin drift on the MR, needs no
  # token and no schedule. The -s guard is why the report is checked: a checker
  # that dies mid-run leaves an EMPTY artifact that reads as "nothing available".
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/maintenance/version-check.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      setup_command: "pip install --user --quiet pyyaml==$PYYAML_VERSION"
      check_command: >-
        python3 scripts/check-versions.py --json > "$REPORT_PATH"; RC=$?;
        [ -s "$REPORT_PATH" ] ||
        { echo "check-versions wrote no report (rc=$RC)"; exit 2; };
        exit "$RC"
      # Stated, not inherited: rc=1 is "updates available", rc=2 a checker
      # error, and the weekly sweep must red on the second.
      soft_fail_exit_codes: [1]
      changes:
        - "ansible/inventories/prod/group_vars/all.yml"
        - "kubernetes/**/*"
        - ".gitlab-ci.yml"

  # Weekly pin refresh, schedule-only, needs $VERSION_BUMP_BOT_TOKEN.
  # check_command is the non-interactive twin of
  # `task maintenance:update-all-versions` — docs/ci-pipeline.md § Version bumps.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/maintenance/version-bump-bot.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      # The job runs beside a PAT, so it is pinned to one trusted branch. A
      # LITERAL name: $CI_DEFAULT_BRANCH does not expand inside a quoted
      # `rules:if`.
      run_branch: "main"
      # Only the version-bump schedule may open an MR; the nightly full-test
      # schedule must not. The `web` clause keeps the manual run, because the
      # library ANDs `gate` into that rule too.
      gate: '$VERSION_BUMP_BOT_TOKEN && ($SCHEDULE_TYPE == "version-bump" || $CI_PIPELINE_SOURCE == "web")'
      setup_command: "pip install --user --quiet pyyaml==$PYYAML_VERSION"
      # CRITICAL: the soft-fail codes apply to the WHOLE check_command, so only
      # the report step may reach rc 1 ("updates available"). Every later step
      # remaps its failure to 2: on the soft-fail list a crashed step reads as
      # "updates found", the bot then runs with an unmodified tree and the MR
      # manager closes the standing bot MR.
      check_soft_fail_exit_codes: "1"
      check_command: >-
        RC=0;
        python3 scripts/check-versions.py --json > version-report.json || RC=$?;
        [ "$RC" -le 1 ] || exit 2;
        python3 scripts/check-versions.py --update-all || exit 2;
        python3 scripts/generate-versions-configmap.py
        --vars-file ansible/inventories/prod/group_vars/all.yml
        --output {{ versions_cm }}
        --nested-key helm_chart_versions
        --regen-command "task flux:sync-versions" || exit 2;
        exit "$RC"
      paths: "ansible/inventories/prod/group_vars/all.yml kubernetes/"
      report_path: "version-report.json"
      title: "chore(deps): {{ cluster_name }} version bumps"
{%- if enable_semantic_release %}

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/release/semantic-release.yml
    inputs:
      tags: ["{{ runner_tag }}"]
{%- endif %}

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/templates/dep-cache.yml

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/templates/install-1password.yml

  # `.deploy-base` — the toolchain every Ansible deploy job extends: op CLI,
  # pinned Ansible, ansible.cfg, the deploy SSH key, a keyscan of hosts.env and
  # the collection install. The secrets_backend seam: docs/ci-pipeline.md.
  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/deploy/deploy-base.yml
    inputs:
      tags: ["{{ runner_tag }}"]
      op_vault: "{{ secret_vault() }}"
      ansible_version: "14.4.0"

  - project: {{ lib_project }}
    ref: {{ lib_ref }}
    file: /ci/templates/terraform-http-backend.yml
    inputs:
      # ${CI_API_V4_URL} tracks the instance the pipeline runs on; TF_HTTP_PASSWORD
      # is the job token, which is only valid there.
      api_url: "${CI_API_V4_URL}"
      state_name: "{{ dns_backend }}"

# ==============================================================================
# Local jobs
# ==============================================================================

# CRITICAL: GitLab evaluates `rules:changes` as TRUE for every pipeline source
# but push and merge_request_event, so without the `web` arm below a "Run
# pipeline" button on main fires every deploy job unattended. Pulled in as
# `- !reference [.skip-schedule-web, rules]`; `.drift-schedule-rule` further
# down is the schedule-only twin the read-only drift jobs use.
.skip-schedule-web:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "web"'
      when: never

# Additive override of the library python-tests job: the checkout path its
# setup_command writes and tests/test_vendored_byte_identity.py reads. Declared
# here because that template exposes no `variables` input.
python-tests:
  # Repeats the include's `tags` input rather than inheriting it, so a reader and
  # the render gate see the tag in this file. Same value on both sides, so the
  # merge is a no-op.
  tags: ["{{ runner_tag }}"]
  variables:
    WEISSSRV_LIB_PATH: "$CI_PROJECT_DIR/.tmp/weisssrv-lib"

# Shared shape for the local lint gates, so the image, the runner tag and the
# PyYAML pin have one home. `rules:` stays per job: `extends` REPLACES a list
# rather than merging it, so each job's arms live with its `changes:` anchor.
.lint-gate:
  stage: lint
  image: python:3.13-slim
  tags: ["{{ runner_tag }}"]
  needs: []

# The gates that import PyYAML. --user, like every other unprivileged pip here:
# docs/ci-pipeline.md tells the operator only the three privileged jobs need a
# root-capable runner, and a bare `pip install` cannot write site-packages.
.pyyaml-gate:
  extends: .lint-gate
  before_script:
    - pip install --user --quiet "pyyaml==$PYYAML_VERSION"

# The version-bump-bot only reports pins that exist in
# scripts/version-registry.py; one missing there is skipped while the weekly job
# stays green. This offline check keeps the registry in step with the pins.
version-coverage:
  extends: .lint-gate
  script:
    - python3 scripts/check-versions.py --check-coverage
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/version-registry.py"
        - "scripts/check-versions.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes:
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/version-registry.py"
        - "scripts/check-versions.py"
        - ".gitlab-ci.yml"
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The bump bot rewrites a version pin and leaves the checksum paired with it
# alone, so a stale hash passes every offline gate and fails at deploy time.
# Needs network egress, which is why `task lint` does not run it.
version-checksums:
  extends: .pyyaml-gate
  script:
    - python3 scripts/check-version-checksums.py --allow-empty
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &version_checksum_paths
        - "ansible/inventories/prod/group_vars/all.yml"
        - "scripts/version-registry.py"
        - "scripts/check-version-checksums.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *version_checksum_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The flux CLI cluster-verify downloads, the versions ConfigMap and the committed
# gotk-components.yaml are one pin in three places. A CLI newer than the manifest
# installs a control plane nobody reviewed. Mirrors `task lint:flux-version-pin`.
flux-version-pin:
  extends: .lint-gate
  script:
    - python3 scripts/check-flux-version-pin.py
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &flux_version_pin_paths
        - "ansible/inventories/prod/group_vars/all.yml"
        - "{{ versions_cm }}"
        - "kubernetes/clusters/*/flux-system/gotk-components.yaml"
        - "scripts/check-flux-version-pin.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *flux_version_pin_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# Three files here are OUTPUTS, not sources, and nothing else compares them
# against what generates them, so a stale copy ships green. Regenerate and diff.
# What each arm covers: docs/ci-pipeline.md § check-generated-files.
check-generated-files:
  extends: .pyyaml-gate
  script:
    - |
      # errexit explicit here so run_check's `set +e`/`set -e` pair restores a
      # known state rather than whatever the runner preamble left.
      set -euo pipefail
      overall=0; failed=""
      OUT=$(mktemp -d)

      run_check() {
        name="$1"; shift
        printf 'section_start:%s:%s[collapsed=true]\r\033[0K== %s\n' "$(date +%s)" "$name" "$name"
        # Not `"$@" || rc=$?`: bash suppresses errexit throughout an AND-OR
        # list, so a check's own `set -e` never fires and a crashed generator
        # reads as a pass. `set +e` is what lets the driver report every check.
        set +e
        ( set -eo pipefail; "$@" )
        rc=$?
        set -e
        printf 'section_end:%s:%s\r\033[0K\n' "$(date +%s)" "$name"
        if [ "$rc" -ne 0 ]; then overall=1; failed="$failed $name"; echo "FAILED: $name (rc=$rc)"; fi
      }

      # Generated to a temp path rather than in place: the workspace stays clean
      # for the other checks, and the argv (which the generated header embeds)
      # mirrors the task that regenerates the committed copy.
      check_hosts_env() {
        python3 scripts/generate-hosts-env.py \
          --inventory ansible/inventories/prod/hosts.yml \
          --map scripts/hosts-env-map.yml \
          --output "$OUT/hosts.env" \
          --regen-command "task hosts:sync" >/dev/null
        if ! diff -u scripts/hosts.env "$OUT/hosts.env"; then
          echo "ERROR: scripts/hosts.env is out of sync with ansible/inventories/prod/hosts.yml"
          echo "Run: task hosts:sync and commit the result."
          return 1
        fi
      }

      check_versions_configmap() {
        python3 scripts/generate-versions-configmap.py \
          --vars-file ansible/inventories/prod/group_vars/all.yml \
          --output "$OUT/versions-configmap.yaml" \
          --nested-key helm_chart_versions \
          --regen-command "task flux:sync-versions" >/dev/null
        if ! diff -u {{ versions_cm }} "$OUT/versions-configmap.yaml"; then
          echo "ERROR: {{ versions_cm }} is out of sync with group_vars/all.yml"
          echo "Run: task flux:sync-versions and commit the result."
          return 1
        fi
      }

      run_check hosts-env-sync check_hosts_env
      run_check flux-versions-sync check_versions_configmap
      run_check host-log-staleness python3 scripts/generate-host-log-staleness.py --check
      [ "$overall" -eq 0 ] || echo "Failed sync checks:$failed"
      exit "$overall"
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &repo_sync_paths
        - "ansible/inventories/prod/hosts.yml"
        - "ansible/inventories/prod/group_vars/all.yml"
        - "ansible/playbooks/site.yml"
        - "scripts/hosts.env"
        - "scripts/hosts-env-map.yml"
        - "scripts/generate-hosts-env.py"
        - "scripts/generate-versions-configmap.py"
        - "scripts/generate-host-log-staleness.py"
        - "kubernetes/infrastructure/observability/loki/host-log-staleness.yaml"
        - "{{ versions_cm }}"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *repo_sync_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The LAN fence: every public-egress except-list against the canonical sets,
# plus the edits that re-open the LAN without touching one. Exceptions live in
# scripts/netpol-except.yaml. What it reads: docs/ci-pipeline.md § flux-lint.
netpol-parity:
  extends: .pyyaml-gate
  script:
    - python3 scripts/check-netpol-except-parity.py --config scripts/netpol-except.yaml kubernetes/
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &netpol_parity_paths
        - "kubernetes/**/*"
        - "scripts/netpol-except.yaml"
        - "scripts/check-netpol-except-parity.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *netpol_parity_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# A literal domain, CIDR or VIP in a substituted tree renders and applies, so no
# other gate sees it. Mirrors `task lint:cluster-literals`.
cluster-literals:
  extends: .pyyaml-gate
  script:
    - python3 scripts/check-cluster-literals.py
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &cluster_literals_paths
        - "kubernetes/**/*"
        - "ansible/inventories/prod/group_vars/*.yml"
        - "scripts/check-cluster-literals.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *cluster_literals_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# A manifest no kustomization.yaml lists is invisible to kubeconform, the corpus
# gates and Flux; an emptied list prunes what it applied. Mirrors
# `task lint:kustomization-coverage`.
kustomization-coverage:
  extends: .pyyaml-gate
  script:
    - python3 scripts/check-kustomization-coverage.py kubernetes/
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &kustomization_coverage_paths
        - "kubernetes/**/*"
        - "scripts/check-kustomization-coverage.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *kustomization_coverage_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# A scenario directory with no `parallel:matrix` entry never runs, and reads as
# green because nothing executed it. Mirrors `task lint:integration-matrix`.
check-integration-matrix:
  extends: .pyyaml-gate
  script:
    - python3 scripts/check-integration-matrix-coverage.py
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &integration_matrix_paths
        - "ansible/integration-tests/**/*"
        - ".gitlab/ci/integration-jobs.yml"
        - "scripts/check-integration-matrix-coverage.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *integration_matrix_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# tflint over every root, mirroring `task terraform:tflint`. It catches what
# fmt/validate do not: deprecated syntax, unused declarations and
# provider-specific rules. No .tflint.hcl today, so --init fetches no plugins.
terraform-tflint:
  stage: lint
  needs: []
  tags: ["{{ runner_tag }}"]
  image:
    name: ghcr.io/terraform-linters/tflint:v0.61.0@sha256:b835d64d66abfdbc146694b918eb3cd733ec772465ad511464d4e8bebbdd6732
    entrypoint: [""]
  script:
    - cd terraform
    - tflint --init
    - tflint --recursive --minimum-failure-severity=error
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &terraform_lint_paths
        - "terraform/**/*"
        - ".tflint.hcl"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *terraform_lint_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# Runs promtool/amtool over the alert rules and Alertmanager config: the
# kube-prometheus-stack HelmRelease values, an ExternalSecret template no other
# gate parses, and the per-app PrometheusRule CRs.
prometheus-config-lint:
  extends: .lint-gate
  # The promtool unit tests dominate this job: promtool re-evaluates the whole
  # rule corpus once per evaluation_interval, per test file. Shard the files
  # across parallel instances so wall time is the slowest shard, not the sum.
  parallel: 4
  variables:
    # promtool unit-tests the extracted rules against tests/prometheus-rules/*.test.yaml;
    # the Taskfile points at the same directory. A new platform alert rule gets
    # a case there.
    RULE_TESTS_DIR: "tests/prometheus-rules"
    # The per-app PrometheusRule CRs; the platform rules are inline in the
    # kube-prometheus-stack release. REQUIRE_RULES_DIR stays unset: this repo
    # ships no shared rules tree for it to require.
    RULES_DIR: "kubernetes/apps"
    REQUIRE_RELEASE_RULES: "1"
  before_script:
    # The binaries come from the vendored fetcher, whose pins and sha256s are
    # the library's. Each run downloads and verifies them afresh.
    - export PATH="$CI_PROJECT_DIR/.bin:$(python -m site --user-base)/bin:$PATH"
    - pip install --user --quiet "pyyaml==$PYYAML_VERSION"
    - python3 scripts/ci-fetch-tools.py promtool amtool
    - promtool --version && amtool --version
  script:
    - |
      set -eo pipefail
      # This shard's slice of the unit tests, round-robin over the file list.
      # Any *.rules.yaml goes into every shard: the *.test.yaml files load them
      # by name, relative to their own directory.
      shard="${CI_PROJECT_DIR}/.rule-tests-shard"
      rm -rf "$shard"; mkdir -p "$shard"
      for rules_file in "$RULE_TESTS_DIR"/*.rules.yaml; do
        [ -e "$rules_file" ] || break
        cp "$rules_file" "$shard"/
      done
      index=0; copied=0
      for test_file in "$RULE_TESTS_DIR"/*.test.yaml; do
        if [ "$(( index % CI_NODE_TOTAL + 1 ))" = "$CI_NODE_INDEX" ]; then
          cp "$test_file" "$shard"/
          copied=$(( copied + 1 ))
        fi
        index=$(( index + 1 ))
      done
      echo "shard ${CI_NODE_INDEX}/${CI_NODE_TOTAL}: ${copied} of ${index} unit-test file(s)"
      RULE_TESTS_DIR="$shard" bash scripts/lint-prometheus-config.sh
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &prometheus_config_paths
        - "kubernetes/infrastructure/observability/kube-prometheus-stack/**/*"
        - "kubernetes/apps/**/prometheusrule.yaml"
        - "tests/prometheus-rules/**/*"
        - "scripts/extract-prometheus-config.py"
        - "scripts/lint-prometheus-config.sh"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *prometheus_config_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The `changes:` list on a deploy job is a contract nothing else enforces: a
# path no deploy job lists goes green while never deploying. This fails that MR;
# scripts/deploy-coverage.conf is the acknowledged-manual list.
deploy-coverage:
  stage: lint
  # The FULL python image: the checker shells out to git, which python:*-slim
  # does not ship.
  image: python:3.13
  tags: ["{{ runner_tag }}"]
  needs: []
  variables:
    # The MR base commit must be in the local history for the diff to resolve.
    GIT_DEPTH: "0"
  script:
    - pip install --user --quiet "pyyaml==$PYYAML_VERSION"
    - bash scripts/check-deploy-coverage.sh
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes:
        - "ansible/**/*"
        - "scripts/deploy-coverage.conf"
        - "scripts/check-deploy-coverage.sh"
        - "scripts/ci_yaml.py"
        - ".gitlab-ci.yml"
    - if: '$CI_PIPELINE_SOURCE == "web"'

# Credential-free preflight over the deploy jobs: every `ansible-playbook` call
# names a playbook that exists and every `--tags` selection reaches a task. A tag
# matching nothing makes a deploy job a green no-op.
check-deploy-playbooks:
  stage: validate
  needs: []
  # The FULL python image: ansible-galaxy installs weisssrv.infra from a git+ URL.
  image: python:3.13
  tags: ["{{ runner_tag }}"]
  before_script:
    - apt-get update -qq && apt-get install -y -qq --no-install-recommends git
    # --user, like every other unprivileged pip here; the PATH line puts the
    # console scripts it installs (ansible-galaxy, ansible-playbook) on PATH,
    # which a --user install alone does not.
    - export PATH="$(python -m site --user-base)/bin:$PATH"
    - pip install --user --quiet "ansible==$ANSIBLE_VERSION" "pyyaml==$PYYAML_VERSION"
    # --force: galaxy skips an already-installed collection, so a warm cache
    # would preflight against the previous release's roles after a pin bump.
    - for i in 1 2 3; do ansible-galaxy collection install --force -r ansible/requirements.yml && break; [ "$i" = 3 ] && exit 1; echo "galaxy install failed (attempt $i) - retrying in 20s"; sleep 20; done
  script:
    - python3 scripts/deploy-preflight.py
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &deploy_preflight_paths
        # Everything the answer depends on: the playbooks and tags it walks, the
        # inventory `--list-tasks` parses, the collection pin it installs, the
        # deploy jobs it reads the invocations out of, and the checker itself.
        - "ansible/playbooks/**/*"
        - "ansible/inventories/prod/**/*"
        - "ansible/requirements.yml"
        - "ansible/ansible.cfg"
        - "scripts/deploy-preflight.py"
        - "scripts/ci_yaml.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *deploy_preflight_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# The collection's roles assert their required inputs. An opt-in role invoked
# with its flag set nowhere, and an asserted input with no default and no
# assignment, fail on every host the role touches. Mirrors `task lint:role-inputs`.
check-role-inputs:
  stage: lint
  needs: []
  # The FULL python image: ansible-galaxy installs weisssrv.infra from a git+ URL.
  image: python:3.13
  tags: ["{{ runner_tag }}"]
  before_script:
    - apt-get update -qq && apt-get install -y -qq --no-install-recommends git
    - export PATH="$(python -m site --user-base)/bin:$PATH"
    - pip install --user --quiet "ansible==$ANSIBLE_VERSION" "pyyaml==$PYYAML_VERSION"
    - ansible-galaxy collection install --force -r ansible/requirements.yml -p .ansible-home/collections
  script:
    # --allow-empty: a starter cluster composes no opt-in role, and an arm with
    # nothing to examine reports rather than fails. --allow-unknown exempts a
    # chart version whose name happens to carry a role's prefix.
    - |
      python3 scripts/check-role-inputs.py --allow-empty \
        --allow-unknown "gitlab_runner_helm_version=a chart version the Flux substitution reads, not a role variable" \
        --roles-dir .ansible-home/collections/ansible_collections/weisssrv/infra/roles \
        --inventory ansible/inventories/prod \
        --playbooks ansible/playbooks
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
      changes: &role_inputs_paths
        - "ansible/inventories/prod/**/*"
        - "ansible/playbooks/**/*"
        - "ansible/requirements.yml"
        - "scripts/check-role-inputs.py"
        - ".gitlab-ci.yml"
    - if: '$CI_COMMIT_BRANCH == "main"'
      changes: *role_inputs_paths
    - if: '$CI_PIPELINE_SOURCE == "web"'

# ==============================================================================
# GATE STAGE — the one dependency every deploy job carries. Stage order does not
# gate a job that declares `needs:` — docs/ci-pipeline.md § The validation gate.
validation-gate:
  stage: gate
  image: alpine:3.23
  tags: ["{{ runner_tag }}"]
  # A newer commit must not auto-cancel this gate mid-run: the first pipeline's
  # not-yet-started deploy jobs all need it, and would be orphaned.
  interruptible: false
  needs:
    # Path-filtered (may not exist in this pipeline)
    - job: yaml-lint
      optional: true
    - job: ansible-lint
      optional: true
    - job: shellcheck
      optional: true
    - job: python-lint
      optional: true
    - job: python-tests
      optional: true
    - job: flux-lint
      optional: true
    - job: lint-docs-links
      optional: true
    - job: terraform-fmt
      optional: true
    - job: terraform-validate
      optional: true
    - job: terraform-plan
      optional: true
    - job: version-coverage
      optional: true
    - job: check-generated-files
      optional: true
    - job: deploy-coverage
      optional: true
    - job: check-deploy-playbooks
      optional: true
    - job: netpol-parity
      optional: true
    - job: kustomization-coverage
      optional: true
    - job: cluster-literals
      optional: true
    - job: prometheus-config-lint
      optional: true
    - job: terraform-tflint
      optional: true
    - job: flux-version-pin
      optional: true
    - job: check-integration-matrix
      optional: true
    - job: check-role-inputs
      optional: true
    # Expands to one need per matrix instance, well under GitLab's 50-need cap.
    - job: integration-tests
      optional: true
    # Always created on a main pipeline (no path filter)
    - job: secret_detection
    # An image-build job added later belongs here as `optional: true` too: every
    # deploy job declares `needs:`, so GitLab runs the DAG past a red build.
  script:
    # Every deploy job gates on `$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}`,
    # so with the variable unset they are never created and main goes green
    # having deployed nothing. This gate has no token clause, so it can say so.
    - |
      if [ -z "${{ gate_var }}" ]; then
        echo "ERROR: {{ gate_var }} is unset/empty on a main pipeline." >&2
        echo "       Every deploy job gates on it and was silently skipped," >&2
        echo "       deploying nothing while the pipeline reports success." >&2
        echo "       Set the CI/CD variable (masked, protected) and re-run." >&2
        exit 1
      fi
    - echo "All applicable checks passed - deploy jobs may proceed"
  # A superset of every deploy job's rules: a deploy job needing a gate that was
  # not created fails pipeline creation. Deploy jobs are main-only and skip
  # schedules, so this is that set without the token clause.
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main"'

# ==============================================================================
# Deploy — starter set: one job per playbook, gated to main plus a changes list.
# Adding a playbook means adding a job — docs/ci-pipeline.md § Adding one.

# Each job's `variables:` mirror the matching Taskfile task's `env:`, minus the
# Loki push pair `.deploy-base` declares — docs/ci-pipeline.md § CI/CD variables.

# Runs site.yml, the full host stack — the CI twin of `task infra:deploy`. Its
# trigger list covers the whole inventory, so a base.yml-only job would report a
# green deploy for changes it never applied.
deploy-ansible-base:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-base
  needs:
    - job: validation-gate
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    SMTP_UPSTREAM_USER: "{{ secret_ref('SMTP Smarthost', 'username') }}"
    SMTP_UPSTREAM_PASSWORD: "{{ secret_ref('SMTP Smarthost', 'password') }}"
    ADGUARD_ADMIN_PASSWORD: "{{ secret_ref('AdGuard Home', 'password') }}"
    SAMBA_NAS_PASSWORD: "{{ secret_ref('Samba NAS User', 'password') }}"
    ACME_SSH_PRIVATE_KEY: "{{ secret_ref('Cert Distribution Key', 'private key') }}"
    ACME_SSH_PUBLIC_KEY: "{{ secret_ref('Cert Distribution Key', 'public key') }}"
{%- if vpn_tailscale %}
    TAILSCALE_AUTH_KEY: "{{ secret_ref('Tailscale Auth Key', 'credential') }}"
{%- endif %}
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/site.yml
  environment:
    name: production/ansible-base
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      # Cluster-wide inventory. The per-group group_vars files belong to the
      # group jobs below, so a DNS-only edit does not re-run every host.
      changes:
{%- for path in deploy_paths['base'] %}
        - "{{ path }}"
{%- endfor %}

# The DNS stack alone — the CI twin of `task dns:deploy`. dns.yml runs one
# resolver at a time, so a bad change never takes both down at once.
deploy-ansible-dns:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-dns
  # Ordering only, stated once for the three group jobs: base is not created for
  # a group-only change, so it stays optional — validation-gate is the real gate.
  needs: &needs_after_base
    - job: validation-gate
    - job: deploy-ansible-base
      optional: true
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    ADGUARD_ADMIN_PASSWORD: "{{ secret_ref('AdGuard Home', 'password') }}"
    ACME_SSH_PRIVATE_KEY: "{{ secret_ref('Cert Distribution Key', 'private key') }}"
    ACME_SSH_PUBLIC_KEY: "{{ secret_ref('Cert Distribution Key', 'public key') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/dns.yml
  environment:
    name: production/ansible-dns
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths['dns'] %}
        - "{{ path }}"
{%- endfor %}

# The NAS alone — the CI twin of `task storage:deploy`. Add the restic
# references here too when you enable the offsite backup role.
deploy-ansible-storage:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-storage
  needs:
    - job: validation-gate
    - job: deploy-ansible-base
      optional: true
    # storage.yml runs nfs_tls in SERVER mode on the NAS, which asserts the
    # wildcard cert and key that acme_certs (dns.yml) distributes.
    - job: deploy-ansible-dns
      optional: true
  variables:
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SAMBA_NAS_PASSWORD: "{{ secret_ref('Samba NAS User', 'password') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/storage.yml
  environment:
    name: production/ansible-storage
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths['storage'] %}
        - "{{ path }}"
{%- endfor %}

# The SMTP relay alone. Every host's null client submits through it, so a relay
# change is worth deploying without re-running the whole stack.
deploy-ansible-mail:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-mail
  needs: *needs_after_base
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    SMTP_UPSTREAM_USER: "{{ secret_ref('SMTP Smarthost', 'username') }}"
    SMTP_UPSTREAM_PASSWORD: "{{ secret_ref('SMTP Smarthost', 'password') }}"
    # base rewrites the relay's authorized_keys, so mail.yml re-seeds the
    # cert-distribution key from the primary resolver afterwards.
    ACME_SSH_PUBLIC_KEY: "{{ secret_ref('Cert Distribution Key', 'public key') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/mail.yml
  environment:
    name: production/ansible-mail
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths['mail'] %}
        - "{{ path }}"
{%- endfor %}

# Manual: a k3s change can restart the control plane, so an operator triggers it
# after reading the diff.
deploy-ansible-k3s:
  stage: deploy
  extends: .deploy-base
  resource_group: deploy-ansible-k3s
  needs:
    - job: validation-gate
  variables:
    ROOT_EMAIL_ALIAS: "{{ secret_ref('Email Config', 'root_alias') }}"
    SSH_PUBLIC_KEY: "{{ secret_ref('SSH Key', 'public key') }}"
    SMTP_RELAY_USER: "{{ secret_ref('SMTP Relay Auth', 'username') }}"
    SMTP_RELAY_PASSWORD: "{{ secret_ref('SMTP Relay Auth', 'password') }}"
    K3S_TOKEN: "{{ secret_ref('K3s Cluster Token', 'credential') }}"
    # Agents join with the lower-privilege worker token the servers advertise.
    K3S_AGENT_TOKEN: "{{ secret_ref('K3s Agent Token', 'credential') }}"
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/k3s.yml
  environment:
    name: production/k3s
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths['k3s'] %}
        - "{{ path }}"
{%- endfor %}
      when: manual
      allow_failure: false

# Keys-only override of the library's terraform-validate job: the tag repeats
# what the include's `tags` input already passes, so a reader and the render gate
# see it in this file. The git credential is a top-level variable.
terraform-validate:
  tags: ["{{ runner_tag }}"]
{% if dns_backend == 'cloudflare' %}
# Pre-merge preview of the zone change, and the plan deploy-terraform applies.
# The directory is the literal `terraform/cloudflare` the payload ships and the
# job pair is gated on the answer, so no render points at a missing directory.
terraform-plan:
  stage: validate
  extends: .terraform-http-backend
  needs: []
  tags: ["{{ runner_tag }}"]
  # A cancelled plan leaves deploy-terraform with no artifact to apply.
  interruptible: false
  image:
    name: $TF_JOB_IMAGE
    entrypoint: [""]
  before_script:
    - !reference [.install-1password-alpine, before_script]
  script:
    - cd terraform/cloudflare
    # -lockfile=readonly: provider hashes are committed; CI rewriting them would
    # mask supply-chain drift.
    - terraform init -lockfile=readonly
    - |
      set -eo pipefail
      TF_VAR_cloudflare_api_token=$({{ secret_read("Cloudflare Terraform Token", "credential") }})
      TF_VAR_cloudflare_account_id=$({{ secret_read("Cloudflare Terraform Token", "username") }})
      export TF_VAR_cloudflare_api_token TF_VAR_cloudflare_account_id
      terraform plan -input=false -no-color -lock-timeout=120s -out=tfplan
    # Change counts for the merge request's Terraform widget.
    - |
      terraform show -json tfplan | jq -r '
        ([.resource_changes[]?.change.actions?]|flatten)|
        {"create":(map(select(.=="create"))|length),
         "update":(map(select(.=="update"))|length),
         "delete":(map(select(.=="delete"))|length)}
      ' > tfplan.json
  artifacts:
    # The binary plan holds every TF_VAR value in the clear, so nobody downloads
    # it. deploy-terraform still gets it through needs:artifacts, which `access`
    # does not gate.
    access: none
    paths:
      - terraform/cloudflare/tfplan
    reports:
      terraform: terraform/cloudflare/tfplan.json
    # A week, not a day: deploy-terraform is a manual job and the plan must still
    # exist when someone presses it.
    expire_in: 1 week
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: never
    # `terraform plan` evaluates the branch's own provider, data and module
    # blocks with a live API token, so this rule is inert while {{ gate_var }} is
    # masked and protected. The source-project clause keeps a fork's branch out.
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event" && ${{ gate_var }} && $CI_MERGE_REQUEST_SOURCE_PROJECT_ID == $CI_PROJECT_ID'
      changes:
{%- for path in deploy_paths['terraform'] %}
        - "{{ path }}"
{%- endfor %}
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths['terraform'] %}
        - "{{ path }}"
{%- endfor %}

deploy-terraform:
  stage: deploy
  extends: .terraform-http-backend
  # Same reasoning as .deploy-base: .install-1password-alpine installs a package
  # and this job holds a live API token, so it belongs on the privileged runner.
  tags: ["{{ runner_tag }}"]
  interruptible: false
  image:
    name: $TF_JOB_IMAGE
    entrypoint: [""]
  # validation-gate gates the apply on lint, validate and test; terraform-plan
  # supplies the saved plan. Both are non-optional: a dropped optional need would
  # leave the apply reaching for an artifact that is not there.
  needs:
    - job: validation-gate
    - job: terraform-plan
      artifacts: true
  before_script:
    - !reference [.install-1password-alpine, before_script]
  script:
    - cd terraform/cloudflare
    # -lockfile=readonly: provider hashes are committed; CI rewriting them would
    # mask supply-chain drift.
    - terraform init -lockfile=readonly
    # Deletions are the destructive class here: a removed record takes a name
    # offline. Set ALLOW_DNS_DELETE=1 on the manual run to permit them.
    - |
      set -eo pipefail
      deletes=$(terraform show -json tfplan | jq '[.resource_changes[]?.change.actions? | select(index("delete"))] | length')
      if [ "$deletes" -gt 0 ] && [ "${ALLOW_DNS_DELETE:-0}" != "1" ]; then
        echo "ERROR: plan deletes $deletes resource(s); re-run with ALLOW_DNS_DELETE=1" >&2
        exit 1
      fi
    # Applies the SAVED plan, so what ships is what the merge request showed.
    # A fresh apply-time plan could delete a record nobody reviewed.
    - |
      set -eo pipefail
      TF_VAR_cloudflare_api_token=$({{ secret_read("Cloudflare Terraform Token", "credential") }})
      TF_VAR_cloudflare_account_id=$({{ secret_read("Cloudflare Terraform Token", "username") }})
      export TF_VAR_cloudflare_api_token TF_VAR_cloudflare_account_id
      terraform apply -auto-approve -lock-timeout=120s tfplan
  environment:
    name: production/cloudflare
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths['terraform'] %}
        - "{{ path }}"
{%- endfor %}
      when: manual
      allow_failure: false
{% endif %}
# CRITICAL: no {{ gate_var }} guard here. A guard REMOVES the job
# when the credential is revoked or rescoped, so out-of-band drift goes
# undetected behind a green pipeline; unguarded, the vault read reds the job.
.drift-schedule-rule:
  rules:
    # No changes: filter, so it catches an admin-console edit made when nothing
    # in-repo moved.
    - if: '$CI_PIPELINE_SOURCE == "schedule"'

# Shared shape of the read-only terraform drift-plan jobs. Each job adds
# TF_DRIFT_DIR, its own TF_HTTP_* state paths, the vault reads and the plan, and
# its own rules.
.terraform-drift-plan:
  stage: validate
  extends: .terraform-http-backend
  needs: []
  tags: ["{{ runner_tag }}"]
  image:
    name: $TF_JOB_IMAGE
    entrypoint: [""]
  before_script:
    - !reference [.install-1password-alpine, before_script]
    - cd "$TF_DRIFT_DIR"
    # -lockfile=readonly: provider hashes are committed; CI rewriting them would
    # mask supply-chain drift.
    - terraform init -lockfile=readonly
  # Exit 2 is the drift signal and stays advisory; exit 1 is a broken plan and
  # turns the job red.
  allow_failure:
    exit_codes: [2]

{%- if vpn_tailscale %}
# Read-only drift plan for the tailnet ACL. It never applies — that stays
# supervised (terraform/tailscale/README.md) — so a console hot-fix would
# otherwise sit undetected until someone happened to plan.
tailscale-drift-plan:
  extends: .terraform-drift-plan
  variables:
    TF_DRIFT_DIR: "terraform/tailscale"
    TF_HTTP_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/tailscale"
    TF_HTTP_LOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/tailscale/lock"
    TF_HTTP_UNLOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/tailscale/lock"
  script:
    - |
      set -eo pipefail
      TF_VAR_tailscale_oauth_client_id=$({{ secret_read("Tailscale OAuth", "client id") }})
      TF_VAR_tailscale_oauth_client_secret=$({{ secret_read("Tailscale OAuth", "credential") }})
      export TF_VAR_tailscale_oauth_client_id TF_VAR_tailscale_oauth_client_secret
      terraform plan -input=false -no-color -lock-timeout=120s -detailed-exitcode
  rules:
    - !reference [.drift-schedule-rule, rules]
    # Post-merge, before the supervised apply. No merge_request_event rule:
    # this materializes vault secrets into a job running an unmerged branch's
    # own code, and an advisory signal does not justify that.
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
        - "terraform/tailscale/**/*"
{% endif %}
# Read-only drift plan for the SSO objects. The apply is `task
# terraform:authentik-apply`, which refuses to run non-interactively, so this job
# is the only thing that notices an admin-UI edit. Own state name below.
authentik-drift-plan:
  extends: .terraform-drift-plan
  variables:
    TF_DRIFT_DIR: "terraform/authentik"
    TF_HTTP_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/authentik"
    TF_HTTP_LOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/authentik/lock"
    TF_HTTP_UNLOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/authentik/lock"
  script:
    - |
      set -eo pipefail
      # One line per client-secret variable the root declares: a missing one
      # fails the plan, which is the intended behaviour, not drift.
      TF_VAR_authentik_token=$({{ secret_read("Authentik Terraform Token", "credential") }})
      TF_VAR_oauth2_client_secret_grafana=$({{ secret_read("Grafana SSO", "oidc-client-secret") }})
      export TF_VAR_authentik_token TF_VAR_oauth2_client_secret_grafana
      terraform plan -input=false -no-color -lock-timeout=120s -detailed-exitcode
  rules:
    - !reference [.drift-schedule-rule, rules]
    # No merge_request_event rule: this job reads every OIDC client secret.
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
        - "terraform/authentik/**/*"
{% if use_unifi %}
# Read-only drift plan for the gateway's own segmentation. The apply is `task
# terraform:unifi-apply`, which refuses to run non-interactively. It reads the
# console over the LAN, so a runner off the LAN fails the plan.
unifi-drift-plan:
  extends: .terraform-drift-plan
  variables:
    TF_DRIFT_DIR: "terraform/unifi"
    TF_HTTP_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/unifi"
    TF_HTTP_LOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/unifi/lock"
    TF_HTTP_UNLOCK_ADDRESS: "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/terraform/state/unifi/lock"
  script:
    - |
      set -eo pipefail
      # One line per WLAN passphrase variable the root declares: a missing one
      # fails the plan, which is the intended behaviour, not drift.
      TF_VAR_unifi_api_url=$({{ secret_read("UniFi Controller", "url") }})
      TF_VAR_unifi_api_key=$({{ secret_read("UniFi Controller", "api-key") }})
      TF_VAR_wlan_passphrase_iot=$({{ secret_read("WiFi IoT", "password") }})
      TF_VAR_wlan_passphrase_guest=$({{ secret_read("WiFi Guest", "password") }})
      export TF_VAR_unifi_api_url TF_VAR_unifi_api_key TF_VAR_wlan_passphrase_iot TF_VAR_wlan_passphrase_guest
      terraform plan -input=false -no-color -lock-timeout=120s -detailed-exitcode
  rules:
    - !reference [.drift-schedule-rule, rules]
    # No merge_request_event rule: this job reads every WLAN passphrase.
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
        - "terraform/unifi/**/*"
{% endif %}
# ==============================================================================
# VERIFY STAGE — verification only, runs after the deploy stage whatever it did.
# ==============================================================================

# The postflight play: SSH reachability, disk headroom and service state on every
# managed host. Its only write is one adguardhome-sync run, so a failure means the
# deploy left the fleet in a state the assertions reject.
deploy-verify:
  stage: verify
  # Relative to the whole pipeline: a main pipeline red at lint still runs this,
  # verifying hosts nothing was deployed to. It deploys nothing, so that is one
  # more failure surface on an already-red pipeline rather than a risk.
  when: always
  extends: .deploy-base
  script:
    - cd ansible
    - $SECRET_RUNNER ansible-playbook -i inventories/prod playbooks/postflight.yml
  environment:
    name: production/verify
  # The union of every deploy job's paths, rendered from the same map, so the two
  # trigger sets cannot drift. Not a `!reference` to a deploy job's rules: that
  # brings its `when:` and would override this job's `when: always`.
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
{%- for path in deploy_paths.values() | sum(start=[]) | unique | sort %}
        - "{{ path }}"
{%- endfor %}

# The in-cluster half of verification: server-side dry-run of the rendered
# manifests, a forced Flux reconcile, then Ready gates. Read-only, and separate
# from deploy-verify so a missing kubeconfig spares the host-side checks.
cluster-verify:
  stage: verify
  when: always
  extends: .install-1password
  image: $PY_JOB_IMAGE
  tags: ["{{ runner_tag }}"]
  interruptible: false
  before_script:
    - !reference [.install-1password, before_script]
    # jq parses the kubectl JSON scripts/deploy-verify.sh reads (Flux CR readiness).
    - apt-get install -y -qq jq
    - !reference [.kubectl-setup, before_script]
    - kubectl version --output=yaml --request-timeout=5s
  script:
    - python3 scripts/check-flux-version-pin.py
    - |
      set -eo pipefail
      # flux CLI alongside the kubectl .kubectl-setup installs: verification
      # queries Flux CRs. Version and sha256 are one pin, so bump both;
      # check-flux-version-pin.py holds it equal to the ConfigMap and gotk.
      FLUX_VERSION="2.9.0"
      # Per-job download dir: a fixed /tmp path collides when two jobs share /tmp.
      dl=$(mktemp -d)
      curl -fsSL "https://github.com/fluxcd/flux2/releases/download/v${FLUX_VERSION}/flux_${FLUX_VERSION}_linux_amd64.tar.gz" -o "$dl/flux.tar.gz"
      echo "7aa9779fc7ec6d030e609dab7dbed8c6fc9e3a7f4670834ad02369268aaf341f  $dl/flux.tar.gz" | sha256sum -c -
      tar xzf "$dl/flux.tar.gz" -C /usr/local/bin flux
      rm -rf "$dl"
      flux --version
    - bash scripts/deploy-verify.sh
  environment:
    name: production/cluster-verify
  # Fires on a kubernetes/ change as well as on any deploy: a GitOps-only commit
  # matches no deploy job's paths, and it is exactly the change Flux applies.
  rules:
    - !reference [.skip-schedule-web, rules]
    - if: '$CI_COMMIT_BRANCH == "main" && ${{ gate_var }}'
      changes:
        - "kubernetes/**/*"
{%- for path in deploy_paths.values() | sum(start=[]) | unique | sort %}
        - "{{ path }}"
{%- endfor %}
