{#- SECRETS SEAM: partials/secrets.jinja is the one home, shared with
    .gitlab-ci.yml.jinja. Here the vault is go-task's {{.OP_VAULT}} so
    `task secrets:show`, which reads the Taskfile tree as text, matches it. -#}
{%- import "partials/secrets.jinja" as secrets with context -%}
{%- set secret_runner = secrets.secret_runner -%}
{%- macro secret_ref(item, field) -%}{{ secrets.secret_ref(item, field, vault='{{.OP_VAULT}}') }}{%- endmacro -%}
# https://taskfile.dev — Ansible owns the hosts and k3s; `flux:*` is bootstrap
# and control, never deployment. Every `env:` entry is a {{ secrets_backend }}
# reference resolved at run time; docs/RUNBOOKS.md lists the items.
version: '3'

# Host roster (PVE_HOSTS, K3S_SERVERS, …) generated from the inventory into
# scripts/hosts.env by `task hosts:sync`, loaded here as env vars AND template
# vars. Editing hosts.yml without re-running that task leaves this stale.
dotenv: ['scripts/hosts.env']

# One file per task namespace; task names are unchanged (`flux:lint` is the task
# `lint:` in taskfiles/flux.yml). The root vars: and dotenv: reach every included
# file, and a task calls another namespace's with a leading colon.
includes:
  ansible: taskfiles/ansible.yml
  authentik: taskfiles/authentik.yml
  flux: taskfiles/flux.yml
  infra: taskfiles/infra.yml
  k3s: taskfiles/k3s.yml
  lint: taskfiles/lint.yml
  maintenance: taskfiles/maintenance.yml
  observability: taskfiles/observability.yml
  proxmox: taskfiles/proxmox.yml
  terraform: taskfiles/terraform.yml

vars:
  ANSIBLE_DIR: ./ansible
  TERRAFORM_DIR: ./terraform
  INVENTORY: ./inventories/prod
  CLUSTER_NAME: {{ cluster_name }}
  ADMIN_USER: {{ admin_user }}
  # Quoted: a vault name may contain spaces, and this value is expanded into
  # shell argv below as well as read as YAML here.
  OP_VAULT: "{{ onepassword_vault }}"
  GIT_HOST: {{ git_host }}
  GIT_NAMESPACE: {{ git_namespace }}
  CLUSTER_DIR: kubernetes/clusters/{{ cluster_name }}
  VERSIONS_CM: kubernetes/infrastructure/sources/versions-configmap.yaml
  # weisssrv-lib checkout at LIB_REF: the source the vendored copies in scripts/,
  # ansible/molecule/ and the root lint profiles are re-copied from
  # (scripts/vendored-manifest.yml). Read by lint:invariants only; no deploy path touches it.
  LIB_DIR: .weisssrv-lib
  LIB_URL: {{ lib_url }}
  LIB_REF: {{ lib_ref }}
  # GitLab-managed Terraform state. The API takes the URL-encoded project PATH
  # wherever it documents a numeric ID; pass `TF_STATE_PROJECT=<id>` if your
  # instance rejects the path form.
  TF_API: https://{{ git_host }}/api/v4
  TF_STATE_PROJECT: {{ git_namespace | replace('/', '%2F') }}%2F{{ cluster_name }}
{% raw -%}
# Anchors aliased by the tasks below. YAML anchors do not cross files, so each
# namespace file carries the precondition list it uses.
x-preconditions:
  op: &op_preconditions
    - sh: command -v ansible-playbook
      msg: "ansible-playbook not installed. pip install ansible, then: task ansible:install-collections"
    - sh: command -v op
      msg: "1Password CLI not installed: https://developer.1password.com/docs/cli/get-started/"
    # `op account list`, not `op whoami`: with the desktop-app integration
    # whoami reports "not signed in" in the non-interactive shell Task uses
    # here.
    - sh: op account list 2>/dev/null
      msg: "1Password CLI not authenticated. Run: eval $(op signin)"
  pyyaml: &pyyaml_precondition
    - sh: python3 -c "import yaml" 2>/dev/null
      msg: "PyYAML not installed (pip install pyyaml)"
  needs_timeout: &needs_timeout
    sh: command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1
    msg: |
      This task needs a wall-clock backstop: neither timeout(1) nor
      gtimeout(1) is on PATH, so every ssh/kubectl probe would run UNBOUNDED.
      macOS: brew install coreutils
  # An empty roster reports every host unreachable instead of naming the stale
  # scripts/hosts.env. collect-state.sh reads PVE_HOSTS, the diagnostics sweep
  # reads PVE_IPS.
  needs_roster: &needs_roster
    sh: '[ -n "$PVE_HOSTS" ] && [ -n "$PVE_IPS" ]'
    msg: "scripts/hosts.env carries no Proxmox roster. Run: task hosts:sync"

tasks:
  default:
    desc: Show available tasks
    cmds:
      - task --list

  kubernetes:lint:
    desc: "Validate all Flux-managed Kubernetes manifests (alias for flux:lint)"
    cmds:
      - task: flux:lint

  # === Library checkout =================================================
  lib:sync:
    desc: "Clone/refresh .weisssrv-lib at LIB_REF — the source for the vendored copies"
    cmds:
      - |
        set -eo pipefail
        if [ -d "{{.LIB_DIR}}/.git" ]; then
          git -C "{{.LIB_DIR}}" fetch --tags --force origin
        else
          git clone --no-checkout "{{.LIB_URL}}" "{{.LIB_DIR}}"
        fi
        # LIB_REF must be a release tag. origin/<ref> is a MOVING branch, and the
        # vendored byte-identity gate then compares against wherever it points.
        if git -C "{{.LIB_DIR}}" rev-parse -q --verify "refs/tags/{{.LIB_REF}}^{commit}" >/dev/null; then
          git -C "{{.LIB_DIR}}" checkout --detach "{{.LIB_REF}}"
        else
          echo "WARNING: {{.LIB_REF}} is not a tag in the library; taking the branch origin/{{.LIB_REF}}" >&2
          git -C "{{.LIB_DIR}}" checkout --detach "origin/{{.LIB_REF}}"
        fi
        git -C "{{.LIB_DIR}}" --no-pager log -1 --oneline

  collect-state:
    desc: Collect a redacted cluster-state snapshot into CLUSTER_STATUS.txt
    # collect-state.sh's SSH_COLLECT_TIMEOUT backstop is inert without a
    # timeout(1); every ssh then runs unbounded and a wedged host hangs the run.
    preconditions: [*needs_timeout, *needs_roster]
    cmds:
      - ./scripts/collect-state.sh {{.CLI_ARGS}}

  diagnose:network:
    desc: "Network-instability diagnostics across all hosts (cluster/HA/ARP/bond/corosync/kube-vip/MetalLB)"
    # shell-lib.sh's timeout_cmd runs the probe unbounded when neither binary is
    # present, so a wedged host hangs the whole sweep.
    preconditions: [*needs_timeout, *needs_roster]
    cmds:
      - bash scripts/diagnose-network-issues.sh {{.CLI_ARGS}}

  # === Service plays ====================================================
  dns:deploy:
    desc: Deploy the DNS stack (recursive resolver + filtering frontends)
    dir: "{{.ANSIBLE_DIR}}"
    env:
      ROOT_EMAIL_ALIAS: {% endraw %}{{ secret_ref('Email Config', 'root_alias') }}{% raw %}
      SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('SSH Key', 'public key') }}{% raw %}
      SMTP_RELAY_USER: {% endraw %}{{ secret_ref('SMTP Relay Auth', 'username') }}{% raw %}
      SMTP_RELAY_PASSWORD: {% endraw %}{{ secret_ref('SMTP Relay Auth', 'password') }}{% raw %}
      ADGUARD_ADMIN_PASSWORD: {% endraw %}{{ secret_ref('AdGuard Home', 'password') }}{% raw %}
      ACME_SSH_PRIVATE_KEY: {% endraw %}{{ secret_ref('Cert Distribution Key', 'private key') }}{% raw %}
      ACME_SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('Cert Distribution Key', 'public key') }}{% raw %}
      LOKI_PUSH_USER: {% endraw %}{{ secret_ref('Loki Push Auth', 'username') }}{% raw %}
      LOKI_PUSH_PASSWORD: {% endraw %}{{ secret_ref('Loki Push Auth', 'password') }}{% raw %}
    preconditions: *op_preconditions
    cmds:
      - {% endraw %}{{ secret_runner() }}{% raw %} ansible-playbook -i {{.INVENTORY}} playbooks/dns.yml {{.CLI_ARGS}}

  mail:deploy:
    desc: Deploy the SMTP relay
    dir: "{{.ANSIBLE_DIR}}"
    env:
      ROOT_EMAIL_ALIAS: {% endraw %}{{ secret_ref('Email Config', 'root_alias') }}{% raw %}
      SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('SSH Key', 'public key') }}{% raw %}
      SMTP_RELAY_USER: {% endraw %}{{ secret_ref('SMTP Relay Auth', 'username') }}{% raw %}
      SMTP_RELAY_PASSWORD: {% endraw %}{{ secret_ref('SMTP Relay Auth', 'password') }}{% raw %}
      SMTP_UPSTREAM_USER: {% endraw %}{{ secret_ref('SMTP Smarthost', 'username') }}{% raw %}
      SMTP_UPSTREAM_PASSWORD: {% endraw %}{{ secret_ref('SMTP Smarthost', 'password') }}{% raw %}
      LOKI_PUSH_USER: {% endraw %}{{ secret_ref('Loki Push Auth', 'username') }}{% raw %}
      LOKI_PUSH_PASSWORD: {% endraw %}{{ secret_ref('Loki Push Auth', 'password') }}{% raw %}
      # base rewrites the relay's authorized_keys, so mail.yml re-seeds the
      # cert-distribution key from the primary resolver afterwards.
      ACME_SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('Cert Distribution Key', 'public key') }}{% raw %}
    preconditions: *op_preconditions
    cmds:
      - {% endraw %}{{ secret_runner() }}{% raw %} ansible-playbook -i {{.INVENTORY}} playbooks/mail.yml {{.CLI_ARGS}}

  storage:deploy:
    desc: Deploy the NAS storage configuration (ZFS properties, NFS, SMB)
    dir: "{{.ANSIBLE_DIR}}"
    # Offsite backup (restic) is opt-in: enable it in the inventory and add
    # B2_KEY_ID / B2_APPLICATION_KEY / RESTIC_REPO_PASSWORD references here.
    env:
      SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('SSH Key', 'public key') }}{% raw %}
      SAMBA_NAS_PASSWORD: {% endraw %}{{ secret_ref('Samba NAS User', 'password') }}{% raw %}
      LOKI_PUSH_USER: {% endraw %}{{ secret_ref('Loki Push Auth', 'username') }}{% raw %}
      LOKI_PUSH_PASSWORD: {% endraw %}{{ secret_ref('Loki Push Auth', 'password') }}{% raw %}
    preconditions: *op_preconditions
    cmds:
      - {% endraw %}{{ secret_runner() }}{% raw %} ansible-playbook -i {{.INVENTORY}} playbooks/storage.yml {{.CLI_ARGS}}

  certs:show-host-keys:
    desc: "Print SSH host keys for the cert distribution targets (paste into group_vars/dns.yml -> _acme_certs_targets)"
    dir: "{{.ANSIBLE_DIR}}"
    cmds:
      - ansible-playbook -i {{.INVENTORY}} playbooks/show-cert-host-keys.yml {{.CLI_ARGS}}

  zfs:encrypt:
    desc: Deploy the ZFS-encryption mechanism and boot units on hosts with encrypted pools
    dir: "{{.ANSIBLE_DIR}}"
    env:
      SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('SSH Key', 'public key') }}{% raw %}
      ZFS_ENCRYPTION_CONNECT_TOKEN: {% endraw %}{{ secret_ref('1Password Connect', 'token') }}{% raw %}
    preconditions: *op_preconditions
    cmds:
      - {% endraw %}{{ secret_runner() }}{% raw %} ansible-playbook -i {{.INVENTORY}} playbooks/zfs-encryption.yml {{.CLI_ARGS}}

  disaster-recovery:storage-bootstrap:
    desc: "INTERACTIVE: create the ZFS datasets group_vars/nas.yml declares (first bring-up and disaster recovery)"
    dir: "{{.ANSIBLE_DIR}}"
    env:
      SSH_PUBLIC_KEY: {% endraw %}{{ secret_ref('SSH Key', 'public key') }}{% raw %}
      SAMBA_NAS_PASSWORD: {% endraw %}{{ secret_ref('Samba NAS User', 'password') }}{% raw %}
    preconditions: *op_preconditions
    cmds:
      - {% endraw %}{{ secret_runner() }}{% raw %} ansible-playbook -i {{.INVENTORY}} playbooks/bootstrap/storage-bootstrap.yml {{.CLI_ARGS}}

  hosts:sync:
    desc: Regenerate scripts/hosts.env from the Ansible inventory
    preconditions: *pyyaml_precondition
    cmds:
      - >-
        python3 scripts/generate-hosts-env.py
        --inventory ansible/inventories/prod/hosts.yml
        --map scripts/hosts-env-map.yml
        --regen-command "task hosts:sync"

  # === Lint =============================================================
  lint:
    # One lint-stage job stays out: deploy-coverage needs a merge base.
    desc: Run every local gate (no credentials required) — mirrors the CI lint stage except deploy-coverage
    cmds:
      - task: lint:yamllint
      - task: lint:shellcheck
      - task: lint:ruff
      - task: lint:doc-links
      - task: lint:taskfile-smoke
      - task: lint:busybox-version-pin
      - task: lint:lib-pins
      - task: lint:ci-policy
      - task: lint:deploy-preflight
      - task: lint:coverage-checks
      - task: lint:version-coverage
      - task: lint:flux-version-pin
      - task: lint:kubectl-version-pin
      - task: lint:repo-sync
      - task: lint:netpol-parity
      - task: lint:kustomization-coverage
      - task: lint:dashboards
      - task: lint:helm-repo-parity
      - task: lint:cluster-literals
      - task: lint:cluster-invariants
      - task: lint:integration-matrix
      - task: lint:role-inputs
{% endraw %}{% if vpn_tailscale %}{% raw %}
      - task: lint:tailscale-policy
{% endraw %}{% endif %}{% raw %}
      - task: lint:tenant-traefik-isolation
      - task: lint:upstream-rule-mirror
      - task: lint:comment-length
      # promtool/amtool gate; its preconditions name the missing tool rather
      # than skipping. CI runs the same checks as prometheus-config-lint.
      - task: lint:prometheus-config
      - task: ansible:lint
      - task: terraform:fmt-check
      - task: terraform:validate
      - task: terraform:tflint
      - task: flux:lint
      # Last: its vendored-byte-identity arm is red by design between a
      # weisssrv-lib change and the lib_ref bump that adopts it, and go-task
      # stops the list at the first failure.
      - task: lint:invariants

  # === Secrets ==========================================================
  op:check:
    desc: Verify the 1Password CLI is authenticated
    cmds:
      - op account get

  secrets:show:
    desc: List the secret REFERENCES this repo uses (never the values)
    cmds:
      - |
        # The Taskfile tree spells the vault as a go-task variable, so its refs are
        # rewritten to the resolved name; .gitlab-ci.yml already carries it. An
        # empty section is printed, not swallowed: find(1) exits 0 either way.
        show() {
          label="$1"; shift
          echo "$label"
          refs=$("$@" | sed 's/[[:space:]]*$//' | grep -E "^op://[^/]+/[^/]+/[^/]+$" | sort -u || true)
          if [ -n "$refs" ]; then
            printf '%s\n' "$refs" | sed 's/^/  - /'
          else
            echo "  (none found)"
          fi
        }
        scan_tree() {
          find "$@" -name '*.yml' -type f -exec grep -hoE "op://[^\"'\`)(]+" {} \; 2>/dev/null
        }
        scan_taskfiles() {
          scan_tree Taskfile.yml taskfiles | sed 's|^op://[^/]*/|op://{{.OP_VAULT}}/|'
        }
        show "op:// references in the Taskfile tree:" scan_taskfiles
        echo ""
        show "op:// references in .gitlab-ci.yml:" scan_tree .gitlab-ci.yml
        echo ""
        echo "Composed inside include:d library CI fragments (the greps above cannot see these):"
        # Split at the field so this echo is not itself a grep hit.
        echo "  - {% endraw %}{{ secret_ref('K3s Kubeconfig', '') }}{% raw %}""kubeconfig"
        echo "  docs/ci-pipeline.md lists every vault item and its consumer."
        echo ""
        echo "Verify they exist:  op item list --vault '{{.OP_VAULT}}'"

  # === App operations ===================================================
  # Shared templates the per-app namespaces call with vars instead of carrying a
  # copy of the kubectl invocation.
  _app:status:
    internal: true
    # SECTIONS is one `Header|resource` pair per line; `pods` is listed -o wide.
    cmds:
      - |
        printf '%s\n' '{{.SECTIONS}}' | {
          first=1
          while IFS='|' read -r label resource; do
            [ -n "$label" ] || continue
            [ "$first" = "1" ] || echo ""
            first=0
            echo "=== $label ==="
            if [ "$resource" = "pods" ]; then
              kubectl get pods -n {{.NS}} -o wide
            else
              kubectl get "$resource" -n {{.NS}}
            fi
          done
        }

  _app:restart:
    internal: true
    vars:
      TIMEOUT: '{{.TIMEOUT | default "300s"}}'
      WAIT_SELECTOR: '{{.WAIT_SELECTOR | default .SELECTOR}}'
    cmds:
      # Pod delete, not `kubectl rollout restart`: docs/RUNBOOKS.md § Restarting a Flux-managed workload.
      - |
        {{if .BANNER}}echo "{{.BANNER}}"{{end}}
        kubectl delete pod -n {{.NS}} {{.SELECTOR}}
        {{if .BANNER}}echo "Waiting for pods to be ready..."{{end}}
        kubectl wait --namespace {{.NS}} --for=condition=ready pod {{.WAIT_SELECTOR}} --timeout={{.TIMEOUT}}

  _app:logs:
    internal: true
    vars:
      TAIL: '{{.TAIL | default "100"}}'
    cmds:
      - kubectl logs -n {{.NS}} {{.TARGET}} {{if .CONTAINER}}-c "{{.CONTAINER}}" {{end}}--tail={{.TAIL}} -f
{%- endraw %}
