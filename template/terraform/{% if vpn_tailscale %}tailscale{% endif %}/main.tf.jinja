# The tailnet policy resource and its guardrails come from the library at a
# pinned ref; the policy document and the Split-DNS map are this site's data.
#
# `file()` is called HERE, in the root module: `path.module` inside the module
# would resolve to the module's own directory.
module "tailnet" {
  source = "git::{{ lib_url }}//terraform/modules/tailscale-acl?ref={{ lib_ref }}"

  acl_policy = file("${path.module}/policy.hujson")
  split_dns  = local.split_dns
}
