// Tailnet policy (HuJSON: comments and trailing commas allowed). Every rule
// sources from `group:admins` and names explicit ports. Applying REPLACES the
// live document and can sever access to every node — README.md.
{
  // The operators of this cluster. admin_email is often not your Tailscale
  // login: confirm it against the admin console before the first apply.
  "groups": {
    "group:admins": ["{{ admin_email }}"],
  },

  // Each tag is advertised elsewhere in this repo (group_vars/proxmox.yml,
  // controllers/tailscale-operator). tag:k8s must be ownable by tag:k8s-operator
  // or registration fails, and its EMPTY owner list means "tailnet admins".
  "tagOwners": {
    "tag:subnet-router": ["autogroup:admin"],
    "tag:k8s-operator":  [],
    "tag:k8s":           ["tag:k8s-operator"],
  },

  // Ports are proto-agnostic (no "proto" field), so each matches BOTH tcp and
  // udp — which is what DNS (53, 853) needs. ICMP is allowed automatically for
  // any matched src/dst pair.
  "acls": [
    // Rule 1 — the subnet-router HOSTS' own services on their tailnet (100.x)
    // address: SSH and the Proxmox web UI. 80/443 are defensive; the kube-API
    // is reached through Rule 2.
    {
      "action": "accept",
      "src":    ["group:admins"],
      "dst":    ["tag:subnet-router:22,80,443,8006"],
    },

    // Rule 2 — the LAN, via subnet routing: the admin surface, and the rule you
    // extend. Add a port ONLY for something reached directly rather than
    // through Traefik; node-to-node ports stay with the host firewall's IP sets.
    {
      "action": "accept",
      "src":    ["group:admins"],
      "dst":    ["{{ lan_cidr }}:22,53,80,111,443,853,2049,3000,6443,8006"],
    },

    // Rule 3 — SSH between an operator's own UNTAGGED devices, and to hosts
    // before they adopt tag:subnet-router. The network half of the `ssh` rule
    // below; a tagged host is covered by Rule 1 instead.
    {
      "action": "accept",
      "src":    ["group:admins"],
      "dst":    ["autogroup:self:22"],
    },

    // Rule 4 — the proxy DEVICES the Tailscale Kubernetes operator registers:
    //   :443  the Traefik tailnet Service; :53 the split-horizon resolver.
    {
      "action": "accept",
      "src":    ["group:admins"],
      "dst":    ["tag:k8s:53,443"],
    },
  ],

  // Auto-approval makes subnet-router failover real. Drop `group:admins` once
  // every host is tagged (README.md § Staged rollout).
  "autoApprovers": {
    "routes": {
      "{{ lan_cidr }}": ["tag:subnet-router", "group:admins"],
    },
    // Tagged hosts only, so an operator's laptop cannot become an exit node by
    // accident.
    "exitNode": ["tag:subnet-router"],
  },

  // "check" reauthenticates periodically; root is refused, so the operator
  // connects as {{ admin_user }}. Pre-apply check: README.md.
  "ssh": [
    {
      "action": "check",
      "src":    ["group:admins"],
      "dst":    ["autogroup:self", "tag:subnet-router"],
      "users":  ["autogroup:nonroot"],
    },
  ],
}
