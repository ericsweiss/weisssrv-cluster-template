{%- set _lan_first = lan_address_range[0] %}
{%- set _lan_last = lan_address_range[1] %}
{#- The module takes `subnet` in GATEWAY form, so the default network's gateway
    cannot be lan_cidr's own network address. #}
{%- set _gw = lan_gateway.split('.') | map('int') | list %}
{%- if _gw[0] * 16777216 + _gw[1] * 65536 + _gw[2] * 256 + _gw[3] == _lan_first %}
{{ {}['unimplemented'] | mandatory('lan_gateway ' ~ lan_gateway ~ ' is the network address of ' ~ lan_cidr ~ ', so networks["default"].subnet would not be in the GATEWAY form the unifi-network module requires — answer lan_gateway with a host address such as ' ~ lan_prefix ~ '.1') }}
{%- endif %}
{#- Every DHCP scope below hands out local.dns_ips, and a controller scope takes
    at most four resolvers. #}
{%- if upstream_dns_servers.split() | length > 4 %}
{{ {}['unimplemented'] | mandatory('upstream_dns_servers lists ' ~ (upstream_dns_servers.split() | length) ~ ' resolvers and a UniFi DHCP scope takes at most 4, which the unifi-network module rejects at plan time — shorten the answer or write the dhcp blocks in networks.tf by hand') }}
{%- endif %}
{#- The DHCP floor sits above everything the address scheme already claims: the
    reserved bands hosts.yml composes from lan_prefix, and the three VIPs. #}
{%- set _po = lan_prefix.split('.') | map('int') | list %}
{%- set _claimed = [(_po[0] * 16777216 + _po[1] * 65536 + _po[2] * 256) + (reserved_address_bands | map(attribute=1) | max)] %}
{%- for _vip in [k3s_api_vip, metallb_public_vip, metallb_internal_vip] %}
{%- set _a = _vip.split('.') | map('int') | list %}
{%- set _ = _claimed.append(_a[0] * 16777216 + _a[1] * 65536 + _a[2] * 256 + _a[3]) %}
{%- endfor %}
{%- set _dhcp_stop_n = _lan_last - 1 %}
{%- set _dhcp_start_n = [_lan_first + 1, (_claimed | max) + 1, _lan_last - 85] | max %}
{%- if _dhcp_start_n > _dhcp_stop_n %}
{{ {}['unimplemented'] | mandatory('lan_cidr ' ~ lan_cidr ~ ' leaves no DHCP pool above the reserved address bands and the VIPs — widen the LAN or write the dhcp block in networks.tf by hand') }}
{%- endif %}
{%- macro dotted(n) %}{{ (n // 16777216) % 256 }}.{{ (n // 65536) % 256 }}.{{ (n // 256) % 256 }}.{{ n % 256 }}{% endmacro %}
{%- set dhcp_start = dotted(_dhcp_start_n) | trim %}
{%- set dhcp_stop = dotted(_dhcp_stop_n) | trim %}
{#- Example VLAN /24s: 10.0.30 and 10.0.40 when free, else the next free pair.
    Free means claimed by none of lan_cidr, k3s_pod_cidr, k3s_service_cidr. #}
{%- set _claims = [] %}
{%- for _c in [lan_cidr, k3s_pod_cidr, k3s_service_cidr] %}
{%- set _co = _c.split('/')[0].split('.') | map('int') | list %}
{%- set _cb = _co[0] * 16777216 + _co[1] * 65536 + _co[2] * 256 + _co[3] %}
{%- set _cs = 2 ** (32 - (_c.split('/')[1] | int)) %}
{%- set _ = _claims.append([_cb - (_cb % _cs), _cb - (_cb % _cs) + _cs - 1]) %}
{%- endfor %}
{%- set _free = [] %}
{%- for _n in range(2, 255) %}
{%- set _cand = 167772160 + _n * 256 %}
{%- if not (_claims | selectattr(0, 'le', _cand + 255) | selectattr(1, 'ge', _cand) | list) %}
{%- set _ = _free.append(_n) %}
{%- endif %}
{%- endfor %}
{%- if _free | length < 2 %}
{{ {}['unimplemented'] | mandatory('lan_cidr ' ~ lan_cidr ~ ', k3s_pod_cidr ' ~ k3s_pod_cidr ~ ' and k3s_service_cidr ' ~ k3s_service_cidr ~ ' leave no free pair of 10.0.x.0/24 ranges for the example VLANs — write the iot and guest networks in networks.tf by hand') }}
{%- endif %}
{%- set _iot_vlan = 30 if 30 in _free else _free[0] %}
{%- set _guest_free = _free | reject('equalto', _iot_vlan) | list %}
{%- set _guest_vlan = 40 if 40 in _guest_free else _guest_free[0] %}
{%- set _iot_prefix = '10.0.' ~ _iot_vlan %}
{%- set _guest_prefix = '10.0.' ~ _guest_vlan %}
# CRITICAL: every map key is a STATE ADDRESS. Renaming one plans a destroy that
# the module's `prevent_destroy` refuses: rename with a `moved {}` block, stop
# managing an object with `terraform state rm` (README § Renaming and removing).
# EDIT ME BEFORE THE FIRST APPLY. The `default` network, the DNS servers and the
# port forwards come from your answers, and the example VLAN /24s dodge your
# LAN, pod and service ranges. The VLANs, zones, policies and SSIDs below are a
# WORKED EXAMPLE: README § Before the first apply is the import list of
# controller objects these entries must adopt rather than duplicate.
locals {
  # The resolvers this cluster builds, handed out by every DHCP scope. Changing
  # a resolver's address is one edit here plus the `upstream_dns_servers`
  # answer, and the policies below reference this list rather than repeating it.
  dns_ips = [{% for server in upstream_dns_servers.split() %}"{{ server }}"{% if not loop.last %}, {% endif %}{% endfor %}]

  networks = {
    # The controller's built-in network, this cluster's flat LAN: no VLAN id,
    # and `name = "Default"` is what `terraform import` matches on. `subnet` is
    # GATEWAY form, so the host part is the gateway, not the network address.
    default = {
      name        = "Default"
      subnet      = "{{ lan_gateway }}/{{ lan_cidr.split('/')[1] }}"
      domain_name = "{{ internal_domain }}"
      # The top of the LAN, derived from lan_cidr: the floor clears the
      # reserved bands and the three VIPs, the stop is the last usable address.
      # A static guest you add later still has to sit below the floor.
      dhcp = { start = "{{ dhcp_start }}", stop = "{{ dhcp_stop }}", dns_servers = local.dns_ips }
    }

    # EXAMPLE. Pick ranges that overlap neither {{ lan_cidr }} nor the k3s pod
    # and service ranges ({{ k3s_pod_cidr }}, {{ k3s_service_cidr }}), and give
    # each one a VLAN id your switch fabric actually tags.
    iot = {
      name        = "IoT"
      vlan        = {{ _iot_vlan }}
      subnet      = "{{ _iot_prefix }}.1/24"
      domain_name = "{{ internal_domain }}"
      # Multicast (casting, discovery) stays on the ports that asked for it
      # rather than flooding the segment.
      igmp_snooping = true
      dhcp          = { start = "{{ _iot_prefix }}.50", stop = "{{ _iot_prefix }}.249", dns_servers = local.dns_ips }
    }

    guest = {
      name = "Guest"
      vlan = {{ _guest_vlan }}
      # `purpose` stays the default `corporate`: the `guest` purpose sticks only
      # in the built-in Hotspot zone and rewrites itself in a custom one,
      # failing the apply. Isolation is the zone plus `l2_isolation`.

      # No `domain_name`, so a short name here resolves to no internal host.
      subnet = "{{ _guest_prefix }}.1/24"
      dhcp   = { start = "{{ _guest_prefix }}.50", stop = "{{ _guest_prefix }}.249", dns_servers = local.dns_ips }
    }
  }

  # One zone per VLAN; the LAN stays in the built-in `Internal` zone and the key
  # is the zone's display name in the UI. Zone to zone is default-deny, but zone
  # to `Gateway` and `External` is not, so each VLAN needs the BLOCKs below too.
  zones = {
    iot   = { networks = ["iot"] }
    guest = { networks = ["guest"] }
  }

  # `zone` names a `zones` key or one of the built-in short names (`internal`,
  # `external`, `gateway`) — one namespace, resolved together. `name` is the
  # state address, so it is unique and a rename replaces the policy.
  policies = [
    {
      # Without this an IoT device gets a DHCP lease naming resolvers it cannot
      # reach, and every name lookup on the segment times out.
      name        = "iot-to-dns"
      protocol    = "tcp_udp"
      source      = { zone = "iot" }
      destination = { zone = "internal", ips = local.dns_ips, port = "53" }
    },
    {
      name        = "guest-to-dns"
      protocol    = "tcp_udp"
      source      = { zone = "guest" }
      destination = { zone = "internal", ips = local.dns_ips, port = "53" }
    },
    {
      # Administration and casting from the LAN into the IoT segment. The
      # reverse stays closed: an IoT device reaches the LAN for DNS and nothing
      # else, which is the whole point of putting it on its own VLAN.
      name        = "lan-to-iot"
      source      = { zone = "internal" }
      destination = { zone = "iot" }
    },

    # ---- Gateway hardening ----

    # Every zone reaches the Gateway zone by default, and on a Cloud Gateway the
    # console is a gateway service on EVERY VLAN's own address. tcp and the
    # console ports only - README.md, What ships and what you must change.
    {
      name        = "guest-to-gateway-mgmt"
      action      = "BLOCK"
      protocol    = "tcp"
      logging     = true
      source      = { zone = "guest" }
      destination = { zone = "gateway", port = "22,80,443" }
    },
    {
      name        = "iot-to-gateway-mgmt"
      action      = "BLOCK"
      protocol    = "tcp"
      logging     = true
      source      = { zone = "iot" }
      destination = { zone = "gateway", port = "22,80,443" }
    },

    # The gateway answers DNS on each VLAN's own address too, so close that
    # path: these zones are handed `local.dns_ips` and need nothing else.
    {
      name        = "guest-to-gateway-dns"
      action      = "BLOCK"
      protocol    = "tcp_udp"
      logging     = true
      source      = { zone = "guest" }
      destination = { zone = "gateway", port = "53,853" }
    },
    {
      name        = "iot-to-gateway-dns"
      action      = "BLOCK"
      protocol    = "tcp_udp"
      logging     = true
      source      = { zone = "iot" }
      destination = { zone = "gateway", port = "53,853" }
    },

    # ---- DNS containment ----

    # DHCP option 6 is advisory, so blocking :53 and :853 to External forces
    # `local.dns_ips` or nothing. DoH on :443 is NOT covered, and the LAN is
    # exempt - README.md, What ships and what you must change.
    {
      name        = "guest-to-external-dns"
      action      = "BLOCK"
      protocol    = "tcp_udp"
      logging     = true
      source      = { zone = "guest" }
      destination = { zone = "external", port = "53,853" }
    },
    {
      name        = "iot-to-external-dns"
      action      = "BLOCK"
      protocol    = "tcp_udp"
      logging     = true
      source      = { zone = "iot" }
      destination = { zone = "external", port = "53,853" }
    },
  ]

  # CRITICAL: every SSID is WPA-PSK on 2.4 + 5 GHz — 6 GHz fails WLAN creation on
  # this provider (upstream #406), so enable that band in the UI if you need it.
  # `cluster_name` is truncated to keep the SSID inside the 32-BYTE 802.11 limit;
  # over it, the apply fails after the networks and zones are written.
  # Rename these freely - nothing keys off them.
  wlans = {
    iot = {
      ssid       = "{{ cluster_name[:26] }}-iot"
      network    = "iot"
      passphrase = var.wlan_passphrase_iot
      # ESP32/Kasa-class gear: plain WPA2 with PMF disabled, and no steering of
      # capable clients off 2.4 GHz. Transition mode is what those radios fail
      # to associate against.
      wpa3                 = false
      allow_2ghz_high_perf = true
    }
    guest = {
      ssid       = "{{ cluster_name[:26] }}-guest"
      network    = "guest"
      passphrase = var.wlan_passphrase_guest
      # Guests reach the gateway and the internet, never each other.
      l2_isolation = true
    }
  }

  # Fixed-IP reservations, empty because a MAC cannot come from an answer. Add
  # `{ mac = "aa:bb:cc:dd:ee:ff", name = "...", fixed_ip = "{{ _iot_prefix }}.10", network = "iot" }`
  # entries; changing one is `-replace=`, never in-place (upstream #428).
  clients = {}

  # Both ingress ports: Traefik routes by SNI and Host header on 443 and
  # permanently redirects 80 to it. Source restriction belongs in the policies
  # above and in each host's own firewall, not here.
  port_forwards = {
    http  = { wan_port = "80", ip = "{{ metallb_public_vip }}", port = "80" }
    https = { wan_port = "443", ip = "{{ metallb_public_vip }}", port = "443" }
  }

  # Pinned here, not inherited from the module defaults: a library default flip
  # must not re-enable UPnP or unattended firmware on a `lib_ref` bump. The module
  # ignore_changes the whole `ips` block, so `ips_mode` is create-time intent only.
  site_settings = {
    auto_upgrade         = false
    network_optimization = false
    upnp                 = false

    igmp_snooping_networks = ["iot"]
    # Detection only until the site has a traffic baseline; see README.md.
    ips_mode = "ids"
  }
}
