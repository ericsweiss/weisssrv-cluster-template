variable "authentik_url" {
  description = "Base URL of the authentik API (the internal split-horizon name)"
  type        = string
  default     = "https://auth.{{ internal_domain }}"

  validation {
    condition     = can(regex("^https://[a-z0-9.-]+$", var.authentik_url))
    error_message = "authentik_url must be a bare https:// origin with no path or trailing slash."
  }
}

variable "authentik_token" {
  description = "authentik API token (1Password item 'Authentik Terraform Token', field 'credential')"
  type        = string
  sensitive   = true
}

# One per OIDC application that keeps its own copy of the client secret, read
# from that application's secret-store item. No default: a missing TF_VAR_ fails
# the plan, not a state-only secret. README § Adding an application, step 2.
variable "oauth2_client_secret_grafana" {
  description = "Grafana OIDC client secret (1Password item 'Grafana SSO', field 'oidc-client-secret')"
  type        = string
  sensitive   = true
}
