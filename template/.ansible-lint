---
# ansible-lint configuration. https://ansible.readthedocs.io/projects/lint/configuring/

# Must stay at the repo root: ansible-lint discovers this file by walking UP
# from its working directory, so both callers find it - the CI job (cwd = repo
# root) and `task ansible:lint` (cwd = `ansible/`).

# The profile also selects WHICH rules run: without one, opt-in rules such as
# run-once[task] fire on every deliberate `run_once:`.
profile: production

exclude_paths:
  - .cache/
  - .venv/
  - venv/
  # `task lib:sync` checkout - the library lints itself upstream.
  - .weisssrv-lib/
  # ansible-galaxy install targets for weisssrv.infra - same reason.
  - .ansible-home/
  - ansible_collections/
  - ansible/ansible_collections/

# No skip_list: var-naming[no-role-prefix] fires only from inside a role, and
# this repository owns none. Add the skip if an `ansible/roles/` tree appears.

# Resolve collection dependencies, so the FQCN checks can see them.
offline: false
