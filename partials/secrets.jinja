{#- SECRETS SEAM: the one home for the backend-aware macros .gitlab-ci.yml.jinja
    and Taskfile.yml.jinja emit every secret reference from. An unimplemented
    backend fails the RENDER here. Model: docs/ARCHITECTURE.md Backend seams. -#}
{%- macro secret_ref(item, field, vault=None) -%}
{%- if secrets_backend == 'onepassword' -%}
op://{{ vault or onepassword_vault }}/{{ item }}/{{ field }}
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no reference syntax — add a branch to secret_ref() in partials/secrets.jinja') }}
{%- endif -%}
{%- endmacro -%}
{%- macro secret_read(item, field) -%}
{%- if secrets_backend == 'onepassword' -%}
op read "{{ secret_ref(item, field) }}"
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no fetch command — add a branch to secret_read() in partials/secrets.jinja') }}
{%- endif -%}
{%- endmacro -%}
{%- macro secret_runner() -%}
{%- if secrets_backend == 'onepassword' -%}
op run --
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no host-side runner — add a branch to secret_runner() in partials/secrets.jinja') }}
{%- endif -%}
{%- endmacro -%}
{%- macro secret_vault() -%}
{%- if secrets_backend == 'onepassword' -%}
{{ onepassword_vault }}
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no vault name — add a branch to secret_vault() in partials/secrets.jinja') }}
{%- endif -%}
{%- endmacro -%}
{%- macro secret_gate_var() -%}
{%- if secrets_backend == 'onepassword' -%}
OP_SERVICE_ACCOUNT_TOKEN
{%- else -%}
{{ {}['unimplemented'] | mandatory('secrets_backend ' ~ secrets_backend ~ ' has no CI gate variable — add a branch to secret_gate_var() in partials/secrets.jinja') }}
{%- endif -%}
{%- endmacro -%}
